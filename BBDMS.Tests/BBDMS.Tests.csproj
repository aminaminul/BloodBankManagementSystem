  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BBDMS.Service\BBDMS.Service.csproj" />
    <ProjectReference Include="..\BBDMS.Repository\BBDMS.Repository.csproj" />
    <ProjectReference Include="..\BBDMS.Model\BBDMS.Model.csproj" />
    <ProjectReference Include="..\BBDMS.Web\BBDMS.Web.csproj" />
  </ItemGroup>

</Project>