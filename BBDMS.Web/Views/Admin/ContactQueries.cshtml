@model IEnumerable<BBDMS.Model.Models.Entities.ContactQuery>
@{
    ViewData["Title"] = "User Contact Messages";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h3 class="fw-bold text-dark mb-0">User Inquiries &amp; Messages</h3>
        <p class="text-muted mb-0">Messages submitted through the public Contact Us form</p>
    </div>
    <div>
        <input type="text" id="queriesTableSearch" class="form-control form-control-modern" placeholder="Search inquiries..." style="width: 250px;" />
    </div>
</div>

<div class="card-modern p-0">
    <div class="table-responsive">
        <table class="table table-hover mb-0" id="queriesTable">
            <thead style="background:#f8fafc;">
                <tr style="font-size:.78rem; text-transform:uppercase; color:#64748b; letter-spacing:.05em;">
                    <th class="ps-4">Sender Name</th>
                    <th>Contact Number</th>
                    <th>Email</th>
                    <th>Message</th>
                    <th>Date Received</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var query in Model)
                    {
                        <tr style="vertical-align:middle;">
                            <td class="ps-4"><strong class="text-dark">@query.Name</strong></td>
                            <td>
                                <a href="tel:@query.ContactNumber" class="text-dark fw-semibold small">
                                    <i class="fas fa-phone me-1 text-success"></i>@query.ContactNumber
                                </a>
                            </td>
                            <td><a href="mailto:@query.EmailId" class="text-primary small">@query.EmailId</a></td>
                            <td style="max-width: 320px;">
                                <div class="text-muted small">@query.Message</div>
                            </td>
                            <td class="small text-muted">@query.PostingDate.ToString("MMM dd, yyyy - hh:mm tt")</td>
                            <td class="text-end pe-4">
                                <form asp-action="DeleteContactQuery" asp-route-id="@query.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this query?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="fas fa-envelope-open-text fa-2x mb-2 d-block text-secondary"></i>No contact messages received yet.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('queriesTableSearch')?.addEventListener('keyup', function() {
            var filter = this.value.toLowerCase();
            document.querySelectorAll('#queriesTable tbody tr').forEach(function(row) {
                row.style.display = row.textContent.toLowerCase().includes(filter) ? '' : 'none';
            });
        });
    </script>
}
