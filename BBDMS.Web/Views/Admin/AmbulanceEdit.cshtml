@model BBDMS.Model.Models.Entities.AmbulanceService
@{
    ViewData["Title"] = "Edit Ambulance";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card content-card shadow-sm">
            <div class="card-header bg-white py-3">
                <h4 class="mb-0 font-weight-bold text-dark"><i class="fas fa-edit mr-2 text-warning"></i>Edit Ambulance: @Model.ProviderName</h4>
            </div>
            <div class="card-body p-4">
                <form method="post" asp-action="AmbulanceEdit">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />

                    <div class="form-row">
                        <div class="form-group col-md-8">
                            <label asp-for="ProviderName" class="font-weight-bold">Provider / Organization Name <span class="text-danger">*</span></label>
                            <input asp-for="ProviderName" class="form-control" required />
                            <span asp-validation-for="ProviderName" class="text-danger small"></span>
                        </div>
                        <div class="form-group col-md-4">
                            <label asp-for="Location" class="font-weight-bold">Service Location / City <span class="text-danger">*</span></label>
                            <input asp-for="Location" class="form-control" required />
                            <span asp-validation-for="Location" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label asp-for="AmbulanceType" class="font-weight-bold">Ambulance Classification <span class="text-danger">*</span></label>
                            <select asp-for="AmbulanceType" class="form-control" required>
                                <option value="Advanced Life Support (ALS) / ICU">Advanced Life Support (ALS) / ICU</option>
                                <option value="Basic Life Support (BLS)">Basic Life Support (BLS)</option>
                                <option value="AC Ambulance">AC Ambulance</option>
                                <option value="Non-AC Ambulance">Non-AC Ambulance</option>
                                <option value="Neonatal ICU Ambulance">Neonatal ICU Ambulance</option>
                            </select>
                        </div>
                        <div class="form-group col-md-6">
                            <label asp-for="VehicleNumber" class="font-weight-bold">Vehicle Registration Number</label>
                            <input asp-for="VehicleNumber" class="form-control" />
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label asp-for="ContactNumber" class="font-weight-bold">24/7 Hotline Number <span class="text-danger">*</span></label>
                            <input asp-for="ContactNumber" class="form-control" required />
                            <span asp-validation-for="ContactNumber" class="text-danger small"></span>
                        </div>
                        <div class="form-group col-md-6">
                            <label asp-for="ServiceHours" class="font-weight-bold">Service Hours</label>
                            <input asp-for="ServiceHours" class="form-control" />
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="custom-control custom-checkbox">
                            <input type="checkbox" class="custom-control-input" id="isAvailable" asp-for="IsAvailable" />
                            <label class="custom-control-label font-weight-bold" for="isAvailable">Vehicle is Currently Available for Dispatch</label>
                        </div>
                    </div>

                    <div class="text-right mt-4">
                        <a asp-action="Ambulances" class="btn btn-secondary mr-2">Cancel</a>
                        <button type="submit" class="btn btn-primary font-weight-bold px-4">Update Ambulance</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
