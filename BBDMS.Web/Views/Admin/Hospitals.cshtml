@model IEnumerable<BBDMS.Model.Models.Entities.Hospital>
@{
    ViewData["Title"] = "Manage Hospitals & ICU Facilities";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h3 class="fw-bold text-dark mb-0">Hospitals &amp; Emergency Facilities</h3>
        <p class="text-muted mb-0">Manage hospital details, emergency beds, and ICU capacity</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <input type="text" id="hospitalsTableSearch" class="form-control form-control-modern" placeholder="Search hospitals..." style="width: 220px;" />
        <a asp-action="ExportHospitalsCsv" class="btn btn-brand-outline text-nowrap">
            <i class="fas fa-file-csv me-1"></i>Export CSV
        </a>
        <a asp-action="HospitalCreate" class="btn btn-brand-red text-nowrap">
            <i class="fas fa-plus me-1"></i>Add Hospital
        </a>
    </div>
</div>

<div class="card-modern p-0">
    <div class="table-responsive">
        <table class="table table-hover mb-0" id="hospitalsTable">
            <thead style="background:#f8fafc;">
                <tr style="font-size:.78rem; text-transform:uppercase; color:#64748b; letter-spacing:.05em;">
                    <th class="ps-4">Hospital Name</th>
                    <th>City / Location</th>
                    <th>Emergency Beds (Avail/Total)</th>
                    <th>ICU Beds (Avail/Total)</th>
                    <th>Helpline</th>
                    <th>Last Updated</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr style="vertical-align:middle;">
                            <td class="ps-4">
                                <div class="fw-semibold text-dark">@item.Name</div>
                                <div class="small text-muted">@item.Address</div>
                            </td>
                            <td><span class="badge-soft-primary">@item.City</span></td>
                            <td>
                                <span class="fw-bold @(item.AvailableEmergencyBeds > 0 ? "text-success" : "text-danger")">
                                    @item.AvailableEmergencyBeds
                                </span> / @item.TotalEmergencyBeds
                            </td>
                            <td>
                                <span class="fw-bold @(item.AvailableIcuBeds > 0 ? "text-success" : "text-danger")">
                                    @item.AvailableIcuBeds
                                </span> / @item.TotalIcuBeds
                            </td>
                            <td>
                                <a href="tel:@item.EmergencyHelpline" class="text-dark fw-semibold small">
                                    <i class="fas fa-phone me-1 text-success"></i>@item.EmergencyHelpline
                                </a>
                            </td>
                            <td class="small text-muted">@item.LastUpdated.ToString("MMM dd, yyyy")</td>
                            <td class="text-end pe-4">
                                <a asp-action="HospitalEdit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-1" title="Edit">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <form asp-action="HospitalDelete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this hospital?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="fas fa-hospital fa-2x mb-2 d-block text-primary"></i>No hospitals registered yet.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('hospitalsTableSearch')?.addEventListener('keyup', function() {
            var filter = this.value.toLowerCase();
            document.querySelectorAll('#hospitalsTable tbody tr').forEach(function(row) {
                row.style.display = row.textContent.toLowerCase().includes(filter) ? '' : 'none';
            });
        });
    </script>
}
