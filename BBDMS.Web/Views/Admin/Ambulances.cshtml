@model IEnumerable<BBDMS.Model.Models.Entities.AmbulanceService>
@{
    ViewData["Title"] = "Manage Ambulance Fleets";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="font-weight-bold text-dark mb-0">Emergency Ambulance Fleets</h3>
        <p class="text-muted mb-0">Manage ambulance service providers, vehicle types, and 24/7 availability</p>
    </div>
    <div>
        <a asp-action="AmbulanceRequests" class="btn btn-warning text-dark font-weight-bold mr-2">
            <i class="fas fa-bell mr-1"></i>View Dispatch Requests
        </a>
        <a asp-action="AmbulanceCreate" class="btn btn-primary font-weight-bold">
            <i class="fas fa-plus mr-1"></i>Add Ambulance
        </a>
    </div>
</div>

<div class="card content-card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="thead-light">
                    <tr>
                        <th>Provider Name</th>
                        <th>Location</th>
                        <th>Ambulance Type</th>
                        <th>Vehicle Reg #</th>
                        <th>Contact Number</th>
                        <th>Status</th>
                        <th class="text-right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td><strong>@item.ProviderName</strong></td>
                                <td><span class="badge badge-light border">@item.Location</span></td>
                                <td><span class="badge badge-info">@item.AmbulanceType</span></td>
                                <td><code>@item.VehicleNumber</code></td>
                                <td><i class="fas fa-phone mr-1 text-success"></i>@item.ContactNumber</td>
                                <td>
                                    @if (item.IsAvailable)
                                    {
                                        <span class="badge badge-success px-2 py-1">Available 24/7</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-secondary px-2 py-1">On Duty</span>
                                    }
                                </td>
                                <td class="text-right">
                                    <a asp-action="AmbulanceEdit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary mr-1">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <a asp-action="AmbulanceDelete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" onclick="return confirm('Are you sure you want to remove this ambulance?');">
                                        <i class="fas fa-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">No ambulance fleets added yet.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
