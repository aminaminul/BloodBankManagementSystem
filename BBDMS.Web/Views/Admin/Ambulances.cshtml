@model IEnumerable<BBDMS.Model.Models.Entities.AmbulanceService>
@{
    ViewData["Title"] = "Manage Ambulance Fleets";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h3 class="fw-bold text-dark mb-0">Emergency Ambulance Fleets</h3>
        <p class="text-muted mb-0">Manage ambulance service providers, vehicle types, and 24/7 availability</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <input type="text" id="ambulancesTableSearch" class="form-control form-control-modern" placeholder="Search ambulances..." style="width: 240px;" />
        <a asp-action="AmbulanceRequests" class="btn btn-brand-outline text-nowrap">
            <i class="fas fa-bell me-1"></i>View Requests
        </a>
        <a asp-action="AmbulanceCreate" class="btn btn-brand-red text-nowrap">
            <i class="fas fa-plus me-1"></i>Add Ambulance
        </a>
    </div>
</div>

<div class="card-modern p-0">
    <div class="table-responsive">
        <table class="table table-hover mb-0" id="ambulancesTable">
            <thead style="background:#f8fafc;">
                <tr style="font-size:.78rem; text-transform:uppercase; color:#64748b; letter-spacing:.05em;">
                    <th class="ps-4">Provider Name</th>
                    <th>Location</th>
                    <th>Ambulance Type</th>
                    <th>Vehicle Reg #</th>
                    <th>Contact Number</th>
                    <th>Status</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr style="vertical-align:middle;">
                            <td class="ps-4"><strong class="text-dark">@item.ProviderName</strong></td>
                            <td><span class="badge-soft-primary">@item.Location</span></td>
                            <td><span class="badge-soft-warning">@item.AmbulanceType</span></td>
                            <td><code class="px-2 py-1 rounded" style="background:#f1f5f9; color:#475569;">@item.VehicleNumber</code></td>
                            <td>
                                <a href="tel:@item.ContactNumber" class="text-dark fw-semibold small">
                                    <i class="fas fa-phone me-1 text-success"></i>@item.ContactNumber
                                </a>
                            </td>
                            <td>
                                @if (item.IsAvailable)
                                {
                                    <span class="badge-soft-success">Available 24/7</span>
                                }
                                else
                                {
                                    <span class="badge-soft-secondary">On Duty</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <a asp-action="AmbulanceEdit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-1" title="Edit">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <form asp-action="AmbulanceDelete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to remove this ambulance?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="fas fa-ambulance fa-2x mb-2 d-block text-warning"></i>No ambulance fleets added yet.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('ambulancesTableSearch')?.addEventListener('keyup', function() {
            var filter = this.value.toLowerCase();
            document.querySelectorAll('#ambulancesTable tbody tr').forEach(function(row) {
                row.style.display = row.textContent.toLowerCase().includes(filter) ? '' : 'none';
            });
        });
    </script>
}
