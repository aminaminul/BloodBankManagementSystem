@model BBDMS.Model.Models.Entities.Hospital
@{
    ViewData["Title"] = "Add Hospital & ICU Facility";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="card content-card shadow-sm">
            <div class="card-header bg-white py-3">
                <h4 class="mb-0 font-weight-bold text-dark"><i class="fas fa-hospital mr-2 text-primary"></i>Register New Hospital</h4>
            </div>
            <div class="card-body p-4">
                <form method="post" asp-action="HospitalCreate">
                    @Html.AntiForgeryToken()

                    <div class="form-row">
                        <div class="form-group col-md-8">
                            <label asp-for="Name" class="font-weight-bold">Hospital Name <span class="text-danger">*</span></label>
                            <input asp-for="Name" class="form-control" required />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                        <div class="form-group col-md-4">
                            <label asp-for="City" class="font-weight-bold">City / District <span class="text-danger">*</span></label>
                            <input asp-for="City" class="form-control" required />
                            <span asp-validation-for="City" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="form-group">
                        <label asp-for="Address" class="font-weight-bold">Full Address</label>
                        <input asp-for="Address" class="form-control" />
                    </div>

                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label asp-for="ContactNumber" class="font-weight-bold">General Contact Number</label>
                            <input asp-for="ContactNumber" class="form-control" />
                        </div>
                        <div class="form-group col-md-6">
                            <label asp-for="EmergencyHelpline" class="font-weight-bold">24/7 Emergency Helpline <span class="text-danger">*</span></label>
                            <input asp-for="EmergencyHelpline" class="form-control" required />
                        </div>
                    </div>

                    <div class="card bg-light p-3 mb-3 border-0">
                        <h6 class="font-weight-bold text-dark mb-3"><i class="fas fa-bed mr-2 text-primary"></i>Emergency Bed & ICU Capacity</h6>
                        <div class="form-row">
                            <div class="form-group col-md-3">
                                <label asp-for="TotalEmergencyBeds" class="small font-weight-bold">Total Emergency Beds</label>
                                <input asp-for="TotalEmergencyBeds" type="number" min="0" class="form-control" />
                            </div>
                            <div class="form-group col-md-3">
                                <label asp-for="AvailableEmergencyBeds" class="small font-weight-bold text-success">Available Emergency Beds</label>
                                <input asp-for="AvailableEmergencyBeds" type="number" min="0" class="form-control" />
                            </div>
                            <div class="form-group col-md-3">
                                <label asp-for="TotalIcuBeds" class="small font-weight-bold">Total ICU Beds</label>
                                <input asp-for="TotalIcuBeds" type="number" min="0" class="form-control" />
                            </div>
                            <div class="form-group col-md-3">
                                <label asp-for="AvailableIcuBeds" class="small font-weight-bold text-danger">Available ICU Beds</label>
                                <input asp-for="AvailableIcuBeds" type="number" min="0" class="form-control" />
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label asp-for="EmergencyServices" class="font-weight-bold">Specialized Emergency Services</label>
                        <textarea asp-for="EmergencyServices" class="form-control" rows="2" placeholder="e.g. 24/7 Trauma Care, Cardiac Emergency, Stroke Center, Burn Unit"></textarea>
                    </div>

                    <div class="text-right mt-4">
                        <a asp-action="Hospitals" class="btn btn-secondary mr-2">Cancel</a>
                        <button type="submit" class="btn btn-primary font-weight-bold px-4">Save Hospital</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
