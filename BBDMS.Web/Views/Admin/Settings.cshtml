@model BBDMS.Model.Models.Entities.Admin
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Settings";
}

<div class="mb-4">
    <h4 class="fw-bold mb-1">Settings</h4>
    <p class="text-muted mb-0">Manage your administrator account settings.</p>
</div>

<!-- Tab style navigation -->
<div class="seg-tabs mb-4">
    <a class="active" asp-action="Settings">Profile</a>
    <a asp-action="Settings">Security</a>
    <a asp-action="Settings">Notifications</a>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card-modern text-center">
            <div class="avatar-circle mx-auto mb-3" style="width:72px;height:72px;font-size:1.8rem;">
                @((Model.AdminName ?? Model.UserName ?? "A").Substring(0, 1).ToUpper())
            </div>
            <h5 class="fw-bold mb-0">@(Model.AdminName ?? Model.UserName)</h5>
            <small class="text-muted d-block mb-2">@Model.Email</small>
            <span class="badge-soft-danger"><i class="fas fa-shield-alt"></i>Administrator</span>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card-modern">
            <h5 class="fw-bold mb-4">Profile Information</h5>

            <form asp-action="Settings" method="post">
                @Html.AntiForgeryToken()
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Full Name</label>
                        <input type="text" name="AdminName" value="@Model.AdminName" class="form-control form-control-modern" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Username</label>
                        <input type="text" value="@Model.UserName" class="form-control form-control-modern" readonly style="background:#f8fafc;" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Email Address</label>
                        <input type="email" name="Email" value="@Model.Email" class="form-control form-control-modern" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Phone Number</label>
                        <input type="text" name="MobileNumber" value="@Model.MobileNumber" class="form-control form-control-modern" />
                    </div>
                </div>

                <div class="border-top mt-4 pt-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <a asp-controller="Account" asp-action="ChangePassword" class="text-muted small"><i class="fas fa-key me-1"></i>Change password</a>
                    <button type="submit" class="btn btn-brand-red"><i class="fas fa-save me-1"></i>Update Settings</button>
                </div>
            </form>
        </div>
    </div>
</div>
