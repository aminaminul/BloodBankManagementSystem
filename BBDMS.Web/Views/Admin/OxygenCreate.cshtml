@model BBDMS.Model.Models.Entities.OxygenService
@{
    ViewData["Title"] = "Add Oxygen Supplier";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card content-card shadow-sm">
            <div class="card-header bg-white py-3">
                <h4 class="mb-0 font-weight-bold text-dark"><i class="fas fa-lungs mr-2 text-info"></i>Register Oxygen Gas Supplier</h4>
            </div>
            <div class="card-body p-4">
                <form method="post" asp-action="OxygenCreate">
                    @Html.AntiForgeryToken()

                    <div class="form-row">
                        <div class="form-group col-md-8">
                            <label asp-for="ProviderName" class="font-weight-bold">Supplier / Company Name <span class="text-danger">*</span></label>
                            <input asp-for="ProviderName" class="form-control" required />
                            <span asp-validation-for="ProviderName" class="text-danger small"></span>
                        </div>
                        <div class="form-group col-md-4">
                            <label asp-for="Location" class="font-weight-bold">Location / City <span class="text-danger">*</span></label>
                            <input asp-for="Location" class="form-control" required />
                            <span asp-validation-for="Location" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="form-group">
                        <label asp-for="Address" class="font-weight-bold">Address / Outlet Location</label>
                        <input asp-for="Address" class="form-control" />
                    </div>

                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label asp-for="ContactNumber" class="font-weight-bold">Hotline / WhatsApp Number <span class="text-danger">*</span></label>
                            <input asp-for="ContactNumber" class="form-control" required />
                            <span asp-validation-for="ContactNumber" class="text-danger small"></span>
                        </div>
                        <div class="form-group col-md-6">
                            <label asp-for="OxygenAvailability" class="font-weight-bold">Stock Availability</label>
                            <select asp-for="OxygenAvailability" class="form-control">
                                <option value="In Stock">In Stock (Available)</option>
                                <option value="Limited">Limited Stock</option>
                                <option value="Out of Stock">Out of Stock</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-group">
                        <label asp-for="CylinderCapacity" class="font-weight-bold">Available Cylinder Types & Capacities</label>
                        <input asp-for="CylinderCapacity" class="form-control" value="1.4m³, 6.8m³, Oxygen Concentrators" />
                    </div>

                    <div class="form-group">
                        <div class="custom-control custom-checkbox">
                            <input type="checkbox" class="custom-control-input" id="homeDelivery" asp-for="HomeDeliveryAvailable" checked />
                            <label class="custom-control-label font-weight-bold" for="homeDelivery">Home Delivery Available (24/7)</label>
                        </div>
                    </div>

                    <div class="form-group">
                        <label asp-for="ServiceDetails" class="font-weight-bold">Service Details & Included Accessories</label>
                        <textarea asp-for="ServiceDetails" class="form-control" rows="2" placeholder="e.g. Cylinders supplied with mask, regulator, flowmeter and cannula. Emergency refills available."></textarea>
                    </div>

                    <div class="text-right mt-4">
                        <a asp-action="Oxygen" class="btn btn-secondary mr-2">Cancel</a>
                        <button type="submit" class="btn btn-info font-weight-bold text-white px-4">Save Oxygen Supplier</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
