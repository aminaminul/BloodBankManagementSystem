@model IEnumerable<BBDMS.Model.Models.Entities.BloodBank>
@{
    ViewData["Title"] = "Manage Blood Banks";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h3 class="fw-bold text-dark mb-0">Registered Blood Banks</h3>
        <p class="text-muted mb-0">Manage blood bank listings, inventory stock, and contact information</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <input type="text" id="bloodbanksTableSearch" class="form-control form-control-modern" placeholder="Search blood banks..." style="width: 240px;" />
        <a asp-action="BloodBankCreate" class="btn btn-brand-red text-nowrap">
            <i class="fas fa-plus me-1"></i>Add Blood Bank
        </a>
    </div>
</div>

<div class="card-modern p-0">
    <div class="table-responsive">
        <table class="table table-hover mb-0" id="bloodbanksTable">
            <thead style="background:#f8fafc;">
                <tr style="font-size:.78rem; text-transform:uppercase; color:#64748b; letter-spacing:.05em;">
                    <th class="ps-4">Blood Bank Name</th>
                    <th>Affiliation</th>
                    <th>City / Location</th>
                    <th>Stocked Blood Groups</th>
                    <th>Contact</th>
                    <th>Operating Hours</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr style="vertical-align:middle;">
                            <td class="ps-4">
                                <div class="fw-semibold text-dark">@item.Name</div>
                                <div class="small text-muted">@item.Address</div>
                            </td>
                            <td><span class="badge-soft-primary">@item.HospitalAffiliation</span></td>
                            <td><span class="badge-soft-danger">@item.City</span></td>
                            <td style="max-width: 250px;">
                                <div class="d-flex flex-wrap gap-1">
                                    @if (!string.IsNullOrEmpty(item.AvailableBloodGroups))
                                    {
                                        var groups = item.AvailableBloodGroups.Split(new[] { ',', ' ' }, StringSplitOptions.RemoveEmptyEntries);
                                        foreach (var bg in groups)
                                        {
                                            <span class="badge-soft-danger px-1 py-0 small fw-bold">@bg</span>
                                        }
                                    }
                                </div>
                            </td>
                            <td>
                                <a href="tel:@item.ContactNumber" class="text-dark fw-semibold small">
                                    <i class="fas fa-phone me-1 text-success"></i>@item.ContactNumber
                                </a>
                            </td>
                            <td class="small text-muted">@item.OperatingHours</td>
                            <td class="text-end pe-4">
                                <a asp-action="BloodBankEdit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-1" title="Edit">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <form asp-action="BloodBankDelete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this blood bank?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="fas fa-landmark fa-2x mb-2 d-block text-secondary"></i>No blood banks registered yet.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('bloodbanksTableSearch')?.addEventListener('keyup', function() {
            var filter = this.value.toLowerCase();
            document.querySelectorAll('#bloodbanksTable tbody tr').forEach(function(row) {
                row.style.display = row.textContent.toLowerCase().includes(filter) ? '' : 'none';
            });
        });
    </script>
}
