@model IEnumerable<BBDMS.Model.Models.Entities.BloodBank>
@{
    ViewData["Title"] = "Manage Blood Banks";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="font-weight-bold text-dark mb-0">Registered Blood Banks</h3>
        <p class="text-muted mb-0">Manage blood bank listings, inventory stock, and contact information</p>
    </div>
    <a asp-action="BloodBankCreate" class="btn btn-danger font-weight-bold">
        <i class="fas fa-plus mr-1"></i>Add New Blood Bank
    </a>
</div>

<div class="card content-card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="thead-light">
                    <tr>
                        <th>Blood Bank Name</th>
                        <th>Affiliation</th>
                        <th>City / Location</th>
                        <th>Stocked Blood Groups</th>
                        <th>Contact</th>
                        <th>Operating Hours</th>
                        <th class="text-right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@item.Name</strong>
                                    <div class="small text-muted">@item.Address</div>
                                </td>
                                <td><span class="badge badge-info">@item.HospitalAffiliation</span></td>
                                <td><span class="badge badge-danger">@item.City</span></td>
                                <td style="max-width: 250px;">
                                    <small class="text-dark font-weight-bold">@item.AvailableBloodGroups</small>
                                </td>
                                <td><i class="fas fa-phone mr-1 text-success"></i>@item.ContactNumber</td>
                                <td>@item.OperatingHours</td>
                                <td class="text-right">
                                    <a asp-action="BloodBankEdit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary mr-1">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <a asp-action="BloodBankDelete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" onclick="return confirm('Are you sure you want to delete this blood bank?');">
                                        <i class="fas fa-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">No blood banks registered yet.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
