@model BBDMS.Model.Models.ViewModels.PagedResult<BBDMS.Model.Models.Entities.BloodRequest>
@{
    ViewData["Title"] = "Manage Emergency Blood Requests";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["PageIndex"] = Model.PageIndex;
    ViewData["TotalPages"] = Model.TotalPages;
    ViewData["ActionName"] = "BloodRequests";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h3 class="fw-bold text-dark mb-0">Emergency Blood Requests</h3>
        <p class="text-muted mb-0">Monitor, verify, and update patient blood requests &mdash; <strong>@Model.TotalItems</strong> total</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <input type="text" id="requestsTableSearch" class="form-control form-control-modern" placeholder="Search requests..." style="width:220px;" />
        <a asp-action="ExportRequestsCsv" class="btn btn-brand-outline text-nowrap">
            <i class="fas fa-file-csv me-1"></i>Export CSV
        </a>
    </div>
</div>

<div class="card-modern p-0">
    <div class="table-responsive">
        <table class="table table-hover mb-0" id="requestsTable">
            <thead style="background:#f8fafc;">
                <tr style="font-size:.78rem; text-transform:uppercase; color:#64748b; letter-spacing:.05em;">
                    <th class="ps-4">Patient / Requester</th>
                    <th>Blood Group</th>
                    <th>Units</th>
                    <th>Hospital &amp; Location</th>
                    <th>Priority</th>
                    <th>Date</th>
                    <th>Status</th>
                    <th class="text-end pe-4">Update</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items != null && Model.Items.Any())
                {
                    foreach (var item in Model.Items)
                    {
                        <tr style="vertical-align:middle;">
                            <td class="ps-4">
                                <div class="fw-semibold">@item.Name</div>
                                <div class="text-muted small"><i class="fas fa-phone me-1"></i>@item.ContactNumber</div>
                            </td>
                            <td>
                                <span class="badge-soft-danger fw-bold px-2" style="font-size:.85rem;">
                                    @(item.BloodGroup ?? item.BloodRequireFor)
                                </span>
                            </td>
                            <td>
                                <span class="badge-soft-primary">@item.UnitsRequired Unit@(item.UnitsRequired > 1 ? "s" : "")</span>
                            </td>
                            <td>
                                <div class="fw-semibold small">@(string.IsNullOrEmpty(item.HospitalName) ? "—" : item.HospitalName)</div>
                                <div class="text-muted small"><i class="fas fa-map-marker-alt me-1 text-danger"></i>@item.Location</div>
                            </td>
                            <td>
                                @if (item.Urgency?.Contains("Critical") == true || item.Urgency == "Critical")
                                {
                                    <span class="badge-soft-danger">@item.Urgency</span>
                                }
                                else
                                {
                                    <span class="badge-soft-warning">@item.Urgency</span>
                                }
                            </td>
                            <td class="small text-muted">@(item.ApplyDate.HasValue ? item.ApplyDate.Value.ToString("MMM dd, yyyy") : "—")</td>
                            <td>
                                @if (item.Status == "Fulfilled")
                                {
                                    <span class="badge-soft-success"><i class="fas fa-check-circle me-1"></i>Fulfilled</span>
                                }
                                else if (item.Status == "Approved")
                                {
                                    <span class="badge-soft-primary">Approved</span>
                                }
                                else if (item.Status == "Cancelled")
                                {
                                    <span class="badge bg-secondary text-white" style="border-radius:8px;">Cancelled</span>
                                }
                                else
                                {
                                    <span class="badge-soft-warning"><i class="fas fa-clock me-1"></i>Pending</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <div class="btn-group btn-group-sm">
                                    <form asp-action="UpdateRequestStatus" asp-route-id="@item.ID" asp-route-status="Approved" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-primary" title="Approve"><i class="fas fa-check"></i></button>
                                    </form>
                                    <form asp-action="UpdateRequestStatus" asp-route-id="@item.ID" asp-route-status="Fulfilled" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-success" title="Mark Fulfilled"><i class="fas fa-hand-holding-heart"></i></button>
                                    </form>
                                    <form asp-action="UpdateRequestStatus" asp-route-id="@item.ID" asp-route-status="Cancelled" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-secondary" title="Cancel"><i class="fas fa-times"></i></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="fas fa-tint fa-2x mb-2 d-block text-danger"></i>No blood requests submitted yet.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<partial name="_Pagination" view-data="ViewData" />

@section Scripts {
    <script>
        document.getElementById('requestsTableSearch')?.addEventListener('keyup', function () {
            var filter = this.value.toLowerCase();
            document.querySelectorAll('#requestsTable tbody tr').forEach(function (row) {
                row.style.display = row.textContent.toLowerCase().includes(filter) ? '' : 'none';
            });
        });
    </script>
}
