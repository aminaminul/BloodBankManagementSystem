@model BBDMS.Model.Models.ViewModels.PagedResult<BBDMS.Model.Models.Entities.BloodRequest>
@{
    ViewData["Title"] = "Manage Emergency Blood Requests";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["PageIndex"] = Model.PageIndex;
    ViewData["TotalPages"] = Model.TotalPages;
    ViewData["ActionName"] = "BloodRequests";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="font-weight-bold text-dark mb-0">Emergency Blood Requests</h3>
        <p class="text-muted mb-0">Monitor, verify, and update patient blood requests across hospitals (@Model.TotalItems total)</p>
    </div>
    <div>
        <input type="text" id="requestsTableSearch" class="form-control" placeholder="Search requests..." style="width: 250px;" />
    </div>
</div>

<div class="card content-card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0" id="requestsTable">
                <thead class="thead-light">
                    <tr>
                        <th>Patient / Requester</th>
                        <th>Blood Group</th>
                        <th>Units</th>
                        <th>Hospital & Location</th>
                        <th>Priority</th>
                        <th>Posting Date</th>
                        <th>Status</th>
                        <th class="text-right">Update Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items != null && Model.Items.Any())
                    {
                        foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>
                                    <strong>@item.Name</strong>
                                    <div class="small text-muted"><i class="fas fa-phone mr-1"></i>@item.ContactNumber</div>
                                </td>
                                <td>
                                    <span class="badge badge-danger px-2 py-1 font-weight-bold">
                                        @(item.BloodGroup ?? item.BloodRequireFor)
                                    </span>
                                </td>
                                <td><span class="badge badge-dark">@item.UnitsRequired Unit@(item.UnitsRequired > 1 ? "s" : "")</span></td>
                                <td>
                                    <div>@(string.IsNullOrEmpty(item.HospitalName) ? "Hospital" : item.HospitalName)</div>
                                    <small class="text-muted"><i class="fas fa-map-marker-alt mr-1 text-danger"></i>@item.Location</small>
                                </td>
                                <td>
                                    <span class="badge @(item.Urgency == "Critical" || item.Urgency?.Contains("Critical") == true ? "badge-danger" : "badge-warning")">
                                        @item.Urgency
                                    </span>
                                </td>
                                <td class="small text-muted">@(item.ApplyDate.HasValue ? item.ApplyDate.Value.ToString("MMM dd, yyyy") : "")</td>
                                <td>
                                    @if (item.Status == "Fulfilled")
                                    {
                                        <span class="badge badge-success px-2 py-1"><i class="fas fa-check-circle mr-1"></i>Fulfilled</span>
                                    }
                                    else if (item.Status == "Approved")
                                    {
                                        <span class="badge badge-primary px-2 py-1">Approved</span>
                                    }
                                    else if (item.Status == "Cancelled")
                                    {
                                        <span class="badge badge-secondary px-2 py-1">Cancelled</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-warning text-dark px-2 py-1"><i class="fas fa-clock mr-1"></i>Pending</span>
                                    }
                                </td>
                                <td class="text-right">
                                    <div class="btn-group btn-group-sm">
                                        <form asp-action="UpdateRequestStatus" asp-route-id="@item.ID" asp-route-status="Approved" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-primary" title="Approve Request">
                                                <i class="fas fa-check"></i>
                                            </button>
                                        </form>
                                        <form asp-action="UpdateRequestStatus" asp-route-id="@item.ID" asp-route-status="Fulfilled" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-success" title="Mark as Fulfilled">
                                                <i class="fas fa-hand-holding-heart"></i>
                                            </button>
                                        </form>
                                        <form asp-action="UpdateRequestStatus" asp-route-id="@item.ID" asp-route-status="Cancelled" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-secondary" title="Cancel Request">
                                                <i class="fas fa-times"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">No blood requests submitted yet.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<partial name="_Pagination" view-data="ViewData" />

@section Scripts {
    <script>
        document.getElementById('requestsTableSearch')?.addEventListener('keyup', function() {
            var filter = this.value.toLowerCase();
            var rows = document.querySelectorAll('#requestsTable tbody tr');
            rows.forEach(function(row) {
                var text = row.textContent.toLowerCase();
                row.style.display = text.includes(filter) ? '' : 'none';
            });
        });
    </script>
}
