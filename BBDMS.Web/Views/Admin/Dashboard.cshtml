@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin</title>
    <link rel="stylesheet" href="~/css/bootstrap.css" />
    <style>
        body { padding-top: 50px; }
        .sidebar { height: 100vh; background-color: #343a40; padding-top: 20px;}
        .sidebar a { color: white; padding: 10px; display: block; text-decoration: none;}
        .sidebar a:hover { background-color: #495057; }
    </style>
</head>
<body>
    <nav class="navbar navbar-dark bg-dark fixed-top">
        <a class="navbar-brand" href="#">BBDMS Admin</a>
        <ul class="navbar-nav ml-auto">
            <li class="nav-item">
                <a class="nav-link text-white" asp-action="Logout">Logout</a>
            </li>
        </ul>
    </nav>

    <div class="container-fluid">
        <div class="row">
            <nav class="col-md-2 sidebar">
                <a asp-action="Dashboard">Dashboard</a>
                <a asp-action="DonorList">Donor List</a>
                <a href="/">Go to Site</a>
            </nav>
            <main role="main" class="col-md-10 ml-sm-auto px-4 mt-4">
                <h2>Dashboard</h2>
                <div class="row mt-4">
                    <div class="col-md-4">
                        <div class="card text-white bg-primary mb-3">
                            <div class="card-body">
                                <h5 class="card-title">Total Donors</h5>
                                <p class="card-text display-4">@ViewBag.TotalDonors</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card text-white bg-danger mb-3">
                            <div class="card-body">
                                <h5 class="card-title">Blood Requests</h5>
                                <p class="card-text display-4">@ViewBag.TotalRequests</p>
                            </div>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </div>
</body>
</html>
