@model BBDMS.Model.Models.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="dash-topbar">
    <div>
        <h4>Emergency System Overview</h4>
        <small>Real-time statistics across blood donation and healthcare support facilities</small>
    </div>
    <span class="live-pill"><span class="live-dot" aria-hidden="true"></span> Live via SignalR</span>
</div>

@* Row 1: Key metrics *@
<div class="row g-3 mb-3">
    <div class="col-6 col-lg-3">
        <a class="stat-card" asp-action="DonorList">
            <span class="stat-ico blue"><i class="fas fa-users" aria-hidden="true"></i></span>
            <span class="stat-body">
                <span class="stat-val">@Model.TotalDonors</span>
                <span class="stat-cap">Total donors</span>
                <span class="stat-link">View all donors <i class="fas fa-arrow-right" aria-hidden="true"></i></span>
            </span>
        </a>
    </div>

    <div class="col-6 col-lg-3">
        <a class="stat-card" asp-action="BloodRequests">
            <span class="stat-ico red"><i class="fas fa-tint" aria-hidden="true"></i></span>
            <span class="stat-body">
                <span class="stat-val">@Model.TotalRequests</span>
                <span class="stat-cap">Blood requests</span>
                <span class="stat-link">Manage requests <i class="fas fa-arrow-right" aria-hidden="true"></i></span>
            </span>
        </a>
    </div>

    <div class="col-6 col-lg-3">
        <a class="stat-card" asp-action="Hospitals">
            <span class="stat-ico green"><i class="fas fa-hospital" aria-hidden="true"></i></span>
            <span class="stat-body">
                <span class="stat-val">@Model.TotalHospitals</span>
                <span class="stat-cap">Hospitals</span>
                <span class="stat-link">@Model.TotalAvailableIcuBeds ICU beds free <i class="fas fa-arrow-right" aria-hidden="true"></i></span>
            </span>
        </a>
    </div>

    <div class="col-6 col-lg-3">
        <a class="stat-card" asp-action="Ambulances">
            <span class="stat-ico amber"><i class="fas fa-ambulance" aria-hidden="true"></i></span>
            <span class="stat-body">
                <span class="stat-val">@Model.TotalAmbulances</span>
                <span class="stat-cap">Ambulances</span>
                <span class="stat-link">Manage fleets <i class="fas fa-arrow-right" aria-hidden="true"></i></span>
            </span>
        </a>
    </div>
</div>

@* Row 2: Secondary metrics + quick actions *@
<div class="row g-3 mb-4 align-items-start">
    <div class="col-6 col-lg-3">
        <a class="stat-card" asp-action="Oxygen">
            <span class="stat-ico teal"><i class="fas fa-lungs" aria-hidden="true"></i></span>
            <span class="stat-body">
                <span class="stat-val">@Model.TotalOxygenSuppliers</span>
                <span class="stat-cap">Oxygen suppliers</span>
                <span class="stat-link">Manage suppliers <i class="fas fa-arrow-right" aria-hidden="true"></i></span>
            </span>
        </a>
    </div>

    <div class="col-6 col-lg-3">
        <a class="stat-card" asp-action="BloodBanks">
            <span class="stat-ico violet"><i class="fas fa-landmark" aria-hidden="true"></i></span>
            <span class="stat-body">
                <span class="stat-val">@Model.TotalBloodBanks</span>
                <span class="stat-cap">Blood banks</span>
                <span class="stat-link">Manage blood banks <i class="fas fa-arrow-right" aria-hidden="true"></i></span>
            </span>
        </a>
    </div>

    <div class="col-lg-6">
        <div class="card-modern h-100">
            <h5 class="fw-bold mb-3">Quick resource actions</h5>
            <div class="row g-2">
                <div class="col-12 col-sm-6">
                    <a asp-action="HospitalCreate" class="btn btn-brand-outline w-100 justify-content-start">
                        <i class="fas fa-plus" aria-hidden="true"></i> Add hospital
                    </a>
                </div>
                <div class="col-12 col-sm-6">
                    <a asp-action="BloodBankCreate" class="btn btn-brand-outline w-100 justify-content-start">
                        <i class="fas fa-plus" aria-hidden="true"></i> Add blood bank
                    </a>
                </div>
                <div class="col-12 col-sm-6">
                    <a asp-action="AmbulanceCreate" class="btn btn-brand-outline w-100 justify-content-start">
                        <i class="fas fa-plus" aria-hidden="true"></i> Add ambulance
                    </a>
                </div>
                <div class="col-12 col-sm-6">
                    <a asp-action="OxygenCreate" class="btn btn-brand-outline w-100 justify-content-start">
                        <i class="fas fa-plus" aria-hidden="true"></i> Add oxygen supplier
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
