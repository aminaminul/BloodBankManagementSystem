@model IEnumerable<BBDMS.Model.Models.Entities.BloodDonor>
@{
    ViewData["Title"] = "Donor List";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin</title>
    <link rel="stylesheet" href="~/css/bootstrap.css" />
    <style>
        body { padding-top: 50px; }
        .sidebar { height: 100vh; background-color: #343a40; padding-top: 20px;}
        .sidebar a { color: white; padding: 10px; display: block; text-decoration: none;}
        .sidebar a:hover { background-color: #495057; }
    </style>
</head>
<body>
    <nav class="navbar navbar-dark bg-dark fixed-top">
        <a class="navbar-brand" href="#">BBDMS Admin</a>
        <ul class="navbar-nav ml-auto">
            <li class="nav-item">
                <a class="nav-link text-white" asp-action="Logout">Logout</a>
            </li>
        </ul>
    </nav>

    <div class="container-fluid">
        <div class="row">
            <nav class="col-md-2 sidebar">
                <a asp-action="Dashboard">Dashboard</a>
                <a asp-action="DonorList">Donor List</a>
                <a href="/">Go to Site</a>
            </nav>
            <main role="main" class="col-md-10 ml-sm-auto px-4 mt-4">
                <h2>Donor List</h2>
                <div class="table-responsive mt-4">
                    <table class="table table-striped table-sm">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Name</th>
                                <th>Mobile</th>
                                <th>Email</th>
                                <th>Blood Group</th>
                                <th>Age</th>
                                <th>Gender</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ int i = 1; }
                            @foreach (var donor in Model)
                            {
                                <tr>
                                    <td>@(i++)</td>
                                    <td>@donor.FullName</td>
                                    <td>@donor.MobileNumber</td>
                                    <td>@donor.EmailId</td>
                                    <td>@donor.BloodGroup</td>
                                    <td>@donor.Age</td>
                                    <td>@donor.Gender</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </main>
        </div>
    </div>
</body>
</html>
