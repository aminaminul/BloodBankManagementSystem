@model IEnumerable<BBDMS.Model.Models.Entities.BloodDonor>
@{
    ViewData["Title"] = "Manage Registered Donors";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="font-weight-bold text-dark mb-0">Registered Blood Donors</h3>
        <p class="text-muted mb-0">Manage donor accounts, active status, and blood donation availability</p>
    </div>
</div>

<div class="card content-card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="thead-light">
                    <tr>
                        <th>#</th>
                        <th>Donor Name</th>
                        <th>Blood Group</th>
                        <th>Contact / Phone</th>
                        <th>Location</th>
                        <th>Gender / Age</th>
                        <th>Status</th>
                        <th>Availability</th>
                        <th class="text-right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int i = 1; }
                    @if (Model != null && Model.Any())
                    {
                        foreach (var donor in Model)
                        {
                            <tr>
                                <td>@(i++)</td>
                                <td>
                                    <strong>@donor.FullName</strong>
                                    <div class="small text-muted">@donor.EmailId</div>
                                </td>
                                <td>
                                    <span class="badge badge-danger px-2 py-1 font-weight-bold">@donor.BloodGroup</span>
                                </td>
                                <td>
                                    <a href="tel:@donor.MobileNumber" class="text-dark font-weight-bold">
                                        <i class="fas fa-phone mr-1 text-success"></i>@donor.MobileNumber
                                    </a>
                                </td>
                                <td style="max-width: 200px;"><small>@donor.Address</small></td>
                                <td>@donor.Gender / @(donor.Age.HasValue ? donor.Age.Value.ToString() : "N/A") yrs</td>
                                <td>
                                    <a asp-action="ToggleDonorStatus" asp-route-id="@donor.Id" class="badge @(donor.Status == 1 ? "badge-success" : "badge-secondary") text-decoration-none" title="Click to toggle Active/Inactive">
                                        @(donor.Status == 1 ? "Active" : "Inactive")
                                    </a>
                                </td>
                                <td>
                                    <a asp-action="ToggleDonorAvailability" asp-route-id="@donor.Id" class="badge @(donor.IsAvailable ? "badge-primary" : "badge-warning text-dark") text-decoration-none" title="Click to toggle availability">
                                        @(donor.IsAvailable ? "Available" : "Unavailable")
                                    </a>
                                </td>
                                <td class="text-right">
                                    <a asp-action="DeleteDonor" asp-route-id="@donor.Id" class="btn btn-sm btn-outline-danger" onclick="return confirm('Are you sure you want to delete this donor record?');">
                                        <i class="fas fa-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center py-4 text-muted">No donors registered yet.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
