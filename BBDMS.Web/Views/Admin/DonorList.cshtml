@model BBDMS.Model.Models.ViewModels.PagedResult<BBDMS.Model.Models.Entities.BloodDonor>
@{
    ViewData["Title"] = "Manage Registered Donors";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["PageIndex"] = Model.PageIndex;
    ViewData["TotalPages"] = Model.TotalPages;
    ViewData["ActionName"] = "DonorList";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h3 class="fw-bold text-dark mb-0">Registered Blood Donors</h3>
        <p class="text-muted mb-0">Manage donor accounts, status, and availability &mdash; <strong>@Model.TotalItems</strong> total</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <input type="text" id="donorTableSearch" class="form-control form-control-modern" placeholder="&#xf002; Search donors..." style="width:220px;" />
        <a asp-action="ExportDonorsCsv" class="btn btn-brand-outline text-nowrap">
            <i class="fas fa-file-csv me-1"></i>Export CSV
        </a>
    </div>
</div>

<div class="card-modern p-0">
    <div class="table-responsive">
        <table class="table table-hover mb-0" id="donorTable">
            <thead style="background:#f8fafc;">
                <tr style="font-size:.78rem; text-transform:uppercase; color:#64748b; letter-spacing:.05em;">
                    <th class="ps-4">#</th>
                    <th>Donor</th>
                    <th>Blood Group</th>
                    <th>Contact</th>
                    <th>Location</th>
                    <th>Age / Gender</th>
                    <th>Eligibility</th>
                    <th>Status</th>
                    <th>Available</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @{ int i = (Model.PageIndex - 1) * Model.PageSize + 1; }
                @if (Model.Items != null && Model.Items.Any())
                {
                    foreach (var donor in Model.Items)
                    {
                        <tr style="vertical-align:middle;">
                            <td class="ps-4 text-muted small">@(i++)</td>
                            <td>
                                <div class="fw-semibold">@donor.FullName</div>
                                <div class="text-muted small">@donor.EmailId</div>
                            </td>
                            <td>
                                <span class="badge-soft-danger fw-bold px-2 py-1" style="font-size:.85rem;">@donor.BloodGroup</span>
                            </td>
                            <td>
                                <a href="tel:@donor.MobileNumber" class="text-dark fw-semibold small">
                                    <i class="fas fa-phone me-1 text-success"></i>@donor.MobileNumber
                                </a>
                            </td>
                            <td class="small text-muted" style="max-width:150px;">@donor.Address</td>
                            <td class="small">@donor.Age yrs &bull; @donor.Gender</td>
                            <td>
                                @if (donor.IsEligibleToDonate)
                                {
                                    <span class="badge-soft-success"><i class="fas fa-check-circle me-1"></i>Eligible</span>
                                }
                                else
                                {
                                    <span class="badge-soft-warning" title="Must wait 90 days between donations">
                                        <i class="fas fa-clock me-1"></i>@donor.DaysUntilEligible days
                                    </span>
                                }
                            </td>
                            <td>
                                <form asp-action="ToggleDonorStatus" asp-route-id="@donor.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm border-0 p-0 @(donor.Status == 1 ? "badge-soft-success" : "badge-soft-danger")" title="Toggle status">
                                        @(donor.Status == 1 ? "Active" : "Inactive")
                                    </button>
                                </form>
                            </td>
                            <td>
                                <form asp-action="ToggleDonorAvailability" asp-route-id="@donor.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm border-0 p-0 @(donor.IsAvailable ? "badge-soft-primary" : "badge-soft-warning")" title="Toggle availability">
                                        @(donor.IsAvailable ? "Available" : "Busy")
                                    </button>
                                </form>
                            </td>
                            <td class="text-end pe-4">
                                <form asp-action="DeleteDonor" asp-route-id="@donor.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Delete this donor record?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="10" class="text-center py-5 text-muted">
                            <i class="fas fa-users fa-2x mb-2 d-block"></i>No donors registered yet.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<partial name="_Pagination" view-data="ViewData" />

@section Scripts {
    <script>
        document.getElementById('donorTableSearch')?.addEventListener('keyup', function () {
            var filter = this.value.toLowerCase();
            document.querySelectorAll('#donorTable tbody tr').forEach(function (row) {
                row.style.display = row.textContent.toLowerCase().includes(filter) ? '' : 'none';
            });
        });
    </script>
}
