@model BBDMS.Model.Models.ViewModels.PagedResult<BBDMS.Model.Models.Entities.BloodDonor>
@{
    ViewData["Title"] = "Manage Registered Donors";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["PageIndex"] = Model.PageIndex;
    ViewData["TotalPages"] = Model.TotalPages;
    ViewData["ActionName"] = "DonorList";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="font-weight-bold text-dark mb-0">Registered Blood Donors</h3>
        <p class="text-muted mb-0">Manage donor accounts, active status, and blood donation availability (@Model.TotalItems total)</p>
    </div>
    <div>
        <input type="text" id="donorTableSearch" class="form-control" placeholder="Search donors..." style="width: 250px;" />
    </div>
</div>

<div class="card content-card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0" id="donorTable">
                <thead class="thead-light">
                    <tr>
                        <th>#</th>
                        <th>Donor Name</th>
                        <th>Blood Group</th>
                        <th>Contact / Phone</th>
                        <th>Location</th>
                        <th>Gender / Age</th>
                        <th>Medical Eligibility</th>
                        <th>Status</th>
                        <th>Availability</th>
                        <th class="text-right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int i = (Model.PageIndex - 1) * Model.PageSize + 1; }
                    @if (Model.Items != null && Model.Items.Any())
                    {
                        foreach (var donor in Model.Items)
                        {
                            <tr>
                                <td>@(i++)</td>
                                <td>
                                    <strong>@donor.FullName</strong>
                                    <div class="small text-muted">@donor.EmailId</div>
                                </td>
                                <td>
                                    <span class="badge badge-danger px-2 py-1 font-weight-bold">@donor.BloodGroup</span>
                                </td>
                                <td>
                                    <a href="tel:@donor.MobileNumber" class="text-dark font-weight-bold">
                                        <i class="fas fa-phone mr-1 text-success"></i>@donor.MobileNumber
                                    </a>
                                </td>
                                <td style="max-width: 180px;"><small>@donor.Address</small></td>
                                <td>@donor.Gender / @(donor.Age.HasValue ? donor.Age.Value.ToString() : "N/A") yrs</td>
                                <td>
                                    @if (donor.IsEligibleToDonate)
                                    {
                                        <span class="badge badge-success px-2 py-1"><i class="fas fa-check-circle mr-1"></i>Eligible</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-warning text-dark px-2 py-1" title="Must wait 90 days between donations">
                                            <i class="fas fa-clock mr-1"></i>In @donor.DaysUntilEligible days
                                        </span>
                                    }
                                </td>
                                <td>
                                    <form asp-action="ToggleDonorStatus" asp-route-id="@donor.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm p-0 badge @(donor.Status == 1 ? "badge-success" : "badge-secondary") border-0" title="Click to toggle Active/Inactive">
                                            @(donor.Status == 1 ? "Active" : "Inactive")
                                        </button>
                                    </form>
                                </td>
                                <td>
                                    <form asp-action="ToggleDonorAvailability" asp-route-id="@donor.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm p-0 badge @(donor.IsAvailable ? "badge-primary" : "badge-warning text-dark") border-0" title="Click to toggle availability">
                                            @(donor.IsAvailable ? "Available" : "Unavailable")
                                        </button>
                                    </form>
                                </td>
                                <td class="text-right">
                                    <form asp-action="DeleteDonor" asp-route-id="@donor.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this donor record?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete Donor">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="10" class="text-center py-4 text-muted">No donors registered yet.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<partial name="_Pagination" view-data="ViewData" />

@section Scripts {
    <script>
        document.getElementById('donorTableSearch')?.addEventListener('keyup', function() {
            var filter = this.value.toLowerCase();
            var rows = document.querySelectorAll('#donorTable tbody tr');
            rows.forEach(function(row) {
                var text = row.textContent.toLowerCase();
                row.style.display = text.includes(filter) ? '' : 'none';
            });
        });
    </script>
}
