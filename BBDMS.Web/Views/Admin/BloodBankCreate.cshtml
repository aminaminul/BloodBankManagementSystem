@model BBDMS.Model.Models.Entities.BloodBank
@{
    ViewData["Title"] = "Add Blood Bank";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card-modern p-4">
            <div class="mb-4 pb-3 border-bottom d-flex align-items-center justify-content-between">
                <div>
                    <h4 class="mb-1 fw-bold text-dark"><i class="fas fa-landmark me-2 text-danger"></i>Register New Blood Bank</h4>
                    <p class="text-muted small mb-0">Add blood storage facility details, affiliations, and stock</p>
                </div>
                <a asp-action="BloodBanks" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                    <i class="fas fa-arrow-left me-1"></i>Back
                </a>
            </div>

            <form method="post" asp-action="BloodBankCreate">
                @Html.AntiForgeryToken()

                <div class="row g-3 mb-3">
                    <div class="col-md-8">
                        <label asp-for="Name" class="form-label fw-semibold">Blood Bank Name <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control form-control-modern" required placeholder="e.g. Central Blood Bank" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="City" class="form-label fw-semibold">City <span class="text-danger">*</span></label>
                        <input asp-for="City" class="form-control form-control-modern" required placeholder="e.g. Dhaka" />
                        <span asp-validation-for="City" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="HospitalAffiliation" class="form-label fw-semibold">Hospital Affiliation / Society</label>
                        <input asp-for="HospitalAffiliation" class="form-control form-control-modern" placeholder="e.g. Red Crescent Society" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ContactNumber" class="form-label fw-semibold">Contact Helpline <span class="text-danger">*</span></label>
                        <input asp-for="ContactNumber" class="form-control form-control-modern" required placeholder="01XXXXXXXXX" />
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Address" class="form-label fw-semibold">Address</label>
                    <input asp-for="Address" class="form-control form-control-modern" placeholder="Building, road, area..." />
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="OperatingHours" class="form-label fw-semibold">Operating Hours</label>
                        <input asp-for="OperatingHours" class="form-control form-control-modern" value="24/7" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="AvailableBloodGroups" class="form-label fw-semibold">Available Blood Groups</label>
                        <input asp-for="AvailableBloodGroups" class="form-control form-control-modern" value="A+, A-, B+, B-, O+, O-, AB+, AB-" />
                    </div>
                </div>

                <div class="text-end pt-2 border-top">
                    <a asp-action="BloodBanks" class="btn btn-outline-secondary me-2">Cancel</a>
                    <button type="submit" class="btn btn-brand-red px-4">Save Blood Bank</button>
                </div>
            </form>
        </div>
    </div>
</div>
