@model IEnumerable<BBDMS.Model.Models.Entities.OxygenService>
@{
    ViewData["Title"] = "Manage Oxygen Services";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h3 class="fw-bold text-dark mb-0">Emergency Medical Oxygen Services</h3>
        <p class="text-muted mb-0">Manage oxygen gas providers, cylinders, concentrators, and home delivery support</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <input type="text" id="oxygenTableSearch" class="form-control form-control-modern" placeholder="Search suppliers..." style="width: 240px;" />
        <a asp-action="OxygenCreate" class="btn btn-brand-red text-nowrap">
            <i class="fas fa-plus me-1"></i>Add Oxygen Supplier
        </a>
    </div>
</div>

<div class="card-modern p-0">
    <div class="table-responsive">
        <table class="table table-hover mb-0" id="oxygenTable">
            <thead style="background:#f8fafc;">
                <tr style="font-size:.78rem; text-transform:uppercase; color:#64748b; letter-spacing:.05em;">
                    <th class="ps-4">Provider Name</th>
                    <th>Location</th>
                    <th>Availability</th>
                    <th>Cylinder Capacities</th>
                    <th>Home Delivery</th>
                    <th>Contact Number</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr style="vertical-align:middle;">
                            <td class="ps-4">
                                <strong class="text-dark">@item.ProviderName</strong>
                                <div class="small text-muted">@item.Address</div>
                            </td>
                            <td><span class="badge-soft-primary">@item.Location</span></td>
                            <td>
                                @if (item.OxygenAvailability == "In Stock")
                                {
                                    <span class="badge-soft-success">In Stock</span>
                                }
                                else if (item.OxygenAvailability == "Limited")
                                {
                                    <span class="badge-soft-warning">Limited Stock</span>
                                }
                                else
                                {
                                    <span class="badge-soft-secondary">Out of Stock</span>
                                }
                            </td>
                            <td class="small">@item.CylinderCapacity</td>
                            <td>
                                @if (item.HomeDeliveryAvailable)
                                {
                                    <span class="badge-soft-success"><i class="fas fa-truck me-1"></i>Available</span>
                                }
                                else
                                {
                                    <span class="badge-soft-secondary">Pickup Only</span>
                                }
                            </td>
                            <td>
                                <a href="tel:@item.ContactNumber" class="text-dark fw-semibold small">
                                    <i class="fas fa-phone me-1 text-success"></i>@item.ContactNumber
                                </a>
                            </td>
                            <td class="text-end pe-4">
                                <a asp-action="OxygenEdit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-1" title="Edit">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <form asp-action="OxygenDelete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to remove this oxygen service?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="fas fa-lungs fa-2x mb-2 d-block text-success"></i>No oxygen suppliers added yet.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('oxygenTableSearch')?.addEventListener('keyup', function() {
            var filter = this.value.toLowerCase();
            document.querySelectorAll('#oxygenTable tbody tr').forEach(function(row) {
                row.style.display = row.textContent.toLowerCase().includes(filter) ? '' : 'none';
            });
        });
    </script>
}
