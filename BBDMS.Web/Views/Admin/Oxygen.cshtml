@model IEnumerable<BBDMS.Model.Models.Entities.OxygenService>
@{
    ViewData["Title"] = "Manage Oxygen Services";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="font-weight-bold text-dark mb-0">Emergency Medical Oxygen Services</h3>
        <p class="text-muted mb-0">Manage oxygen gas providers, cylinders, concentrators, and home delivery support</p>
    </div>
    <div class="d-flex align-items-center">
        <input type="text" id="oxygenTableSearch" class="form-control mr-3" placeholder="Search suppliers..." style="width: 250px;" />
        <a asp-action="OxygenCreate" class="btn btn-info font-weight-bold text-white text-nowrap">
            <i class="fas fa-plus mr-1"></i>Add Oxygen Supplier
        </a>
    </div>
</div>

<div class="card content-card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0" id="oxygenTable">
                <thead class="thead-light">
                    <tr>
                        <th>Provider Name</th>
                        <th>Location</th>
                        <th>Availability</th>
                        <th>Cylinder Capacities</th>
                        <th>Home Delivery</th>
                        <th>Contact Number</th>
                        <th class="text-right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@item.ProviderName</strong>
                                    <div class="small text-muted">@item.Address</div>
                                </td>
                                <td><span class="badge badge-light border">@item.Location</span></td>
                                <td>
                                    @if (item.OxygenAvailability == "In Stock")
                                    {
                                        <span class="badge badge-success px-2 py-1">In Stock</span>
                                    }
                                    else if (item.OxygenAvailability == "Limited")
                                    {
                                        <span class="badge badge-warning text-dark px-2 py-1">Limited Stock</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-secondary px-2 py-1">Out of Stock</span>
                                    }
                                </td>
                                <td class="small">@item.CylinderCapacity</td>
                                <td>
                                    @if (item.HomeDeliveryAvailable)
                                    {
                                        <span class="badge badge-success"><i class="fas fa-check mr-1"></i>Available</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-secondary">Pickup Only</span>
                                    }
                                </td>
                                <td><i class="fas fa-phone mr-1 text-info"></i>@item.ContactNumber</td>
                                <td class="text-right">
                                    <a asp-action="OxygenEdit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary mr-1">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <form asp-action="OxygenDelete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to remove this oxygen service?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">No oxygen suppliers added yet.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('oxygenTableSearch')?.addEventListener('keyup', function() {
            var filter = this.value.toLowerCase();
            var rows = document.querySelectorAll('#oxygenTable tbody tr');
            rows.forEach(function(row) {
                var text = row.textContent.toLowerCase();
                row.style.display = text.includes(filter) ? '' : 'none';
            });
        });
    </script>
}
