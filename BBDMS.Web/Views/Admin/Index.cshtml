@{
    ViewData["Title"] = "Administrator Login - Blood Bank";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/bootstrap.css" />
    <link rel="stylesheet" href="~/css/modern-theme.css" />
    <link rel="stylesheet" href="~/css/fontawesome-all.css">
    <link href="//fonts.googleapis.com/css?family=Open+Sans:400,600,700,800" rel="stylesheet">
</head>
<body style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); min-height: 100vh; display: flex; align-items: center;">
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-5 col-lg-4">
                <div class="card border-0 shadow-lg" style="border-radius: 20px; overflow: hidden;">
                    <div class="card-header bg-white text-center py-4 border-bottom-0">
                        <img src="~/images/Logo.png" alt="Logo" style="height: 52px; width: auto;" class="mb-2" />
                        <h4 class="font-weight-bold text-dark mb-0">Admin <span style="color: var(--brand-red);">Portal</span></h4>
                        <small class="text-muted">Blood Bank & Emergency Help System</small>
                    </div>
                    <div class="card-body p-4 pt-0">
                        @if (TempData["Error"] != null)
                        {
                            <div class="alert alert-danger py-2 small" role="alert">
                                <i class="fas fa-exclamation-triangle mr-1"></i> @TempData["Error"]
                            </div>
                        }

                        <form asp-action="Index" method="post">
                            @Html.AntiForgeryToken()
                            <div class="form-group mb-3">
                                <label class="font-weight-bold small text-dark">Administrator Username</label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text bg-light border-right-0" style="border-radius: 10px 0 0 10px;">
                                            <i class="fas fa-user-shield text-muted"></i>
                                        </span>
                                    </div>
                                    <input type="text" name="username" class="form-control form-control-modern border-left-0" style="border-radius: 0 10px 10px 0;" required placeholder="Username" />
                                </div>
                            </div>

                            <div class="form-group mb-4">
                                <label class="font-weight-bold small text-dark">Password</label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text bg-light border-right-0" style="border-radius: 10px 0 0 10px;">
                                            <i class="fas fa-lock text-muted"></i>
                                        </span>
                                    </div>
                                    <input type="password" name="password" class="form-control form-control-modern border-left-0" style="border-radius: 0 10px 10px 0;" required placeholder="Password" />
                                </div>
                            </div>

                            <button type="submit" class="btn btn-brand-red btn-block py-2 font-weight-bold shadow">
                                <i class="fas fa-sign-in-alt mr-1"></i> Access Dashboard
                            </button>
                        </form>
                    </div>
                    <div class="card-footer bg-light text-center py-3 border-top-0">
                        <a asp-controller="Home" asp-action="Index" class="small text-muted font-weight-bold">
                            <i class="fas fa-arrow-left mr-1"></i> Back to Public Website
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
