@model IEnumerable<BBDMS.Model.Models.Entities.AmbulanceRequest>
@{
    ViewData["Title"] = "Emergency Ambulance Dispatch Requests";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="font-weight-bold text-dark mb-0">Emergency Ambulance Dispatch Requests</h3>
        <p class="text-muted mb-0">Track and dispatch emergency ambulance bookings in real-time</p>
    </div>
    <a asp-action="Ambulances" class="btn btn-outline-dark">
        <i class="fas fa-ambulance mr-1"></i>View Ambulance Fleets
    </a>
</div>

<div class="card content-card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="thead-light">
                    <tr>
                        <th>Patient Name</th>
                        <th>Emergency Contact</th>
                        <th>Pickup Address</th>
                        <th>Destination Hospital</th>
                        <th>Required Type</th>
                        <th>Urgency</th>
                        <th>Date & Time</th>
                        <th>Status</th>
                        <th class="text-right">Update Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@item.PatientName</strong>
                                    @if (!string.IsNullOrEmpty(item.Notes))
                                    {
                                        <div class="small text-muted" title="@item.Notes"><i class="fas fa-notes-medical mr-1"></i>@item.Notes</div>
                                    }
                                </td>
                                <td>
                                    <a href="tel:@item.ContactNumber" class="text-success font-weight-bold">
                                        <i class="fas fa-phone mr-1"></i>@item.ContactNumber
                                    </a>
                                </td>
                                <td style="max-width: 250px;"><small>@item.PickupAddress</small></td>
                                <td>@(string.IsNullOrEmpty(item.DestinationHospital) ? "Not Specified" : item.DestinationHospital)</td>
                                <td><span class="badge badge-info">@item.AmbulanceType</span></td>
                                <td>
                                    <span class="badge @(item.Urgency.Contains("Emergency") ? "badge-danger" : "badge-warning")">
                                        @item.Urgency
                                    </span>
                                </td>
                                <td class="small text-muted">@item.RequestDate.ToString("MMM dd, yyyy - hh:mm tt")</td>
                                <td>
                                    @if (item.Status == "Dispatched")
                                    {
                                        <span class="badge badge-warning text-dark font-weight-bold px-2 py-1"><i class="fas fa-shipping-fast mr-1"></i>Dispatched</span>
                                    }
                                    else if (item.Status == "Completed")
                                    {
                                        <span class="badge badge-success px-2 py-1"><i class="fas fa-check mr-1"></i>Completed</span>
                                    }
                                    else if (item.Status == "Cancelled")
                                    {
                                        <span class="badge badge-secondary px-2 py-1">Cancelled</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-danger px-2 py-1"><i class="fas fa-clock mr-1"></i>Pending</span>
                                    }
                                </td>
                                <td class="text-right">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="UpdateAmbulanceRequestStatus" asp-route-id="@item.Id" asp-route-status="Dispatched" class="btn btn-outline-warning" title="Mark Dispatched">
                                            <i class="fas fa-paper-plane"></i>
                                        </a>
                                        <a asp-action="UpdateAmbulanceRequestStatus" asp-route-id="@item.Id" asp-route-status="Completed" class="btn btn-outline-success" title="Mark Completed">
                                            <i class="fas fa-check"></i>
                                        </a>
                                        <a asp-action="UpdateAmbulanceRequestStatus" asp-route-id="@item.Id" asp-route-status="Cancelled" class="btn btn-outline-secondary" title="Cancel Request">
                                            <i class="fas fa-times"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center py-4 text-muted">No ambulance dispatch requests submitted yet.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
