@model IEnumerable<BBDMS.Model.Models.Entities.AmbulanceRequest>
@{
    ViewData["Title"] = "Emergency Ambulance Dispatch Requests";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h3 class="fw-bold text-dark mb-0">Emergency Ambulance Dispatch Requests</h3>
        <p class="text-muted mb-0">Track and dispatch emergency ambulance bookings in real-time</p>
    </div>
    <a asp-action="Ambulances" class="btn btn-brand-outline">
        <i class="fas fa-ambulance me-1"></i>View Ambulance Fleets
    </a>
</div>

<div class="card-modern p-0">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead style="background:#f8fafc;">
                <tr style="font-size:.78rem; text-transform:uppercase; color:#64748b; letter-spacing:.05em;">
                    <th class="ps-4">Patient Name</th>
                    <th>Emergency Contact</th>
                    <th>Pickup Address</th>
                    <th>Destination Hospital</th>
                    <th>Type</th>
                    <th>Urgency</th>
                    <th>Date &amp; Time</th>
                    <th>Status</th>
                    <th class="text-end pe-4">Update Status</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr style="vertical-align:middle;">
                            <td class="ps-4">
                                <strong class="text-dark">@item.PatientName</strong>
                                @if (!string.IsNullOrEmpty(item.Notes))
                                {
                                    <div class="small text-muted" title="@item.Notes"><i class="fas fa-notes-medical me-1 text-danger"></i>@item.Notes</div>
                                }
                            </td>
                            <td>
                                <a href="tel:@item.ContactNumber" class="text-success fw-bold small">
                                    <i class="fas fa-phone me-1"></i>@item.ContactNumber
                                </a>
                            </td>
                            <td style="max-width: 200px;"><small class="text-muted">@item.PickupAddress</small></td>
                            <td>@(string.IsNullOrEmpty(item.DestinationHospital) ? "Not Specified" : item.DestinationHospital)</td>
                            <td><span class="badge-soft-primary">@item.AmbulanceType</span></td>
                            <td>
                                <span class="badge @(item.Urgency.Contains("Emergency") ? "badge-soft-danger" : "badge-soft-warning")">
                                    @item.Urgency
                                </span>
                            </td>
                            <td class="small text-muted">@item.RequestDate.ToString("MMM dd, yyyy - hh:mm tt")</td>
                            <td>
                                @if (item.Status == "Dispatched")
                                {
                                    <span class="badge-soft-warning fw-bold"><i class="fas fa-shipping-fast me-1"></i>Dispatched</span>
                                }
                                else if (item.Status == "Completed")
                                {
                                    <span class="badge-soft-success"><i class="fas fa-check me-1"></i>Completed</span>
                                }
                                else if (item.Status == "Cancelled")
                                {
                                    <span class="badge-soft-secondary">Cancelled</span>
                                }
                                else
                                {
                                    <span class="badge-soft-danger"><i class="fas fa-clock me-1"></i>Pending</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="UpdateAmbulanceRequestStatus" asp-route-id="@item.Id" asp-route-status="Dispatched" class="btn btn-outline-warning" title="Mark Dispatched">
                                        <i class="fas fa-paper-plane"></i>
                                    </a>
                                    <a asp-action="UpdateAmbulanceRequestStatus" asp-route-id="@item.Id" asp-route-status="Completed" class="btn btn-outline-success" title="Mark Completed">
                                        <i class="fas fa-check"></i>
                                    </a>
                                    <a asp-action="UpdateAmbulanceRequestStatus" asp-route-id="@item.Id" asp-route-status="Cancelled" class="btn btn-outline-secondary" title="Cancel Request">
                                        <i class="fas fa-times"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-center py-5 text-muted">
                            <i class="fas fa-bell fa-2x mb-2 d-block text-warning"></i>No ambulance dispatch requests submitted yet.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
