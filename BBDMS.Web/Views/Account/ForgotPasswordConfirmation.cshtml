@{
    ViewData["Title"] = "Password Reset Request Received - Blood Bank";
}

<div class="container auth-split-container">
    <div class="w-100 auth-split-wrapper">
        <div class="row no-gutters">
            <!-- Left Visual Side -->
            <div class="col-lg-5 d-none d-lg-block">
                <div class="auth-banner-side">
                    <div>
                        <div class="d-flex align-items-center mb-4">
                            <img src="~/images/Logo.png" alt="Blood Bank Logo" style="height: 44px; filter: brightness(0) invert(1);" />
                            <h4 class="text-white font-weight-bold ml-2 mb-0">Blood Bank</h4>
                        </div>
                        <h2 class="text-white font-weight-bold display-4 mb-3" style="font-size: 2.2rem; line-height: 1.2;">
                            Check Your Inbox
                        </h2>
                        <p class="text-white-50 lead" style="font-size: 1.05rem;">
                            Security is our priority. Reset links are cryptographic, single-use, and expire automatically after 2 hours.
                        </p>
                    </div>

                    <div class="pt-4 border-top border-light" style="border-color: rgba(255,255,255,0.2) !important;">
                        <small class="text-white-50 d-block mb-1">Didn't receive an email?</small>
                        <span class="font-weight-bold text-white"><i class="fas fa-question-circle mr-1"></i> Check your spam/junk folder or contact support.</span>
                    </div>
                </div>
            </div>

            <!-- Right Confirmation Side -->
            <div class="col-lg-7">
                <div class="auth-form-side text-center">
                    <div class="mb-4">
                        <div class="d-inline-flex align-items-center justify-content-center bg-success text-white rounded-circle shadow" style="width: 72px; height: 72px; font-size: 2rem;">
                            <i class="fas fa-envelope-open-text"></i>
                        </div>
                    </div>

                    <h3 class="font-weight-bold mb-2">Request Processed</h3>
                    <p class="text-muted mb-4">
                        If an active donor account is registered under <strong>@(ViewBag.Email ?? "your email")</strong>, instructions and a secure reset token have been generated.
                    </p>

                    @if (ViewBag.ResetLink != null)
                    {
                        <div class="card border-primary mb-4 text-left shadow-sm bg-light">
                            <div class="card-body">
                                <h6 class="font-weight-bold text-primary mb-2">
                                    <i class="fas fa-terminal mr-1"></i> Development Environment Reset Link
                                </h6>
                                <p class="small text-muted mb-2">
                                    Since outbound SMTP email dispatching is set to local dev simulation, click the button below or copy the direct reset link to proceed with your password reset:
                                </p>
                                <div class="input-group mb-3">
                                    <input type="text" class="form-control form-control-sm font-monospace" id="devResetLinkInput" value="@ViewBag.ResetLink" readonly />
                                    <div class="input-group-append">
                                        <button class="btn btn-outline-primary btn-sm" type="button" onclick="navigator.clipboard.writeText(document.getElementById('devResetLinkInput').value); this.innerText='Copied!';">
                                            <i class="fas fa-copy"></i> Copy
                                        </button>
                                    </div>
                                </div>
                                <a href="@ViewBag.ResetLink" class="btn btn-primary btn-sm btn-block font-weight-bold">
                                    <i class="fas fa-key mr-1"></i> Proceed to Reset Password
                                </a>
                            </div>
                        </div>
                    }

                    <div class="alert alert-light border text-muted small text-left mb-4">
                        <ul class="mb-0 pl-3">
                            <li>The password reset link is valid for <strong>2 hours</strong>.</li>
                            <li>For security reasons, this token will be invalidated once used.</li>
                            <li>If you did not request this change, you can safely ignore this notice.</li>
                        </ul>
                    </div>

                    <div class="pt-2">
                        <a asp-action="Login" class="btn btn-outline-secondary px-4 font-weight-bold">
                            <i class="fas fa-arrow-left mr-1"></i> Return to Login
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
