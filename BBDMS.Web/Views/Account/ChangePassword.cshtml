@{
    ViewData["Title"] = "Change Password";
}

<section class="page-hero-sm" style="background:linear-gradient(135deg,#e63946 0%,#9b1a26 100%); color:#fff; padding:56px 0 40px;">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-2" style="background:transparent; padding:0;">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-white-50">Home</a></li>
                <li class="breadcrumb-item"><a asp-controller="Account" asp-action="Profile" class="text-white-50">Account</a></li>
                <li class="breadcrumb-item active text-white" aria-current="page">Change Password</li>
            </ol>
        </nav>
        <h1 class="fw-bold mb-1" style="font-size:2rem;">Change Password</h1>
        <p class="mb-0 text-white-50">Secure your donor account by updating your credentials.</p>
    </div>
</section>

<section class="py-5" style="background:#f8fafc;">
    <div class="container py-2">
        <div class="row justify-content-center">
            <div class="col-md-7 col-lg-5">
                <div class="card-modern p-4 p-md-5">
                    <div class="text-center mb-4">
                        <div class="service-icon-box mx-auto mb-3" style="width:54px; height:54px; font-size:1.2rem;">
                            <i class="fas fa-lock"></i>
                        </div>
                        <h4 class="fw-bold text-dark mb-1">Update Security</h4>
                        <p class="text-muted small">Choose a strong, unique password for your account</p>
                    </div>

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form asp-action="ChangePassword" method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Current Password</label>
                            <input type="password" class="form-control form-control-modern" name="currentPassword" required placeholder="Enter existing password">
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-semibold">New Password</label>
                            <input type="password" class="form-control form-control-modern" name="newPassword" required minlength="6" placeholder="At least 6 characters">
                        </div>
                        <button type="submit" class="btn btn-brand-red w-100 py-2">
                            <i class="fas fa-key me-2"></i>Update Password
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
