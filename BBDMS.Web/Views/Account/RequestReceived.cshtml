@model IEnumerable<BBDMS.Model.Models.Entities.BloodRequest>
@{
    ViewData["Title"] = "Requests Received";
    var communityRequests = ViewBag.CommunityRequests as IEnumerable<BBDMS.Model.Models.Entities.BloodRequest>;
    var donorBloodGroup = ViewBag.DonorBloodGroup as string;
}

<div class="inner-banner-w3ls">
    <div class="container"></div>
</div>
<div class="breadcrumb-agile">
    <div aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-controller="Home" asp-action="Index">Home</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">Requests Received</li>
        </ol>
    </div>
</div>

<div class="agileits-contact py-5">
    <div class="py-xl-5 py-lg-3">
        <div class="w3ls-titles text-center mb-5">
            <h3 class="title">Blood Requests Received</h3>
            <span><i class="fas fa-user-md"></i></span>
        </div>

        <div class="container">

            <!-- Direct Requests (addressed to this donor) -->
            <h5 class="font-weight-bold text-danger mb-3">
                <i class="fas fa-envelope mr-1"></i> Requests Addressed Directly to You
            </h5>
            <table class="table table-bordered table-striped mb-5">
                <thead class="thead-dark">
                    <tr>
                        <th>Requester Name</th>
                        <th>Mobile Number</th>
                        <th>Email</th>
                        <th>Blood Required For</th>
                        <th>Message</th>
                        <th>Apply Date</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var request in Model)
                        {
                            <tr>
                                <td>@request.Name</td>
                                <td>@request.ContactNumber</td>
                                <td>@request.EmailId</td>
                                <td>@request.BloodRequireFor</td>
                                <td>@request.Message</td>
                                <td>@request.ApplyDate?.ToString("yyyy-MM-dd")</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(request.Status))
                                    {
                                        <span class="badge @(request.Status == "Pending" ? "badge-warning" : request.Status == "Fulfilled" ? "badge-success" : "badge-secondary")">
                                            @request.Status
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted">No direct blood requests received yet.</td>
                        </tr>
                    }
                </tbody>
            </table>

            <!-- Community Requests matching donor's blood group -->
            @if (!string.IsNullOrEmpty(donorBloodGroup))
            {
                <h5 class="font-weight-bold text-primary mb-3">
                    <i class="fas fa-users mr-1"></i> Community Requests for Blood Group: <span class="badge badge-danger">@donorBloodGroup</span>
                </h5>
                <p class="text-muted small mb-3">These are open requests from patients who need your blood group. You can reach out to them directly.</p>
                <table class="table table-bordered table-hover mb-5">
                    <thead class="thead-light">
                        <tr>
                            <th>Patient Name</th>
                            <th>Blood Group</th>
                            <th>Hospital</th>
                            <th>Location</th>
                            <th>Contact</th>
                            <th>Urgency</th>
                            <th>Units Needed</th>
                            <th>Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (communityRequests != null && communityRequests.Any())
                        {
                            foreach (var req in communityRequests)
                            {
                                <tr>
                                    <td>@req.Name</td>
                                    <td><span class="badge badge-danger">@(req.BloodGroup ?? req.BloodRequireFor)</span></td>
                                    <td>@(req.HospitalName ?? "—")</td>
                                    <td>@(req.Location ?? "—")</td>
                                    <td>@req.ContactNumber</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(req.Urgency))
                                        {
                                            <span class="badge @(req.Urgency == "Critical" ? "badge-danger" : req.Urgency == "Urgent" ? "badge-warning" : "badge-info")">
                                                @req.Urgency
                                            </span>
                                        }
                                    </td>
                                    <td>@(req.UnitsRequired > 0 ? req.UnitsRequired.ToString() : "—")</td>
                                    <td>@req.ApplyDate?.ToString("yyyy-MM-dd")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted">No community requests found for your blood group right now.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

        </div>
    </div>
</div>
