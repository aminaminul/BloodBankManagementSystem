@model IEnumerable<BBDMS.Model.Models.Entities.BloodRequest>
@{
    ViewData["Title"] = "Requests Received";
    var communityRequests = ViewBag.CommunityRequests as IEnumerable<BBDMS.Model.Models.Entities.BloodRequest>;
    var donorBloodGroup = ViewBag.DonorBloodGroup as string;
}

<section class="page-hero-sm" style="background:linear-gradient(135deg,#e63946 0%,#9b1a26 100%); color:#fff; padding:56px 0 40px;">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-2" style="background:transparent; padding:0;">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-white-50">Home</a></li>
                <li class="breadcrumb-item"><a asp-controller="Account" asp-action="Profile" class="text-white-50">Account</a></li>
                <li class="breadcrumb-item active text-white" aria-current="page">Requests Received</li>
            </ol>
        </nav>
        <h1 class="fw-bold mb-1" style="font-size:2rem;">Blood Requests Inbox</h1>
        <p class="mb-0 text-white-50">Review direct patient requests and regional matches for your blood group.</p>
    </div>
</section>

<section class="py-5" style="background:#f8fafc;">
    <div class="container py-2">

        <!-- Direct Requests -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h4 class="fw-bold text-dark mb-0">
                    <i class="fas fa-inbox me-2 text-danger"></i>Requests Addressed Directly to You
                </h4>
                <p class="text-muted small mb-0">Patients or hospitals who directly selected your profile</p>
            </div>
        </div>

        <div class="card-modern p-0 mb-5">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead style="background:#f8fafc;">
                        <tr style="font-size:.78rem; text-transform:uppercase; color:#64748b; letter-spacing:.05em;">
                            <th class="ps-4">Requester Name</th>
                            <th>Mobile Number</th>
                            <th>Email</th>
                            <th>Requirement</th>
                            <th>Message</th>
                            <th>Date</th>
                            <th class="text-end pe-4">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var request in Model)
                            {
                                <tr style="vertical-align:middle;">
                                    <td class="ps-4"><strong class="text-dark">@request.Name</strong></td>
                                    <td>
                                        <a href="tel:@request.ContactNumber" class="text-dark fw-semibold small">
                                            <i class="fas fa-phone me-1 text-success"></i>@request.ContactNumber
                                        </a>
                                    </td>
                                    <td><a href="mailto:@request.EmailId" class="text-primary small">@request.EmailId</a></td>
                                    <td><span class="badge-soft-danger">@request.BloodRequireFor</span></td>
                                    <td style="max-width: 250px;"><small class="text-muted">@request.Message</small></td>
                                    <td class="small text-muted">@request.ApplyDate?.ToString("MMM dd, yyyy")</td>
                                    <td class="text-end pe-4">
                                        @if (!string.IsNullOrEmpty(request.Status))
                                        {
                                            <span class="badge @(request.Status == "Pending" ? "badge-soft-warning" : request.Status == "Fulfilled" ? "badge-soft-success" : "badge-soft-secondary")">
                                                @request.Status
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="fas fa-envelope-open fa-2x mb-2 d-block text-secondary"></i>No direct blood requests received yet.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Community Requests matching donor's blood group -->
        @if (!string.IsNullOrEmpty(donorBloodGroup))
        {
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h4 class="fw-bold text-dark mb-0">
                        <i class="fas fa-users me-2 text-primary"></i>Community Requests Matching <span class="badge-soft-danger px-2">@donorBloodGroup</span>
                    </h4>
                    <p class="text-muted small mb-0">Open emergency requests needing your blood group across local hospitals</p>
                </div>
            </div>

            <div class="card-modern p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead style="background:#f8fafc;">
                            <tr style="font-size:.78rem; text-transform:uppercase; color:#64748b; letter-spacing:.05em;">
                                <th class="ps-4">Patient / Requester</th>
                                <th>Blood Group</th>
                                <th>Hospital</th>
                                <th>Location</th>
                                <th>Contact</th>
                                <th>Urgency</th>
                                <th>Units</th>
                                <th class="text-end pe-4">Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (communityRequests != null && communityRequests.Any())
                            {
                                foreach (var req in communityRequests)
                                {
                                    <tr style="vertical-align:middle;">
                                        <td class="ps-4"><strong class="text-dark">@req.Name</strong></td>
                                        <td><span class="badge-soft-danger fw-bold">@(req.BloodGroup ?? req.BloodRequireFor)</span></td>
                                        <td><div class="small fw-semibold text-dark">@(req.HospitalName ?? "—")</div></td>
                                        <td><div class="small text-muted"><i class="fas fa-map-marker-alt text-danger me-1"></i>@(req.Location ?? "—")</div></td>
                                        <td>
                                            <a href="tel:@req.ContactNumber" class="text-dark fw-semibold small">
                                                <i class="fas fa-phone me-1 text-success"></i>@req.ContactNumber
                                            </a>
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(req.Urgency))
                                            {
                                                <span class="badge @(req.Urgency == "Critical" ? "badge-soft-danger" : req.Urgency == "Urgent" ? "badge-soft-warning" : "badge-soft-primary")">
                                                    @req.Urgency
                                                </span>
                                            }
                                        </td>
                                        <td>
                                            <span class="badge-soft-primary">@(req.UnitsRequired > 0 ? req.UnitsRequired.ToString() + " Unit(s)" : "—")</span>
                                        </td>
                                        <td class="text-end pe-4 small text-muted">@req.ApplyDate?.ToString("MMM dd, yyyy")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="8" class="text-center py-5 text-muted">
                                        <i class="fas fa-check-circle fa-2x mb-2 d-block text-success"></i>No community requests open for your blood group right now.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

    </div>
</section>
