@model BBDMS.Model.Models.ViewModels.DonorRegisterViewModel?
@{
    ViewData["Title"] = "Register as a donor";
    var bloodGroups = ViewBag.BloodGroups as IEnumerable<BBDMS.Model.Models.Entities.BloodGroup>;
}

<div class="container auth-split-container">
    <div class="auth-split-wrapper w-100">
        <div class="row no-gutters">
            <div class="col-lg-5 d-none d-lg-block">
                <div class="auth-banner-side">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-4">
                            <img src="~/images/Logo.png" alt="" height="40" style="filter:brightness(0) invert(1);opacity:.95" />
                            <span class="brand-word" style="color:#fbf6ef">BloodBank<em style="color:#ff9aa7">.</em></span>
                        </div>
                        <p class="eyebrow" style="color:rgba(255,246,238,.55)">Donor registration</p>
                        <h2>Be a donor.<br />Be <em>someone's reason.</em></h2>
                        <p style="margin-top:12px;max-width:34ch">
                            Register once. We only contact you when a patient with a compatible group needs you.
                        </p>
                        <ul class="auth-points">
                            <li><i class="fas fa-check" aria-hidden="true"></i><span>Verified donor profile and digital donor card</span></li>
                            <li><i class="fas fa-check" aria-hidden="true"></i><span>90-day eligibility tracking after each donation</span></li>
                            <li><i class="fas fa-check" aria-hidden="true"></i><span>Your contact details stay hidden from the public</span></li>
                        </ul>
                    </div>
                    <div style="border-top:1px solid rgba(255,246,238,.16);padding-top:16px" class="d-flex align-items-center gap-2">
                        <i class="fas fa-shield-halved" aria-hidden="true" style="color:#ff9aa7"></i>
                        <span style="font-size:.82rem;color:rgba(255,246,238,.66)">Contact information is used strictly for emergency blood matches.</span>
                    </div>
                </div>
            </div>

            <div class="col-lg-7">
                <div class="auth-form-side">
                    <a class="auth-brand-logo d-lg-none" asp-controller="Home" asp-action="Index">
                        <img src="~/images/Logo.png" alt="" height="32" />
                        <span>BloodBank<em class="text-danger" style="font-style:normal">.</em></span>
                    </a>

                    <p class="eyebrow">Join the network</p>
                    <h3>Create your donor account</h3>
                    <p>Tell us your blood group and city so we can match you with nearby needs.</p>

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger mb-4" role="alert">
                            <i class="fas fa-circle-exclamation" aria-hidden="true"></i>@TempData["Error"]
                        </div>
                    }

                    <form asp-action="Register" method="post">
                        @Html.AntiForgeryToken()
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label for="rName">Full name</label>
                                <input id="rName" type="text" class="form-control" name="FullName" value="@Model?.FullName" required placeholder="Your full name" autocomplete="name" />
                            </div>
                            <div class="col-md-6">
                                <label for="rPhone">Mobile number</label>
                                <input id="rPhone" type="tel" class="form-control" name="MobileNumber" value="@Model?.MobileNumber" required placeholder="01XXXXXXXXX" maxlength="15" autocomplete="tel" />
                            </div>
                            <div class="col-md-6">
                                <label for="rEmail">Email address</label>
                                <input id="rEmail" type="email" class="form-control" name="EmailId" value="@Model?.EmailId" required placeholder="name@example.com" autocomplete="email" />
                            </div>
                            <div class="col-md-3">
                                <label for="rAge">Age</label>
                                <input id="rAge" type="number" min="18" max="65" class="form-control" name="Age" value="@Model?.Age" required placeholder="25" />
                            </div>
                            <div class="col-md-3">
                                <label for="rGender">Gender</label>
                                <select id="rGender" name="Gender" class="form-select" required>
                                    <option value="">Select</option>
                                    <option value="Male" selected="@(Model?.Gender == "Male")">Male</option>
                                    <option value="Female" selected="@(Model?.Gender == "Female")">Female</option>
                                    <option value="Other" selected="@(Model?.Gender == "Other")">Other</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label for="rGroup">Blood group</label>
                                <select id="rGroup" name="BloodGroup" class="form-select" required>
                                    <option value="">Select group</option>
                                    @if (bloodGroups != null)
                                    {
                                        foreach (var bg in bloodGroups)
                                        {
                                            <option value="@bg.GroupName" selected="@(Model?.BloodGroup == bg.GroupName)">@bg.GroupName</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-md-8">
                                <label for="rAddress">City / area</label>
                                <input id="rAddress" type="text" class="form-control" name="Address" value="@Model?.Address" required placeholder="Area, city — e.g. Dhanmondi, Dhaka" autocomplete="address-level2" />
                            </div>
                            <div class="col-12">
                                <label for="rMessage">Note for coordinators <span style="text-transform:none;letter-spacing:0;color:var(--soft)">(optional)</span></label>
                                <input id="rMessage" type="text" class="form-control" name="Message" value="@Model?.Message" placeholder="e.g. available on weekends, can travel within the city" />
                            </div>
                            <div class="col-md-6">
                                <label for="rPassword">Create password</label>
                                <input id="rPassword" type="password" class="form-control" name="Password" required minlength="8" placeholder="At least 8 characters" autocomplete="new-password" />
                            </div>
                            <div class="col-12">
                                <div class="form-check mt-2">
                                    <input class="form-check-input" type="checkbox" id="termsAgree" required checked />
                                    <label class="form-check-label" for="termsAgree">
                                        I agree to be contacted for emergency blood donations and accept the
                                        <a asp-controller="Home" asp-action="Privacy" style="color:var(--blood);text-decoration:underline">privacy policy</a>.
                                    </label>
                                </div>
                            </div>
                            <div class="col-12">
                                <button type="submit" class="btn btn-blood btn-lg btn-block mt-2">
                                    <i class="fas fa-heart" aria-hidden="true"></i> Create donor account
                                </button>
                            </div>
                        </div>
                    </form>

                    <div class="auth-alt">
                        <span>Already registered?</span>
                        <a asp-action="Login">Sign in instead</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
