@{
    ViewData["Title"] = "Forgot Password - Blood Bank";
}

<div class="container auth-split-container">
    <div class="w-100 auth-split-wrapper">
        <div class="row no-gutters">
            <!-- Left Visual Side -->
            <div class="col-lg-5 d-none d-lg-block">
                <div class="auth-banner-side">
                    <div>
                        <div class="d-flex align-items-center mb-4">
                            <img src="~/images/Logo.png" alt="Blood Bank Logo" style="height: 44px; filter: brightness(0) invert(1);" />
                            <h4 class="text-white font-weight-bold ml-2 mb-0">Blood Bank</h4>
                        </div>
                        <h2 class="text-white font-weight-bold display-4 mb-3" style="font-size: 2.2rem; line-height: 1.2;">
                            Account Recovery
                        </h2>
                        <p class="text-white-50 lead" style="font-size: 1.05rem;">
                            Regain access to your donor account to manage donations, track critical requests, and continue saving lives.
                        </p>
                    </div>

                    <div class="pt-4 border-top border-light" style="border-color: rgba(255,255,255,0.2) !important;">
                        <small class="text-white-50 d-block mb-1">Need Immediate Assistance?</small>
                        <span class="font-weight-bold text-white"><i class="fas fa-headset mr-1"></i> Helpline: 999 / 01700000000</span>
                    </div>
                </div>
            </div>

            <!-- Right Form Side -->
            <div class="col-lg-7">
                <div class="auth-form-side">
                    <div class="d-flex align-items-center mb-3">
                        <img src="~/images/Logo.png" alt="Blood Bank Logo" style="height: 38px;" class="mr-2" />
                        <h4 class="font-weight-bold mb-0">Blood <span class="text-danger">Bank</span></h4>
                    </div>

                    <h3 class="font-weight-bold mb-1">Reset Your Password</h3>
                    <p class="text-muted small mb-4">Enter your registered email address and we'll provide instructions to reset your password.</p>

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="fas fa-exclamation-circle mr-1"></i> @TempData["Error"]
                            <button type="button" class="close" data-dismiss="alert">&times;</button>
                        </div>
                    }

                    <form asp-action="ForgotPassword" method="post">
                        @Html.AntiForgeryToken()
                        <div class="form-group mb-4">
                            <label class="font-weight-bold small text-dark">Registered Email Address</label>
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text bg-light border-right-0" style="border-radius: 10px 0 0 10px;">
                                        <i class="far fa-envelope text-muted"></i>
                                    </span>
                                </div>
                                <input type="email" class="form-control form-control-modern border-left-0" style="border-radius: 0 10px 10px 0;" name="email" required placeholder="name@example.com" />
                            </div>
                            <small class="form-text text-muted mt-2">
                                <i class="fas fa-info-circle text-info mr-1"></i> We'll generate a secure, single-use reset token valid for 2 hours.
                            </small>
                        </div>

                        <button type="submit" class="btn btn-brand-red btn-block py-2 font-weight-bold mb-3 shadow">
                            <i class="fas fa-paper-plane mr-1"></i> Send Reset Link
                        </button>

                        <div class="text-center pt-2">
                            <a asp-action="Login" class="text-muted font-weight-bold small">
                                <i class="fas fa-arrow-left mr-1"></i> Back to Login
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
