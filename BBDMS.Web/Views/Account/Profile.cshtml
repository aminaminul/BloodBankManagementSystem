@model BBDMS.Model.Models.Entities.BloodDonor
@{
    ViewData["Title"] = "My Donor Profile";
    var bloodGroups = ViewBag.BloodGroups as IEnumerable<BBDMS.Model.Models.Entities.BloodGroup>;
}

<section class="page-hero-sm" style="background:linear-gradient(135deg,#e63946 0%,#9b1a26 100%); color:#fff; padding:56px 0 40px;">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-2" style="background:transparent; padding:0;">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-white-50">Home</a></li>
                <li class="breadcrumb-item active text-white" aria-current="page">My Profile</li>
            </ol>
        </nav>
        <h1 class="fw-bold mb-1" style="font-size:2rem;">Donor Profile</h1>
        <p class="mb-0 text-white-50">Update your personal information and donation availability.</p>
    </div>
</section>

<section class="py-5" style="background:#f8fafc;">
    <div class="container py-2">
        <div class="row justify-content-center">
            <div class="col-lg-8 col-xl-7">

                @* Eligibility Banner *@
                @if (Model != null)
                {
                    <div class="alert @(Model.IsEligibleToDonate ? "alert-success" : "alert-warning") d-flex align-items-center mb-4" role="alert">
                        <i class="fas @(Model.IsEligibleToDonate ? "fa-check-circle" : "fa-clock") fa-lg me-3"></i>
                        <div>
                            <strong>Eligibility Status:</strong>
                            @(Model.IsEligibleToDonate
                                ? "You are medically eligible to donate blood."
                                : $"You can donate again in {Model.DaysUntilEligible} day(s). Minimum 90-day gap required.")
                        </div>
                    </div>
                }

                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                <div class="card-modern">
                    <h5 class="fw-bold mb-4"><i class="fas fa-user-edit me-2 text-danger"></i>Update Profile Details</h5>

                    <form asp-action="Profile" method="post">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Full Name <span class="text-danger">*</span></label>
                                <input type="text" class="form-control form-control-modern" name="FullName" value="@Model?.FullName" required placeholder="Your full name">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Mobile Number <span class="text-danger">*</span></label>
                                <input type="text" class="form-control form-control-modern" name="MobileNumber" value="@Model?.MobileNumber" required maxlength="11" placeholder="01XXXXXXXXX">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">
                                    Email Address
                                    <span class="text-muted small ms-1">(read-only)</span>
                                </label>
                                <input type="email" class="form-control form-control-modern" value="@Model?.EmailId" readonly style="background:#f8fafc;">
                            </div>
                            <div class="col-md-3">
                                <label class="form-label fw-semibold">Age <span class="text-danger">*</span></label>
                                <input type="number" class="form-control form-control-modern" name="Age" value="@Model?.Age" required min="18" max="65">
                            </div>
                            <div class="col-md-3">
                                <label class="form-label fw-semibold">Gender <span class="text-danger">*</span></label>
                                <select name="Gender" class="form-select form-control-modern" required>
                                    <option value="Male" selected="@(Model?.Gender == "Male")">Male</option>
                                    <option value="Female" selected="@(Model?.Gender == "Female")">Female</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Blood Group <span class="text-danger">*</span></label>
                                <select name="BloodGroup" class="form-select form-control-modern" required>
                                    @if (bloodGroups != null)
                                    {
                                        foreach (var bg in bloodGroups)
                                        {
                                            <option value="@bg.GroupName" selected="@(Model?.BloodGroup == bg.GroupName)">@bg.GroupName</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Address <span class="text-danger">*</span></label>
                                <input type="text" class="form-control form-control-modern" name="Address" value="@Model?.Address" required placeholder="Your area / city">
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold">Last Blood Donation Date</label>
                                <input type="date" class="form-control form-control-modern" name="LastDonatedDate"
                                       value="@(Model?.LastDonatedDate?.ToString("yyyy-MM-dd"))" />
                                <div class="form-text text-muted">A minimum of 90 days is required between donations for medical safety.</div>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold">Donation Note / Message</label>
                                <textarea class="form-control form-control-modern" name="Message" rows="3" placeholder="Any notes for requesters...">@Model?.Message</textarea>
                            </div>
                            <div class="col-12">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="isAvailable" name="IsAvailable" value="true"
                                           @(Model?.IsAvailable == true ? "checked" : "") style="width:2.5em; height:1.4em;" />
                                    <label class="form-check-label fw-semibold ms-2" for="isAvailable">
                                        I am currently <span class="text-success">available</span> to donate blood
                                    </label>
                                </div>
                            </div>
                            <div class="col-12 mt-2">
                                <button type="submit" class="btn btn-brand-red px-5 py-2">
                                    <i class="fas fa-save me-2"></i>Update Profile
                                </button>
                            </div>
                        </div>
                    </form>
                </div>

            </div>
        </div>
    </div>
</section>
