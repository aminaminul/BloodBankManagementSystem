@{
    ViewData["Title"] = "Set New Password - Blood Bank";
}

<div class="container auth-split-container">
    <div class="w-100 auth-split-wrapper">
        <div class="row no-gutters">
            <!-- Left Visual Side -->
            <div class="col-lg-5 d-none d-lg-block">
                <div class="auth-banner-side">
                    <div>
                        <div class="d-flex align-items-center mb-4">
                            <img src="~/images/Logo.png" alt="Blood Bank Logo" style="height: 44px; filter: brightness(0) invert(1);" />
                            <h4 class="text-white font-weight-bold ml-2 mb-0">Blood Bank</h4>
                        </div>
                        <h2 class="text-white font-weight-bold display-4 mb-3" style="font-size: 2.2rem; line-height: 1.2;">
                            Secure Your Account
                        </h2>
                        <p class="text-white-50 lead" style="font-size: 1.05rem;">
                            Choose a strong, unique password to safeguard your donor profile and donation history.
                        </p>
                    </div>

                    <div class="pt-4 border-top border-light" style="border-color: rgba(255,255,255,0.2) !important;">
                        <small class="text-white-50 d-block mb-1">Password Recommendation</small>
                        <span class="text-white small">Use at least 8 characters with a mix of letters, numbers, and symbols.</span>
                    </div>
                </div>
            </div>

            <!-- Right Form Side -->
            <div class="col-lg-7">
                <div class="auth-form-side">
                    <div class="d-flex align-items-center mb-3">
                        <img src="~/images/Logo.png" alt="Blood Bank Logo" style="height: 38px;" class="mr-2" />
                        <h4 class="font-weight-bold mb-0">Blood <span class="text-danger">Bank</span></h4>
                    </div>

                    <h3 class="font-weight-bold mb-1">Set New Password</h3>
                    <p class="text-muted small mb-4">Please enter and confirm your new password below.</p>

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="fas fa-exclamation-circle mr-1"></i> @TempData["Error"]
                            <button type="button" class="close" data-dismiss="alert">&times;</button>
                        </div>
                    }

                    <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                    <form asp-action="ResetPassword" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="token" value="@ViewBag.Token" />

                        <div class="form-group mb-3">
                            <label class="font-weight-bold small text-dark">New Password</label>
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text bg-light border-right-0" style="border-radius: 10px 0 0 10px;">
                                        <i class="fas fa-lock text-muted"></i>
                                    </span>
                                </div>
                                <input type="password" class="form-control form-control-modern border-left-0" style="border-radius: 0 10px 10px 0;" name="newPassword" id="newPassword" required minlength="8" placeholder="At least 8 characters" />
                            </div>
                        </div>

                        <div class="form-group mb-4">
                            <label class="font-weight-bold small text-dark">Confirm New Password</label>
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text bg-light border-right-0" style="border-radius: 10px 0 0 10px;">
                                        <i class="fas fa-check-double text-muted"></i>
                                    </span>
                                </div>
                                <input type="password" class="form-control form-control-modern border-left-0" style="border-radius: 0 10px 10px 0;" name="confirmPassword" id="confirmPassword" required minlength="8" placeholder="Repeat your new password" />
                            </div>
                        </div>

                        <button type="submit" class="btn btn-brand-red btn-block py-2 font-weight-bold mb-3 shadow">
                            <i class="fas fa-save mr-1"></i> Update Password & Sign In
                        </button>

                        <div class="text-center pt-2">
                            <a asp-action="Login" class="text-muted font-weight-bold small">
                                <i class="fas fa-times mr-1"></i> Cancel & Return to Login
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
