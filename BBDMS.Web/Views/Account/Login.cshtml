@{
    ViewData["Title"] = "Sign in";
}

<div class="container auth-split-container">
    <div class="auth-split-wrapper w-100">
        <div class="row no-gutters">
            <div class="col-lg-6 d-none d-lg-block">
                <div class="auth-banner-side">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-4">
                            <img src="~/images/Logo.png" alt="" height="40" style="filter:brightness(0) invert(1);opacity:.95" />
                            <span class="brand-word" style="color:#fbf6ef">BloodBank<em style="color:#ff9aa7">.</em></span>
                        </div>
                        <p class="eyebrow" style="color:rgba(255,246,238,.55)">Donor access</p>
                        <h2>One drop can save <em>a life.</em></h2>
                        <p style="margin-top:12px;max-width:34ch">
                            Sign in to see verified donor contacts, manage your requests and keep your donor card current.
                        </p>
                        <ul class="auth-points">
                            <li><i class="fas fa-check" aria-hidden="true"></i><span>Contact details of compatible donors</span></li>
                            <li><i class="fas fa-check" aria-hidden="true"></i><span>Your donation history and eligibility date</span></li>
                            <li><i class="fas fa-check" aria-hidden="true"></i><span>Live updates on requests you respond to</span></li>
                        </ul>
                    </div>
                    <div style="border-top:1px solid rgba(255,246,238,.16);padding-top:16px">
                        <div class="meta" style="color:rgba(255,246,238,.45);font-size:.6rem">Emergency helpline · 24/7</div>
                        <a href="tel:999" style="color:#fff;font-family:var(--font-mono);font-size:1rem">999</a>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="auth-form-side">
                    <a class="auth-brand-logo d-lg-none" asp-controller="Home" asp-action="Index">
                        <img src="~/images/Logo.png" alt="" height="32" />
                        <span>BloodBank<em class="text-danger" style="font-style:normal">.</em></span>
                    </a>

                    <p class="eyebrow">Welcome back</p>
                    <h3>Sign in to your account</h3>
                    <p>Access your donor dashboard and emergency requests.</p>

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success mb-4" role="status">
                            <i class="fas fa-circle-check" aria-hidden="true"></i>@TempData["Success"]
                        </div>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger mb-4" role="alert">
                            <i class="fas fa-circle-exclamation" aria-hidden="true"></i>@TempData["Error"]
                        </div>
                    }

                    <form asp-action="Login" method="post">
                        @Html.AntiForgeryToken()
                        <div class="form-group">
                            <label for="loginEmail">Email address</label>
                            <input id="loginEmail" type="email" class="form-control" name="email" required
                                   placeholder="name@example.com" autocomplete="email" />
                        </div>

                        <div class="form-group">
                            <div class="d-flex justify-content-between align-items-baseline">
                                <label for="loginPassword" style="margin-bottom:7px">Password</label>
                                <a asp-action="ForgotPassword" style="font-size:.78rem;color:var(--blood)">Forgot password?</a>
                            </div>
                            <input id="loginPassword" type="password" class="form-control" name="password" required
                                   placeholder="Enter your password" autocomplete="current-password" />
                        </div>

                        <div class="form-check mb-4">
                            <input class="form-check-input" type="checkbox" id="rememberMe" checked />
                            <label class="form-check-label" for="rememberMe">Keep me signed in on this device</label>
                        </div>

                        <button type="submit" class="btn btn-blood btn-block btn-lg">
                            <i class="fas fa-arrow-right-to-bracket" aria-hidden="true"></i> Sign in
                        </button>
                    </form>

                    <div class="auth-alt">
                        <span>New to the network?</span>
                        <a asp-action="Register">Create a donor account</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
