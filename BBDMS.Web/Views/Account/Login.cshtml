@{
    ViewData["Title"] = "Login";
}

<div class="inner-banner-w3ls">
    <div class="container">
    </div>
</div>

<div class="breadcrumb-agile">
    <div aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-controller="Home" asp-action="Index">Home</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">Login</li>
        </ol>
    </div>
</div>

<div class="login px-4 mx-auto mw-100 py-5" style="max-width: 400px;">
    <h5 class="text-center mb-4">Donor Login</h5>
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    <form asp-action="Login" method="post">
        <div class="form-group">
            <label>Email Id</label>
            <input type="email" class="form-control" name="email" required placeholder="Email Id">
        </div>
        <div class="form-group">
            <label>Password</label>
            <input type="password" class="form-control" name="password" required placeholder="Password">
        </div>
        <button type="submit" class="btn btn-primary submit mb-4">Login</button>
        <p class="text-center">Don't have an account? <a asp-action="Register">Register Now</a></p>
    </form>
</div>
