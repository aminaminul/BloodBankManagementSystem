@{
    ViewData["Title"] = "Privacy Policy";
}

<section class="page-head">
    <div class="container">
        <nav aria-label="Breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item active" aria-current="page">Privacy policy</li>
            </ol>
        </nav>
        <div class="page-head-row">
            <div>
                <p class="eyebrow">Trust &amp; safety</p>
                <h1>Privacy &amp; data security.</h1>
                <p>How donor confidentiality and patient information are protected across the emergency network.</p>
            </div>
            <div class="page-head-actions">
                <a class="btn btn-ghost" asp-action="Contact">
                    <i class="fas fa-envelope" aria-hidden="true"></i> Contact the team
                </a>
            </div>
        </div>
    </div>
</section>

<section class="section-tight">
    <div class="container">
        <div class="detail-layout">
            <article class="detail-main">
                <div class="panel">
                    <span class="meta-label">Policy · last updated September 2026</span>
                    <div class="policy">
                        <section>
                            <h2><span class="num">01</span> Donor information protection</h2>
                            <p>We value donor trust and safeguard personal information including names, contact numbers, email addresses and medical eligibility records. Contact details are only visible to authorised requesters during an active emergency match.</p>
                        </section>

                        <section>
                            <h2><span class="num">02</span> Emergency requests &amp; dispatch transparency</h2>
                            <p>Patient emergency requests for blood, ambulance and oxygen are broadcast across the verified network so the nearest capable response reaches the patient in time. Each request keeps a tracking trail visible to the person who posted it.</p>
                        </section>

                        <section>
                            <h2><span class="num">03</span> Medical safety &amp; non-commercial guarantee</h2>
                            <p>Blood donation through this platform is voluntary and free of commercial exploitation. We follow standard World Health Organization guidance and local healthcare eligibility protocols for every donor interval.</p>
                        </section>

                        <section>
                            <h2><span class="num">04</span> Your controls</h2>
                            <p>Donors can update or withdraw their profile at any time from the donor dashboard. Removing a profile stops it appearing in searches immediately; emergency requests you have posted remain visible until they are closed.</p>
                        </section>
                    </div>
                </div>
            </article>

            <aside class="detail-aside">
                <div class="panel panel-sticky">
                    <h2>Questions about your data?</h2>
                    <p class="panel-note">The support desk answers privacy questions during network hours and escalates anything urgent to the coordinator team.</p>
                    <a class="btn btn-blood btn-block" asp-action="Contact">
                        <i class="fas fa-paper-plane" aria-hidden="true"></i> Contact support
                    </a>
                    <div class="aside-divider">
                        <span class="meta-label">Emergency line · 24/7</span>
                        <a class="phone" href="tel:01700000000">01700000000</a>
                    </div>
                    <a asp-action="Status" class="link-arrow mt-4">
                        Network status <i class="fas fa-arrow-right" aria-hidden="true"></i>
                    </a>
                </div>
            </aside>
        </div>
    </div>
</section>
