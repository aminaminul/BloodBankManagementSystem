@model BBDMS.Model.Models.Entities.ContactInfo
@{
    ViewData["Title"] = "Contact us";
    var tel = Model?.ContactNo;
    var email = Model?.EmailId;
    var address = Model?.Address;
}

<section class="page-head">
    <div class="container">
        <nav aria-label="Breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item active" aria-current="page">Contact</li>
            </ol>
        </nav>
        <div class="page-head-row">
            <div>
                <p class="eyebrow">We are reachable</p>
                <h1>Contact us</h1>
                <p>Questions about donation, emergency services or partnerships — send a message and the team will respond.</p>
            </div>
            <div class="page-head-actions">
                @if (!string.IsNullOrEmpty(tel))
                {
                    <a class="btn btn-blood" href="tel:@tel">
                        <i class="fas fa-phone-volume" aria-hidden="true"></i> Call @tel
                    </a>
                }
                <a class="btn btn-ghost" asp-controller="Home" asp-action="Compatibility">Compatibility guide</a>
            </div>
        </div>
    </div>
</section>

<section class="section">
    <div class="container">
        @if (TempData["Message"] != null)
        {
            <div class="alert alert-success d-flex align-items-start gap-2 mb-4" role="status">
                <i class="fas fa-circle-check" aria-hidden="true"></i>
                <span>@TempData["Message"]</span>
            </div>
        }

        <div class="row g-4 align-items-stretch">
            <div class="col-lg-5">
                <div class="panel-ink panel h-100 d-flex flex-column" style="padding:clamp(24px,3vw,36px)">
                    <p class="eyebrow" style="color:rgba(255,246,238,.55)">Direct channels</p>
                    <h2 style="font-family:var(--font-display);font-weight:400;font-size:clamp(1.7rem,2.6vw,2.2rem);line-height:1.05;letter-spacing:-.02em;color:#fbf6ef;margin:0 0 10px">
                        Talk to a human.
                    </h2>
                    <p style="color:rgba(255,246,238,.6);font-size:.92rem;max-width:36ch">
                        For an emergency, call the helpline instead of using this form — it is answered around the clock.
                    </p>

                    <div style="margin-top:auto;padding-top:28px;display:grid;gap:18px">
                        @if (!string.IsNullOrEmpty(address))
                        {
                            <div class="d-flex gap-3">
                                <span class="bg-glyph" style="width:36px;min-width:36px;height:36px;font-size:.85rem;color:#ffb3bd;background:rgba(255,255,255,.06);border-color:rgba(255,255,255,.16)"><i class="fas fa-location-dot" aria-hidden="true"></i></span>
                                <div>
                                    <div class="meta" style="color:rgba(255,246,238,.45);font-size:.6rem">Head office</div>
                                    <div style="color:#f3ece4;font-size:.92rem;line-height:1.45">@address</div>
                                </div>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(tel))
                        {
                            <div class="d-flex gap-3">
                                <span class="bg-glyph" style="width:36px;min-width:36px;height:36px;font-size:.85rem;color:#ffb3bd;background:rgba(255,255,255,.06);border-color:rgba(255,255,255,.16)"><i class="fas fa-phone" aria-hidden="true"></i></span>
                                <div>
                                    <div class="meta" style="color:rgba(255,246,238,.45);font-size:.6rem">Emergency helpline · 24/7</div>
                                    <a href="tel:@tel" style="color:#fff;font-family:var(--font-mono);font-size:1rem">@tel</a>
                                </div>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(email))
                        {
                            <div class="d-flex gap-3">
                                <span class="bg-glyph" style="width:36px;min-width:36px;height:36px;font-size:.85rem;color:#ffb3bd;background:rgba(255,255,255,.06);border-color:rgba(255,255,255,.16)"><i class="fas fa-envelope" aria-hidden="true"></i></span>
                                <div>
                                    <div class="meta" style="color:rgba(255,246,238,.45);font-size:.6rem">Email</div>
                                    <a href="mailto:@email" style="color:#f3ece4;font-size:.92rem">@email</a>
                                </div>
                            </div>
                        }
                    </div>

                    <div style="margin-top:24px;padding-top:20px;border-top:1px solid rgba(255,246,238,.14);display:flex;gap:8px;flex-wrap:wrap">
                        <a class="btn btn-sm btn-on-ink" asp-controller="Emergency" asp-action="Index">Emergency hub</a>
                        <a class="btn btn-sm btn-on-ink" asp-controller="Donor" asp-action="Search">Find donors</a>
                    </div>
                </div>
            </div>

            <div class="col-lg-7">
                <div class="panel h-100">
                    <p class="eyebrow">Send a message</p>
                    <h2 class="section-title" style="font-size:1.7rem">How can we help?</h2>
                    <p class="section-sub mb-4">All fields are required. Please do not include medical records or sensitive details.</p>

                    <form asp-action="Contact" method="post">
                        @Html.AntiForgeryToken()
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label for="cName">Full name</label>
                                <input id="cName" type="text" class="form-control" name="Name" required placeholder="Your full name" autocomplete="name" />
                            </div>
                            <div class="col-md-6">
                                <label for="cPhone">Mobile number</label>
                                <input id="cPhone" type="tel" class="form-control" name="ContactNumber" required placeholder="01XXXXXXXXX" autocomplete="tel" />
                            </div>
                            <div class="col-12">
                                <label for="cEmail">Email address</label>
                                <input id="cEmail" type="email" class="form-control" name="EmailId" required placeholder="you@example.com" autocomplete="email" />
                            </div>
                            <div class="col-12">
                                <label for="cMessage">Message</label>
                                <textarea id="cMessage" class="form-control" name="Message" required rows="6" placeholder="Write your message here…"></textarea>
                            </div>
                            <div class="col-12">
                                <div class="form-actions">
                                    <button type="submit" class="btn btn-blood">
                                        <i class="fas fa-paper-plane" aria-hidden="true"></i> Send message
                                    </button>
                                    <span class="meta" style="text-transform:none;letter-spacing:0;font-family:var(--font-sans);font-size:.8rem;color:var(--muted)">
                                        Messages are stored in the admin console, not shared publicly.
                                    </span>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
