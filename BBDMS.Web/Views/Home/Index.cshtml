@model BBDMS.Model.Models.ViewModels.HomeIndexViewModel
@{
    ViewData["Title"] = "Find Blood & Emergency Help";
    var helpline = Model.ContactInfo != null && !string.IsNullOrEmpty(Model.ContactInfo.ContactNo)
        ? Model.ContactInfo.ContactNo : "999";
}

@* ══════════════════════════════════════════════════
   HERO — light, headline + CTA + hero media
   ══════════════════════════════════════════════════ *@
<section class="hero-modern section-full">
    <div class="container">
        <div class="row align-items-center g-5">

            @* ── Left: Headline + CTA ── *@
            <div class="col-lg-7">
                <div class="hero-badge">
                    <i class="fas fa-heartbeat"></i> Together We Donate
                </div>
                <h1 class="hero-title">
                    Find Blood.<br />
                    <span>Save a Life.</span>
                </h1>
                <p class="hero-subtitle">
                    Access blood donors, hospitals, blood banks, ambulances and medical
                    oxygen services — all from one trusted emergency healthcare platform.
                </p>

                <div class="d-flex flex-wrap gap-3 mb-4">
                    <a asp-controller="Donor" asp-action="Search" class="btn btn-brand-red">
                        <i class="fas fa-tint"></i> Find Blood
                    </a>
                    <a asp-controller="Emergency" asp-action="Index" class="btn btn-brand-outline">
                        Emergency Help <i class="fas fa-arrow-right ms-1"></i>
                    </a>
                </div>

                @* Instant donor search *@
                <div class="hero-search-card">
                    <form asp-controller="Donor" asp-action="Search" method="get">
                        <div class="row g-2 align-items-end">
                            <div class="col-sm-5">
                                <label class="form-label mb-1"><i class="fas fa-tint text-danger me-1"></i>Blood Group</label>
                                <select name="bloodGroup" class="form-select form-control-modern">
                                    <option value="">Select Group</option>
                                    @if (Model.BloodGroups != null)
                                    {
                                        foreach (var bg in Model.BloodGroups)
                                        {
                                            <option value="@bg.GroupName">@bg.GroupName</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-sm-4">
                                <label class="form-label mb-1"><i class="fas fa-map-marker-alt text-danger me-1"></i>Location</label>
                                <input type="text" name="location" class="form-control form-control-modern" placeholder="e.g. Dhaka" />
                            </div>
                            <div class="col-sm-3">
                                <button type="submit" class="btn btn-brand-red w-100">
                                    <i class="fas fa-search"></i> Find
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            @* ── Right: Hero Media ── *@
            <div class="col-lg-5">
                <div class="hero-media">
                    <img src="~/images/banner1.jpg" alt="Emergency Hospital" />
                    <div class="hero-media-badge">
                        <div>
                            <div class="num">24/7</div>
                            <div class="lbl">Emergency Service</div>
                        </div>
                        <a href="tel:@helpline" class="btn btn-brand-red btn-sm">
                            <i class="fas fa-phone"></i> Call Now
                        </a>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

@* ══════════════════════════════════════════════════
   SERVICE ROW — five core emergency services
   ══════════════════════════════════════════════════ *@
<section class="services-section section-full">
    <div class="container">
        <div class="row g-3">
            <div class="col-6 col-lg">
                <a asp-controller="Donor" asp-action="Search" class="service-cat-card">
                    <div class="service-icon-box"><i class="fas fa-users"></i></div>
                    <h6 class="fw-bold mb-1">Blood Donors</h6>
                    <small class="text-muted d-block">Find ready donors by group &amp; area</small>
                </a>
            </div>
            <div class="col-6 col-lg">
                <a asp-controller="Emergency" asp-action="Hospitals" class="service-cat-card">
                    <div class="service-icon-box"><i class="fas fa-hospital"></i></div>
                    <h6 class="fw-bold mb-1">Hospitals</h6>
                    <small class="text-muted d-block">Live emergency &amp; ICU beds</small>
                </a>
            </div>
            <div class="col-6 col-lg">
                <a asp-controller="Emergency" asp-action="BloodBanks" class="service-cat-card">
                    <div class="service-icon-box"><i class="fas fa-landmark"></i></div>
                    <h6 class="fw-bold mb-1">Blood Banks</h6>
                    <small class="text-muted d-block">Check stock across centers</small>
                </a>
            </div>
            <div class="col-6 col-lg">
                <a asp-controller="Emergency" asp-action="Ambulances" class="service-cat-card">
                    <div class="service-icon-box"><i class="fas fa-ambulance"></i></div>
                    <h6 class="fw-bold mb-1">Ambulance</h6>
                    <small class="text-muted d-block">Request rapid transport</small>
                </a>
            </div>
            <div class="col-6 col-lg">
                <a asp-controller="Emergency" asp-action="Oxygen" class="service-cat-card">
                    <div class="service-icon-box"><i class="fas fa-lungs"></i></div>
                    <h6 class="fw-bold mb-1">Oxygen Services</h6>
                    <small class="text-muted d-block">Find oxygen providers nearby</small>
                </a>
            </div>
        </div>
    </div>
</section>

<!-- Interactive Compatibility & Quiz Banner -->
<div class="container my-4">
    <div class="card border-0 shadow-sm" style="background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%); border-radius: 16px;">
        <div class="card-body p-4 text-white d-flex flex-column flex-md-row justify-content-between align-items-center">
            <div class="mb-3 mb-md-0">
                <span class="badge badge-danger text-uppercase px-2 py-1 mb-2 font-weight-bold">
                    <i class="fas fa-heartbeat mr-1"></i> Interactive Compatibility Guide
                </span>
                <h4 class="font-weight-bold mb-1 text-white">Can you donate blood today? Check compatibility!</h4>
                <p class="text-white-50 mb-0 small">
                    Explore our visual blood matching matrix and take the quick 60-second eligibility self-screening.
                </p>
            </div>
            <div>
                <a asp-controller="Home" asp-action="Compatibility" class="btn btn-brand-red font-weight-bold px-4 py-2 shadow text-nowrap">
                    <i class="fas fa-play-circle mr-1"></i> Check Eligibility Now
                </a>
            </div>
        </div>
    </div>
</div>

@* ══════════════════════════════════════════════════
   STATS STRIP
   ══════════════════════════════════════════════════ *@
<div class="stats-strip section-full">
    <div class="stats-strip-inner">
        <div class="stat-item">
            <div class="stat-number text-danger"><i class="fas fa-tint"></i>@Model.TotalDonors</div>
            <div class="stat-label">Registered Donors</div>
        </div>
        <div class="stat-item">
            <div class="stat-number text-primary"><i class="fas fa-hospital"></i>@Model.TotalHospitals</div>
            <div class="stat-label">Hospitals</div>
        </div>
        <div class="stat-item">
            <div class="stat-number" style="color:var(--violet);"><i class="fas fa-landmark"></i>@Model.TotalBloodBanks</div>
            <div class="stat-label">Blood Banks</div>
        </div>
        <div class="stat-item">
            <div class="stat-number text-warning"><i class="fas fa-ambulance"></i>@Model.TotalAmbulances</div>
            <div class="stat-label">Ambulances</div>
        </div>
        <div class="stat-item">
            <div class="stat-number text-info"><i class="fas fa-lungs"></i>@Model.TotalOxygenSuppliers</div>
            <div class="stat-label">Oxygen Providers</div>
        </div>
        <div class="stat-item">
            <div class="stat-number text-success"><i class="fas fa-bed"></i>@Model.TotalAvailableIcuBeds</div>
            <div class="stat-label">ICU Beds Available</div>
        </div>
        <div class="stat-item">
            <div class="stat-number text-danger"><i class="fas fa-heartbeat"></i>@Model.TotalActiveRequests</div>
            <div class="stat-label">Active Requests</div>
        </div>
    </div>
</div>

@* ══════════════════════════════════════════════════
   BLOOD GROUP DIRECTORY
   ══════════════════════════════════════════════════ *@
@if (Model.BloodGroups != null && Model.BloodGroups.Any())
{
    <section class="bloodgroup-strip section-full">
        <div class="container">
            <div class="text-center mb-4">
                <h2 class="section-title">Blood Groups Directory</h2>
                <p class="section-sub">Select a blood group to instantly find available registered donors</p>
            </div>
            <div class="d-flex flex-wrap justify-content-center gap-3">
                @foreach (var bg in Model.BloodGroups)
                {
                    <a asp-controller="Donor" asp-action="Search" asp-route-bloodGroup="@bg.GroupName" class="blood-group-chip">
                        <i class="fas fa-tint" style="font-size:.8rem;"></i>@bg.GroupName
                    </a>
                }
            </div>
        </div>
    </section>
}

@* ══════════════════════════════════════════════════
   URGENT BLOOD REQUESTS
   ══════════════════════════════════════════════════ *@
@if (Model.UrgentRequests != null && Model.UrgentRequests.Any())
{
    <section class="urgent-section section-full">
        <div class="container">
            <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
                <div>
                    <h2 class="section-title text-danger"><i class="fas fa-exclamation-circle me-2"></i>Active Urgent Blood Needs</h2>
                    <p class="section-sub">Patients currently awaiting blood transfusions</p>
                </div>
                <a asp-controller="Emergency" asp-action="BloodRequests" class="btn btn-brand-outline">
                    View All <i class="fas fa-arrow-right ms-1"></i>
                </a>
            </div>

            <div class="row g-4">
                @foreach (var req in Model.UrgentRequests)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card-modern h-100 d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-3 gap-2">
                                <span class="badge-soft-danger" style="font-size:.95rem;">
                                    <i class="fas fa-tint"></i>@(req.BloodGroup ?? req.BloodRequireFor)
                                </span>
                                <span class="@(req.Urgency == "Critical" || req.Urgency?.Contains("Critical") == true ? "badge-soft-danger" : "badge-soft-warning")">
                                    @req.Urgency
                                </span>
                            </div>
                            <h5 class="fw-bold mb-1 text-dark">@req.Name</h5>
                            <p class="section-sub mb-2"><i class="fas fa-hospital me-1 text-danger"></i>@req.HospitalName, @req.Location</p>
                            <p class="text-dark small mb-3">
                                <strong>Reason:</strong> @req.BloodRequireFor
                                (@req.UnitsRequired Unit@(req.UnitsRequired > 1 ? "s" : ""))
                            </p>
                            <div class="pt-3 border-top d-flex justify-content-between align-items-center mt-auto">
                                <span class="small text-muted">
                                    <i class="far fa-clock me-1"></i>
                                    @(req.ApplyDate.HasValue ? req.ApplyDate.Value.ToString("MMM dd") : "Recent")
                                </span>
                                <a asp-controller="Emergency" asp-action="RequestDetails" asp-route-id="@req.ID" class="btn btn-sm btn-brand-red fw-bold">Respond</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}

@* ══════════════════════════════════════════════════
   AVAILABLE DONORS
   ══════════════════════════════════════════════════ *@
<section class="donors-section section-full">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
            <div>
                <h2 class="section-title">Available Lifesaver Donors</h2>
                <p class="section-sub">Voluntary community donors registered in our system</p>
            </div>
            <a asp-controller="Donor" asp-action="Search" class="btn btn-brand-outline">
                Search All Donors <i class="fas fa-search ms-1"></i>
            </a>
        </div>

        @if (Model.ActiveDonors != null && Model.ActiveDonors.Any())
        {
            <div class="row g-4">
                @foreach (var donor in Model.ActiveDonors)
                {
                    var initials = string.Concat((donor.FullName ?? "D").Split(' ').Take(2).Select(s => s.Length > 0 ? s[0] : ' ')).ToUpper();
                    <div class="col-md-6 col-lg-4">
                        <div class="card-modern h-100 d-flex flex-column">
                            <div class="d-flex align-items-center gap-3 mb-3">
                                <div class="avatar-circle">@initials</div>
                                <div class="flex-grow-1 overflow-hidden">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <h6 class="fw-bold mb-0 text-truncate">@donor.FullName</h6>
                                        <span class="badge-soft-danger ms-2 flex-shrink-0">@donor.BloodGroup</span>
                                    </div>
                                    <p class="text-muted small mb-0 text-truncate"><i class="fas fa-map-marker-alt me-1"></i>@donor.Address</p>
                                </div>
                            </div>
                            <div class="d-flex justify-content-between align-items-center small text-muted mb-3">
                                <span>@donor.Gender &bull; @(donor.Age.HasValue ? donor.Age + " yrs" : "—")</span>
                                <span class="badge-soft-success"><i class="fas fa-check-circle"></i>@(donor.IsAvailable ? "Available" : "Registered")</span>
                            </div>
                            <div class="pt-3 border-top mt-auto">
                                <a href="tel:@donor.MobileNumber" class="btn btn-brand-outline w-100 btn-sm">
                                    <i class="fas fa-phone"></i> Contact Donor
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="fas fa-users fa-3x text-muted mb-3 d-block"></i>
                <h5 class="text-muted">No donors listed yet.</h5>
                <a asp-controller="Account" asp-action="Register" class="btn btn-brand-red mt-3"><i class="fas fa-heart me-1"></i> Become a Donor</a>
            </div>
        }
    </div>
</section>

@* ══════════════════════════════════════════════════
   HOSPITALS
   ══════════════════════════════════════════════════ *@
@if (Model.FeaturedHospitals != null && Model.FeaturedHospitals.Any())
{
    <section class="hospitals-section section-full">
        <div class="container">
            <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
                <div>
                    <h2 class="section-title">Registered Hospitals &amp; ICU</h2>
                    <p class="section-sub">Emergency facilities with live bed availability</p>
                </div>
                <a asp-controller="Emergency" asp-action="Hospitals" class="btn btn-brand-outline">
                    View All Hospitals <i class="fas fa-arrow-right ms-1"></i>
                </a>
            </div>

            <div class="row g-4">
                @foreach (var hosp in Model.FeaturedHospitals)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card-modern h-100 d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="fw-bold text-dark mb-0" style="font-size:1rem;">@hosp.Name</h5>
                                <span class="badge-soft-primary flex-shrink-0 ms-2">@hosp.City</span>
                            </div>
                            <p class="text-muted small mb-3"><i class="fas fa-map-marker-alt text-danger me-1"></i>@hosp.Address</p>

                            <div class="row g-0 text-center mb-3 rounded overflow-hidden" style="border:1px solid var(--border); background:#f8fafc;">
                                <div class="col-6 py-3 border-end">
                                    <small class="text-muted d-block fw-semibold">Emergency Beds</small>
                                    <span class="fw-bold text-success" style="font-size:1.4rem;">@hosp.AvailableEmergencyBeds</span>
                                    <small class="text-muted"> / @hosp.TotalEmergencyBeds</small>
                                </div>
                                <div class="col-6 py-3">
                                    <small class="text-muted d-block fw-semibold">ICU Beds</small>
                                    <span class="fw-bold text-danger" style="font-size:1.4rem;">@hosp.AvailableIcuBeds</span>
                                    <small class="text-muted"> / @hosp.TotalIcuBeds</small>
                                </div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center pt-3 border-top mt-auto">
                                <span class="small fw-semibold text-danger"><i class="fas fa-phone me-1"></i>@hosp.EmergencyHelpline</span>
                                <a href="tel:@hosp.EmergencyHelpline" class="btn btn-sm btn-brand-red">Call Helpline</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}

@* ══════════════════════════════════════════════════
   CTA BANNER
   ══════════════════════════════════════════════════ *@
<section class="cta-section section-full">
    <div class="container" style="position:relative; z-index:1;">
        <h2>Be a Donor, Be a Hero.</h2>
        <p>Your small act can save a life. Every blood donation can save up to 3 precious lives — join our voluntary network today.</p>
        <div class="d-flex justify-content-center flex-wrap gap-3">
            <a asp-controller="Account" asp-action="Register" class="btn btn-light rounded-pill fw-bold px-4 shadow" style="color:var(--brand);">
                <i class="fas fa-heart me-1"></i> Register as a Donor
            </a>
            <a asp-controller="Home" asp-action="About" class="btn btn-outline-light rounded-pill px-4 fw-semibold">
                Learn How It Works
            </a>
        </div>
    </div>
</section>
