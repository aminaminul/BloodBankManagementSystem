@model BBDMS.Model.Models.ViewModels.HomeIndexViewModel
@{
    ViewData["Title"] = "Find Blood & Emergency Help";
}

@* ══════════════════════════════════════════════════
   HERO — Full-width dark section
   ══════════════════════════════════════════════════ *@
<section class="hero-modern section-full">
    <div class="container">
        <div class="row align-items-center g-5">

            @* ── Left: Headline + Search + CTA ── *@
            <div class="col-lg-7">
                <div class="hero-badge">
                    <i class="fas fa-heartbeat"></i> Emergency Healthcare &amp; Blood Help
                </div>
                <h1 class="hero-title">
                    Find Blood.<br />
                    <span>Save a Life.</span>
                </h1>
                <p class="hero-subtitle">
                    Connect with voluntary blood donors, ICU hospitals, fast ambulances,
                    and medical oxygen — all from one lifesaver platform.
                </p>

                @* Instant Donor Search *@
                <div class="hero-search-box mb-4">
                    <form asp-controller="Donor" asp-action="Search" method="get">
                        <div class="row g-2 align-items-end">
                            <div class="col-sm-5">
                                <label class="form-label fw-semibold mb-1" style="color:#cbd5e1; font-size:.82rem;">
                                    <i class="fas fa-tint text-danger me-1"></i>Blood Group
                                </label>
                                <select name="bloodGroup" class="form-select form-control-modern" required>
                                    <option value="">Select Group</option>
                                    @if (Model.BloodGroups != null && Model.BloodGroups.Any())
                                    {
                                        foreach (var bg in Model.BloodGroups)
                                        {
                                            <option value="@bg.GroupName">@bg.GroupName</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-sm-4">
                                <label class="form-label fw-semibold mb-1" style="color:#cbd5e1; font-size:.82rem;">
                                    <i class="fas fa-map-marker-alt text-danger me-1"></i>City / Location
                                </label>
                                <input type="text" name="location" class="form-control form-control-modern"
                                       placeholder="e.g. Dhaka" />
                            </div>
                            <div class="col-sm-3">
                                <button type="submit" class="btn btn-brand-red w-100">
                                    <i class="fas fa-search"></i> Find
                                </button>
                            </div>
                        </div>
                    </form>
                </div>

                <div class="d-flex flex-wrap gap-3">
                    <a asp-controller="Emergency" asp-action="CreateBloodRequest" class="btn btn-brand-red">
                        <i class="fas fa-tint"></i> Post Emergency Request
                    </a>
                    <a asp-controller="Emergency" asp-action="Index" class="btn btn-brand-outline" style="border-color:rgba(255,255,255,.35); color:#fff !important;">
                        Emergency Hub <i class="fas fa-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>

            @* ── Right: Info Card ── *@
            <div class="col-lg-5">
                <div class="hero-card">
                    <img src="~/images/banner1.jpg" alt="Emergency Hospital" />
                    <div class="hero-card-body">
                        <h5>Instant Healthcare Response</h5>
                        <p>Connecting patients and critical care facilities across all major divisions.</p>
                        <div class="hero-helpline-row">
                            <div>
                                <span class="label">Emergency Helpline</span>
                                <span class="number">
                                    @(Model.ContactInfo != null && !string.IsNullOrEmpty(Model.ContactInfo.ContactNo)
                                        ? Model.ContactInfo.ContactNo : "999")
                                </span>
                            </div>
                            <a href="tel:@(Model.ContactInfo != null && !string.IsNullOrEmpty(Model.ContactInfo.ContactNo)
                                ? Model.ContactInfo.ContactNo : "999")"
                               class="btn btn-brand-red btn-sm">
                                <i class="fas fa-phone"></i> Call Now
                            </a>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

@* ══════════════════════════════════════════════════
   STATS STRIP — Full width, right below hero
   ══════════════════════════════════════════════════ *@
<div class="stats-strip section-full">
    <div class="stats-strip-inner">
        <div class="stat-item">
            <div class="stat-number text-danger"><i class="fas fa-tint"></i>@Model.TotalDonors</div>
            <div class="stat-label">Registered Donors</div>
        </div>
        <div class="stat-item">
            <div class="stat-number text-primary"><i class="fas fa-hospital"></i>@Model.TotalHospitals</div>
            <div class="stat-label">Hospitals</div>
        </div>
        <div class="stat-item">
            <div class="stat-number text-success"><i class="fas fa-bed"></i>@Model.TotalAvailableIcuBeds</div>
            <div class="stat-label">Available ICU Beds</div>
        </div>
        <div class="stat-item">
            <div class="stat-number" style="color:#7c3aed;"><i class="fas fa-procedures"></i>@Model.TotalAvailableEmergencyBeds</div>
            <div class="stat-label">Emergency Beds</div>
        </div>
        <div class="stat-item">
            <div class="stat-number text-danger"><i class="fas fa-landmark"></i>@Model.TotalBloodBanks</div>
            <div class="stat-label">Blood Banks</div>
        </div>
        <div class="stat-item">
            <div class="stat-number text-warning"><i class="fas fa-ambulance"></i>@Model.TotalAmbulances</div>
            <div class="stat-label">Ambulances</div>
        </div>
        <div class="stat-item">
            <div class="stat-number text-info"><i class="fas fa-lungs"></i>@Model.TotalOxygenSuppliers</div>
            <div class="stat-label">Oxygen Suppliers</div>
        </div>
        <div class="stat-item">
            <div class="stat-number text-danger"><i class="fas fa-heartbeat"></i>@Model.TotalActiveRequests</div>
            <div class="stat-label">Active Requests</div>
        </div>
    </div>
</div>

@* ══════════════════════════════════════════════════
   SERVICES GRID — Full width
   ══════════════════════════════════════════════════ *@
<section class="services-section section-full">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="section-title">Emergency Healthcare Directory</h2>
            <p class="section-sub">Verified resources actively maintained across the healthcare network</p>
        </div>
        <div class="row g-4">

            @* ── Find Donors ── *@
            <div class="col-6 col-md-4 col-lg-2">
                <a asp-controller="Donor" asp-action="Search" class="svc-card svc-red">
                    <div class="svc-icon-wrap">
                        <i class="fas fa-users"></i>
                    </div>
                    <div class="svc-count">@Model.TotalDonors</div>
                    <div class="svc-title">Find Donors</div>
                    <div class="svc-sub">Registered</div>
                </a>
            </div>

            @* ── Blood Request ── *@
            <div class="col-6 col-md-4 col-lg-2">
                <a asp-controller="Emergency" asp-action="CreateBloodRequest" class="svc-card svc-crimson">
                    <div class="svc-icon-wrap">
                        <i class="fas fa-tint"></i>
                    </div>
                    <div class="svc-count">@Model.TotalActiveRequests</div>
                    <div class="svc-title">Blood Request</div>
                    <div class="svc-sub">Active Now</div>
                </a>
            </div>

            @* ── Hospitals & ICU ── *@
            <div class="col-6 col-md-4 col-lg-2">
                <a asp-controller="Emergency" asp-action="Hospitals" class="svc-card svc-blue">
                    <div class="svc-icon-wrap">
                        <i class="fas fa-hospital"></i>
                    </div>
                    <div class="svc-count">@Model.TotalHospitals</div>
                    <div class="svc-title">Hospitals &amp; ICU</div>
                    <div class="svc-sub">Facilities</div>
                </a>
            </div>

            @* ── Blood Banks ── *@
            <div class="col-6 col-md-4 col-lg-2">
                <a asp-controller="Emergency" asp-action="BloodBanks" class="svc-card svc-purple">
                    <div class="svc-icon-wrap">
                        <i class="fas fa-landmark"></i>
                    </div>
                    <div class="svc-count">@Model.TotalBloodBanks</div>
                    <div class="svc-title">Blood Banks</div>
                    <div class="svc-sub">Storage Centers</div>
                </a>
            </div>

            @* ── Ambulances ── *@
            <div class="col-6 col-md-4 col-lg-2">
                <a asp-controller="Emergency" asp-action="Ambulances" class="svc-card svc-orange">
                    <div class="svc-icon-wrap">
                        <i class="fas fa-ambulance"></i>
                    </div>
                    <div class="svc-count">@Model.TotalAmbulances</div>
                    <div class="svc-title">Ambulances</div>
                    <div class="svc-sub">Fleet Registered</div>
                </a>
            </div>

            @* ── Oxygen Supply ── *@
            <div class="col-6 col-md-4 col-lg-2">
                <a asp-controller="Emergency" asp-action="Oxygen" class="svc-card svc-teal">
                    <div class="svc-icon-wrap">
                        <i class="fas fa-lungs"></i>
                    </div>
                    <div class="svc-count">@Model.TotalOxygenSuppliers</div>
                    <div class="svc-title">Oxygen Supply</div>
                    <div class="svc-sub">Suppliers</div>
                </a>
            </div>

        </div>
    </div>
</section>


@* ══════════════════════════════════════════════════
   BLOOD GROUP DIRECTORY — Full width strip
   ══════════════════════════════════════════════════ *@
@if (Model.BloodGroups != null && Model.BloodGroups.Any())
{
    <section class="bloodgroup-strip section-full">
        <div class="container">
            <div class="text-center mb-4">
                <h2 class="section-title">Blood Groups Directory</h2>
                <p class="section-sub">Select your blood group to find available registered donors instantly</p>
            </div>
            <div class="d-flex flex-wrap justify-content-center gap-3">
                @foreach (var bg in Model.BloodGroups)
                {
                    <a asp-controller="Donor" asp-action="Search" asp-route-bloodGroup="@bg.GroupName"
                       class="blood-group-chip">
                        <i class="fas fa-tint" style="font-size:.8rem;"></i>
                        @bg.GroupName
                    </a>
                }
            </div>
        </div>
    </section>
}

@* ══════════════════════════════════════════════════
   URGENT BLOOD REQUESTS — Full width
   ══════════════════════════════════════════════════ *@
@if (Model.UrgentRequests != null && Model.UrgentRequests.Any())
{
    <section class="urgent-section section-full">
        <div class="container">
            <div class="d-flex justify-content-between align-items-center mb-5 flex-wrap gap-3">
                <div>
                    <h2 class="section-title text-danger">
                        <i class="fas fa-exclamation-circle me-2"></i>Active Urgent Blood Needs
                    </h2>
                    <p class="section-sub">Patients currently in emergency units awaiting blood transfusions</p>
                </div>
                <a asp-controller="Emergency" asp-action="BloodRequests"
                   class="btn btn-brand-outline">
                    View All <i class="fas fa-arrow-right ms-1"></i>
                </a>
            </div>

            <div class="row g-4">
                @foreach (var req in Model.UrgentRequests)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card-modern h-100 p-4">
                            <div class="d-flex justify-content-between align-items-start mb-3 gap-2">
                                <span class="badge-soft-danger fw-bold" style="font-size:1rem;">
                                    <i class="fas fa-tint me-1"></i>@(req.BloodGroup ?? req.BloodRequireFor)
                                </span>
                                <span class="@(req.Urgency == "Critical" || req.Urgency?.Contains("Critical") == true
                                    ? "badge-soft-danger" : "badge-soft-warning")">
                                    @req.Urgency
                                </span>
                            </div>
                            <h5 class="fw-bold mb-1 text-dark">@req.Name</h5>
                            <p class="section-sub mb-2">
                                <i class="fas fa-hospital me-1 text-danger"></i>@req.HospitalName, @req.Location
                            </p>
                            <p class="text-dark small mb-3">
                                <strong>Reason:</strong> @req.BloodRequireFor
                                (@req.UnitsRequired Unit@(req.UnitsRequired > 1 ? "s" : ""))
                            </p>
                            <div class="pt-3 border-top d-flex justify-content-between align-items-center mt-auto">
                                <span class="small text-muted">
                                    <i class="far fa-clock me-1"></i>
                                    @(req.ApplyDate.HasValue ? req.ApplyDate.Value.ToString("MMM dd") : "Recent")
                                </span>
                                <a asp-controller="Emergency" asp-action="BloodRequests"
                                   class="btn btn-sm btn-brand-red fw-bold">Respond Now</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}

@* ══════════════════════════════════════════════════
   AVAILABLE DONORS — Full width
   ══════════════════════════════════════════════════ *@
<section class="donors-section section-full">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-5 flex-wrap gap-3">
            <div>
                <h2 class="section-title">Available Lifesaver Donors</h2>
                <p class="section-sub">Voluntary community donors registered in our system</p>
            </div>
            <a asp-controller="Donor" asp-action="Search" class="btn btn-brand-outline">
                Search All Donors <i class="fas fa-search ms-1"></i>
            </a>
        </div>

        @if (Model.ActiveDonors != null && Model.ActiveDonors.Any())
        {
            <div class="row g-4">
                @foreach (var donor in Model.ActiveDonors)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card-modern p-4 h-100">
                            <div class="d-flex align-items-center gap-3 mb-3">
                                <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                                     style="width:52px;height:52px;background:#fff0f1;border:2px solid #fecdd3;">
                                    <i class="fas fa-user text-danger fa-lg"></i>
                                </div>
                                <div class="flex-grow-1 overflow-hidden">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <h6 class="fw-bold mb-0 text-truncate">@donor.FullName</h6>
                                        <span class="badge-soft-danger fw-bold ms-2 flex-shrink-0">@donor.BloodGroup</span>
                                    </div>
                                    <p class="text-muted small mb-0 text-truncate">
                                        <i class="fas fa-map-marker-alt me-1"></i>@donor.Address
                                    </p>
                                </div>
                            </div>
                            <div class="d-flex justify-content-between align-items-center small text-muted mb-3">
                                <span>@donor.Gender &bull; @(donor.Age.HasValue ? donor.Age + " yrs" : "—")</span>
                                <span class="badge-soft-success">
                                    <i class="fas fa-check-circle me-1"></i>
                                    @(donor.IsAvailable ? "Available" : "Registered")
                                </span>
                            </div>
                            <div class="pt-3 border-top mt-auto">
                                <a href="tel:@donor.MobileNumber" class="btn btn-brand-outline w-100 btn-sm">
                                    <i class="fas fa-phone me-1"></i> Contact Donor
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="fas fa-users fa-3x text-muted mb-3 d-block"></i>
                <h5 class="text-muted">No donors listed yet.</h5>
                <a asp-controller="Account" asp-action="Register" class="btn btn-brand-red mt-3">
                    <i class="fas fa-heart me-1"></i> Become a Donor
                </a>
            </div>
        }
    </div>
</section>

@* ══════════════════════════════════════════════════
   HOSPITALS — Full width
   ══════════════════════════════════════════════════ *@
@if (Model.FeaturedHospitals != null && Model.FeaturedHospitals.Any())
{
    <section class="hospitals-section section-full">
        <div class="container">
            <div class="d-flex justify-content-between align-items-center mb-5 flex-wrap gap-3">
                <div>
                    <h2 class="section-title">Registered Hospitals &amp; ICU</h2>
                    <p class="section-sub">Emergency hospital facilities with live bed availability</p>
                </div>
                <a asp-controller="Emergency" asp-action="Hospitals" class="btn btn-brand-outline">
                    View All Hospitals <i class="fas fa-arrow-right ms-1"></i>
                </a>
            </div>

            <div class="row g-4">
                @foreach (var hosp in Model.FeaturedHospitals)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card-modern p-4 h-100 d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="fw-bold text-dark mb-0" style="font-size:1rem;">@hosp.Name</h5>
                                <span class="badge-soft-primary flex-shrink-0 ms-2">@hosp.City</span>
                            </div>
                            <p class="text-muted small mb-3">
                                <i class="fas fa-map-marker-alt text-danger me-1"></i>@hosp.Address
                            </p>

                            <div class="row g-0 text-center mb-3 rounded overflow-hidden"
                                 style="border:1px solid #f1f5f9; background:#f8fafc;">
                                <div class="col-6 py-3 border-end">
                                    <small class="text-muted d-block fw-semibold">Emergency Beds</small>
                                    <span class="fw-bold text-success" style="font-size:1.4rem;">
                                        @hosp.AvailableEmergencyBeds
                                    </span>
                                    <small class="text-muted"> / @hosp.TotalEmergencyBeds</small>
                                </div>
                                <div class="col-6 py-3">
                                    <small class="text-muted d-block fw-semibold">ICU Beds</small>
                                    <span class="fw-bold text-danger" style="font-size:1.4rem;">
                                        @hosp.AvailableIcuBeds
                                    </span>
                                    <small class="text-muted"> / @hosp.TotalIcuBeds</small>
                                </div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center pt-3 border-top mt-auto">
                                <span class="small fw-semibold text-danger">
                                    <i class="fas fa-phone me-1"></i>@hosp.EmergencyHelpline
                                </span>
                                <a href="tel:@hosp.EmergencyHelpline" class="btn btn-sm btn-brand-red">
                                    Call Helpline
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}

@* ══════════════════════════════════════════════════
   CTA BANNER — Full width
   ══════════════════════════════════════════════════ *@
<section class="cta-section section-full">
    <div class="container" style="position:relative; z-index:1;">
        <h2>Be a Lifesaver. Be a Hero.</h2>
        <p>
            Every blood donation can save up to 3 precious lives. Join our voluntary lifesaver
            network today and make a real difference in someone's hour of need.
        </p>
        <div class="d-flex justify-content-center flex-wrap gap-3">
            <a asp-controller="Account" asp-action="Register"
               class="btn btn-light rounded-pill fw-bold px-4 shadow" style="color:var(--brand);">
                <i class="fas fa-heart me-1"></i> Register as a Donor
            </a>
            <a asp-controller="Home" asp-action="About"
               class="btn btn-outline-light rounded-pill px-4 fw-semibold">
                Learn How It Works
            </a>
        </div>
    </div>
</section>
