@model BBDMS.Model.Models.ViewModels.HomeIndexViewModel
@using System.Linq
@{
    ViewData["Title"] = "Find blood and emergency help";
    var helpline = Model.ContactInfo != null && !string.IsNullOrEmpty(Model.ContactInfo.ContactNo)
        ? Model.ContactInfo.ContactNo : "999";

    var donors = (Model.ActiveDonors ?? Enumerable.Empty<BBDMS.Model.Models.Entities.BloodDonor>()).Take(8).ToList();
    var urgent = (Model.UrgentRequests ?? Enumerable.Empty<BBDMS.Model.Models.Entities.BloodRequest>()).Take(3).ToList();
    var hospitals = (Model.FeaturedHospitals ?? Enumerable.Empty<BBDMS.Model.Models.Entities.Hospital>()).Take(3).ToList();

    var services = new[]
    {
        new { Ctrl = "Donor", Act = "Search", Icon = "fa-droplet", Name = "Blood donors", Note = "Find a compatible donor by group and city", Count = Model.TotalDonors, Unit = "registered" },
        new { Ctrl = "Emergency", Act = "Hospitals", Icon = "fa-hospital", Name = "Hospitals & ICU", Note = "Live emergency and critical-care capacity", Count = Model.TotalHospitals, Unit = "facilities" },
        new { Ctrl = "Emergency", Act = "BloodBanks", Icon = "fa-building", Name = "Blood banks", Note = "Check stock across registered centres", Count = Model.TotalBloodBanks, Unit = "centres" },
        new { Ctrl = "Emergency", Act = "Ambulances", Icon = "fa-ambulance", Name = "Ambulance", Note = "Request rapid patient transport", Count = Model.TotalAmbulances, Unit = "vehicles" },
        new { Ctrl = "Emergency", Act = "Oxygen", Icon = "fa-lungs", Name = "Medical oxygen", Note = "Cylinder supply, refills and delivery", Count = Model.TotalOxygenSuppliers, Unit = "providers" }
    };
}

@* ═══════════════════════════ HERO ═══════════════════════════ *@
<section class="hero">
    <div class="container">
        <div class="hero-grid">
            <div class="hero-copy">
                <p class="eyebrow"><span class="live-dot" aria-hidden="true" style="margin-right:2px"></span> National blood &amp; emergency network</p>

                <h1 class="hero-title">
                    <span class="hero-line"><span style="--mo-delay:60ms">Find blood.</span></span>
                    <span class="hero-line"><span style="--mo-delay:180ms"><em>Save a life.</em></span></span>
                </h1>

                <p class="hero-lede">
                    Donors, hospitals, blood banks, ambulances and medical oxygen — one trusted
                    platform for the moments when every minute matters.
                </p>

                <div class="hero-actions">
                    <a asp-controller="Donor" asp-action="Search" class="btn btn-blood btn-lg" data-magnetic>
                        <i class="fas fa-droplet" aria-hidden="true"></i> Find blood
                        <span class="sheen" aria-hidden="true"></span>
                    </a>
                    <a asp-controller="Emergency" asp-action="Index" class="btn btn-ghost btn-lg">
                        Emergency help <i class="fas fa-arrow-right" aria-hidden="true"></i>
                    </a>
                </div>

                <form asp-controller="Donor" asp-action="Search" method="get" class="intake" role="search" aria-label="Donor search">
                    <div class="intake-grid">
                        <div>
                            <label for="heroGroup">Blood group</label>
                            <select id="heroGroup" name="bloodGroup" class="form-select">
                                <option value="">Any group</option>
                                @if (Model.BloodGroups != null)
                                {
                                    foreach (var bg in Model.BloodGroups)
                                    {
                                        <option value="@bg.GroupName">@bg.GroupName</option>
                                    }
                                }
                            </select>
                        </div>
                        <div>
                            <label for="heroLocation">City or area</label>
                            <input id="heroLocation" type="text" name="location" class="form-control" placeholder="e.g. Dhaka, Chattogram" autocomplete="address-level2" />
                        </div>
                        <button type="submit" class="btn btn-ink">
                            Search <i class="fas fa-arrow-right" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div class="intake-foot">
                        <span><i class="fas fa-shield-halved" aria-hidden="true" style="color:var(--signal);margin-right:4px"></i> Contact details are shared only with signed-in donors.</span>
                        <a class="link-arrow" asp-controller="Home" asp-action="Compatibility" style="font-size:.8rem">Compatibility guide</a>
                    </div>
                </form>
            </div>

            @* ── Live emergency board ── *@
            <aside class="board" aria-label="Active emergency blood requests">
                <div class="board-head">
                    <h2 class="board-title">Active emergency requests</h2>
                    @if (urgent.Any())
                    {
                        <span class="live-pill"><span class="live-dot" aria-hidden="true"></span> Live</span>
                    }
                    else
                    {
                        <span class="live-pill is-idle"><span class="live-dot" aria-hidden="true"></span> Clear</span>
                    }
                </div>

                <div class="board-body">
                    @if (urgent.Any())
                    {
                        foreach (var req in urgent)
                        {
                            var group = req.BloodGroup ?? req.BloodRequireFor;
                            var critical = req.Urgency != null && req.Urgency.Contains("Critical", StringComparison.OrdinalIgnoreCase);
                            <a class="board-row" asp-controller="Emergency" asp-action="RequestDetails" asp-route-id="@req.ID">
                                <span class="board-group">@group</span>
                                <span style="min-width:0">
                                    <span class="board-name">@(string.IsNullOrEmpty(req.HospitalName) ? "Emergency ward" : req.HospitalName)</span>
                                    <span class="board-meta">
                                        @(string.IsNullOrEmpty(req.Location) ? "Location on request" : req.Location)
                                        · @req.UnitsRequired unit@(req.UnitsRequired > 1 ? "s" : "")
                                        · @(req.ApplyDate.HasValue ? req.ApplyDate.Value.ToString("dd MMM") : "today")
                                    </span>
                                </span>
                                <span class="board-go" aria-hidden="true"><i class="fas fa-arrow-right"></i></span>
                            </a>
                        }
                    }
                    else
                    {
                        <div class="board-empty">
                            <i class="fas fa-circle-check" aria-hidden="true"></i>
                            <p>No open emergency requests right now.</p>
                            <span class="meta" style="color:rgba(255,246,238,.45)">New requests appear here in real time.</span>
                        </div>
                    }
                </div>

                <div class="board-stats">
                    <div class="board-stat"><b data-count-to="@Model.TotalDonors">@Model.TotalDonors</b><span>Donors</span></div>
                    <div class="board-stat"><b data-count-to="@Model.TotalAvailableIcuBeds">@Model.TotalAvailableIcuBeds</b><span>ICU beds free</span></div>
                    <div class="board-stat"><b data-count-to="@Model.TotalAmbulances">@Model.TotalAmbulances</b><span>Ambulances</span></div>
                </div>

                <div class="board-foot">
                    <a class="link-arrow" asp-controller="Emergency" asp-action="BloodRequests" style="font-size:.8rem">
                        All requests <i class="fas fa-arrow-right" aria-hidden="true"></i>
                    </a>
                    <span class="meta">@Model.TotalActiveRequests open</span>
                </div>

                <a class="board-helpline" href="tel:@helpline">
                    <i class="fas fa-phone-volume" aria-hidden="true"></i>
                    <span class="lbl">24/7 helpline</span>
                    <span class="tel">@helpline</span>
                </a>
            </aside>
        </div>
    </div>
</section>

@* ═══════════════════════════ NETWORK AT A GLANCE ═══════════════════════════ *@
<section class="section-tight band-surface rule-bottom" id="network" aria-label="Network at a glance" style="padding-top:0;padding-bottom:0">
    <div class="container">
        <div class="stat-strip" data-motion-stagger>
            <div class="stat-cell">
                <span class="stat-val" data-count-to="@Model.TotalDonors">@Model.TotalDonors</span>
                <span class="stat-cap">Registered donors</span>
            </div>
            <div class="stat-cell">
                <span class="stat-val" data-count-to="@Model.TotalHospitals">@Model.TotalHospitals</span>
                <span class="stat-cap">Hospitals</span>
            </div>
            <div class="stat-cell">
                <span class="stat-val" data-count-to="@Model.TotalAvailableIcuBeds">@Model.TotalAvailableIcuBeds</span>
                <span class="stat-cap">ICU beds free</span>
            </div>
            <div class="stat-cell">
                <span class="stat-val" data-count-to="@Model.TotalAvailableEmergencyBeds">@Model.TotalAvailableEmergencyBeds</span>
                <span class="stat-cap">Emergency beds</span>
            </div>
            <div class="stat-cell">
                <span class="stat-val" data-count-to="@Model.TotalBloodBanks">@Model.TotalBloodBanks</span>
                <span class="stat-cap">Blood banks</span>
            </div>
            <div class="stat-cell">
                <span class="stat-val" data-count-to="@Model.TotalAmbulances">@Model.TotalAmbulances</span>
                <span class="stat-cap">Ambulances</span>
            </div>
            <div class="stat-cell">
                <span class="stat-val" data-count-to="@Model.TotalActiveRequests">@Model.TotalActiveRequests</span>
                <span class="stat-cap">Active requests</span>
            </div>
        </div>
    </div>
</section>

@* ═══════════════════════════ SERVICE INDEX ═══════════════════════════ *@
<section class="section" id="services" aria-labelledby="servicesHeading">
    <div class="container">
        <div class="section-head">
            <div class="section-head-copy">
                <p class="eyebrow">What you need, when you need it</p>
                <h2 id="servicesHeading" class="section-title">Five services. One emergency network.</h2>
            </div>
            <a class="link-arrow" asp-controller="Emergency" asp-action="Index">
                Open the emergency hub <i class="fas fa-arrow-right" aria-hidden="true"></i>
            </a>
        </div>

        <div class="service-index" data-motion-stagger>
            @foreach (var s in services)
            {
                <a class="service-cell" asp-controller="@s.Ctrl" asp-action="@s.Act">
                    <span class="ico"><i class="fas @s.Icon" aria-hidden="true"></i></span>
                    <span>
                        <span class="svc-name d-block">@s.Name</span>
                        <span class="svc-note d-block">@s.Note</span>
                    </span>
                    <span class="svc-count">
                        <span><span class="num">@s.Count</span> @s.Unit</span>
                        <i class="fas fa-arrow-right" aria-hidden="true"></i>
                    </span>
                </a>
            }
        </div>
    </div>
</section>

@* ═══════════════════════════ BLOOD GROUP INDEX ═══════════════════════════ *@
@if (Model.BloodGroups != null && Model.BloodGroups.Any())
{
    <section class="group-band" id="groups" aria-labelledby="groupsHeading">
        <div class="container">
            <div class="section-head" style="margin-bottom:32px">
                <div class="section-head-copy">
                    <p class="eyebrow">Blood group index</p>
                    <h2 id="groupsHeading" class="section-title">Start with your group.</h2>
                </div>
                <p class="section-sub" style="max-width:34ch">
                    Pick a blood group to see every registered donor who can help, then filter by city.
                </p>
            </div>

            <div class="group-grid" data-motion-stagger>
                @foreach (var bg in Model.BloodGroups)
                {
                    <a class="group-cell" asp-controller="Donor" asp-action="Search" asp-route-bloodGroup="@bg.GroupName"
                       aria-label="Find @bg.GroupName donors">
                        <span class="g">@bg.GroupName</span>
                        <span class="lbl">Find donors <i class="fas fa-arrow-right" aria-hidden="true"></i></span>
                    </a>
                }
            </div>
        </div>
    </section>
}

@* ═══════════════════════════ DONOR LEDGER ═══════════════════════════ *@
<section class="section" id="donors" aria-labelledby="donorsHeading">
    <div class="container">
        <div class="section-head">
            <div class="section-head-copy">
                <p class="eyebrow">Available now</p>
                <h2 id="donorsHeading" class="section-title">Lifesavers in the network.</h2>
                <p class="section-sub">Voluntary donors registered with us. Contact details are visible to signed-in donors only.</p>
            </div>
            <a class="link-arrow" asp-controller="Donor" asp-action="Search">
                Search all donors <i class="fas fa-arrow-right" aria-hidden="true"></i>
            </a>
        </div>

        @if (donors.Any())
        {
            var perColumn = (int)Math.Ceiling(donors.Count / 2.0);
            <div class="row g-4">
                @for (var col = 0; col < 2; col++)
                {
                    <div class="col-lg-6">
                        <div class="ledger">
                            @foreach (var donor in donors.Skip(col * perColumn).Take(perColumn))
                            {
                                var initials = string.Concat((donor.FullName ?? "D").Split(' ').Where(p => p.Length > 0).Take(2).Select(p => p[0])).ToUpper();
                                <div class="ledger-row" data-motion>
                                    <span class="ledger-group">@donor.BloodGroup</span>
                                    <div class="ledger-main" style="min-width:0">
                                        <p class="ledger-name text-truncate">@donor.FullName</p>
                                        <p class="ledger-sub">
                                            <i class="fas fa-location-dot" aria-hidden="true"></i>
                                            <span class="text-truncate">@(string.IsNullOrEmpty(donor.Address) ? "Location on request" : donor.Address)</span>
                                            <span aria-hidden="true">·</span>
                                            <span>@donor.Gender@(donor.Age.HasValue ? ", " + donor.Age + " yrs" : "")</span>
                                        </p>
                                    </div>
                                    <div class="ledger-right">
                                        <span class="tag @(donor.IsAvailable ? "tag-ok" : "tag-muted")">@(donor.IsAvailable ? "Available" : "Registered")</span>
                                        @if (!string.IsNullOrEmpty(donor.MobileNumber))
                                        {
                                            <a class="ledger-call" href="tel:@donor.MobileNumber" aria-label="Call @donor.FullName">
                                                <i class="fas fa-phone" aria-hidden="true"></i>
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="ledger-call is-locked" title="Sign in to view contact details" aria-label="Contact hidden">
                                                <i class="fas fa-lock" aria-hidden="true"></i>
                                            </span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="fas fa-user-plus" aria-hidden="true"></i>
                <h4>No donors listed yet</h4>
                <p>Be the first in your area to join the network and receive emergency match notifications.</p>
                <a class="btn btn-blood" asp-controller="Account" asp-action="Register">
                    <i class="fas fa-droplet" aria-hidden="true"></i> Become a donor
                </a>
            </div>
        }
    </div>
</section>

@* ═══════════════════════════ HOSPITAL CAPACITY ═══════════════════════════ *@
@if (hospitals.Any())
{
    <section class="section band-surface rule-top rule-bottom" id="capacity" aria-labelledby="capacityHeading">
        <div class="container">
            <div class="section-head">
                <div class="section-head-copy">
                    <p class="eyebrow">Live capacity</p>
                    <h2 id="capacityHeading" class="section-title">Beds you can count on.</h2>
                    <p class="section-sub">Emergency and intensive-care availability reported by registered hospitals.</p>
                </div>
                <a class="link-arrow" asp-controller="Emergency" asp-action="Hospitals">
                    All hospitals <i class="fas fa-arrow-right" aria-hidden="true"></i>
                </a>
            </div>

            <div class="capacity-grid" data-motion-stagger>
                @foreach (var hosp in hospitals)
                {
                    var icuTotal = hosp.TotalIcuBeds <= 0 ? 1 : hosp.TotalIcuBeds;
                    var erTotal = hosp.TotalEmergencyBeds <= 0 ? 1 : hosp.TotalEmergencyBeds;
                    var icuPct = Math.Round(Math.Clamp((double)hosp.AvailableIcuBeds / icuTotal * 100, 0, 100));
                    var erPct = Math.Round(Math.Clamp((double)hosp.AvailableEmergencyBeds / erTotal * 100, 0, 100));
                    var icuClass = icuPct < 25 ? "is-low" : icuPct < 60 ? "is-mid" : "";
                    var erClass = erPct < 25 ? "is-low" : erPct < 60 ? "is-mid" : "";

                    <article class="capacity-card">
                        <div>
                            <h3 class="capacity-name">@hosp.Name</h3>
                            <p class="capacity-loc">
                                <i class="fas fa-location-dot" aria-hidden="true"></i>
                                <span>@hosp.City@(string.IsNullOrEmpty(hosp.Address) ? "" : " · " + hosp.Address)</span>
                            </p>
                        </div>

                        <div>
                            <div class="meter">
                                <div class="meter-head">
                                    <span class="meter-label">ICU beds</span>
                                    <span class="meter-value"><b>@hosp.AvailableIcuBeds</b> / @hosp.TotalIcuBeds</span>
                                </div>
                                <div class="meter-track" role="img" aria-label="@hosp.AvailableIcuBeds of @hosp.TotalIcuBeds ICU beds available">
                                    <span class="meter-fill @icuClass" style="width:@icuPct%"></span>
                                </div>
                            </div>
                            <div class="meter">
                                <div class="meter-head">
                                    <span class="meter-label">Emergency beds</span>
                                    <span class="meter-value"><b>@hosp.AvailableEmergencyBeds</b> / @hosp.TotalEmergencyBeds</span>
                                </div>
                                <div class="meter-track" role="img" aria-label="@hosp.AvailableEmergencyBeds of @hosp.TotalEmergencyBeds emergency beds available">
                                    <span class="meter-fill @erClass" style="width:@erPct%"></span>
                                </div>
                            </div>
                        </div>

                        <div class="capacity-foot">
                            @if (!string.IsNullOrEmpty(hosp.EmergencyHelpline))
                            {
                                <a class="capacity-tel" href="tel:@hosp.EmergencyHelpline">
                                    <i class="fas fa-phone" aria-hidden="true"></i> @hosp.EmergencyHelpline
                                </a>
                            }
                            else
                            {
                                <span class="capacity-tel" style="color:var(--muted)">Helpline on profile</span>
                            }
                            <a class="btn btn-ghost btn-sm" asp-controller="Emergency" asp-action="Hospitals">Details</a>
                        </div>
                    </article>
                }
            </div>
        </div>
    </section>
}

@* ═══════════════════════════ ELIGIBILITY ═══════════════════════════ *@
<section class="section" id="eligibility" aria-labelledby="eligibilityHeading">
    <div class="container">
        <div class="eligibility" data-motion>
            <div class="eligibility-copy">
                <p class="eyebrow">Before you donate</p>
                <h2 id="eligibilityHeading">Can you give blood today?</h2>
                <p class="section-sub" style="margin-bottom:24px">
                    A quick self-check against the criteria our donor network uses. If something does not
                    match, the compatibility guide explains what to do next — and when you can donate.
                </p>
                <div class="d-flex flex-wrap gap-3">
                    <a class="btn btn-blood" asp-controller="Home" asp-action="Compatibility">
                        <i class="fas fa-droplet" aria-hidden="true"></i> Open compatibility guide
                    </a>
                    <a class="btn btn-ghost" asp-controller="Donor" asp-action="Search">
                        See who can help now
                    </a>
                </div>
            </div>

            <div class="eligibility-side">
                <div>
                    <h6>Standard criteria</h6>
                    <ul class="check-list">
                        <li><i class="fas fa-check" aria-hidden="true"></i><span>Aged between 18 and 65 years</span></li>
                        <li><i class="fas fa-check" aria-hidden="true"></i><span>Weighing 50&nbsp;kg or more</span></li>
                        <li><i class="fas fa-check" aria-hidden="true"></i><span>At least 90 days since your last donation</span></li>
                        <li><i class="fas fa-check" aria-hidden="true"></i><span>Feeling well — no fever or active infection</span></li>
                    </ul>
                </div>
                <p class="meta" style="margin:0">Final eligibility is confirmed at the donation centre.</p>
            </div>
        </div>
    </div>
</section>

@* ═══════════════════════════ HOW IT WORKS ═══════════════════════════ *@
<section class="section band-sand rule-top rule-bottom" id="how" aria-labelledby="howHeading">
    <div class="container">
        <div class="section-head">
            <div class="section-head-copy">
                <p class="eyebrow">How the network works</p>
                <h2 id="howHeading" class="section-title">Three steps from search to care.</h2>
            </div>
        </div>

        <div class="steps" data-motion-stagger>
            <div class="step">
                <span class="step-num">01 <i class="fas fa-magnifying-glass ico ms-auto" aria-hidden="true"></i></span>
                <h3>Search by group and city</h3>
                <p>Filter verified donors by blood group and location, or open the emergency hub for facilities near you.</p>
            </div>
            <div class="step">
                <span class="step-num">02 <i class="fas fa-phone ico ms-auto" aria-hidden="true"></i></span>
                <h3>Contact the donor or request blood</h3>
                <p>Signed-in donors see contact details. Otherwise, publish a request and let compatible donors reach you.</p>
            </div>
            <div class="step">
                <span class="step-num">03 <i class="fas fa-hospital ico ms-auto" aria-hidden="true"></i></span>
                <h3>Coordinate with the hospital</h3>
                <p>Match with a hospital or blood bank, and request an ambulance if transport is the missing piece.</p>
            </div>
        </div>
    </div>
</section>

@* ═══════════════════════════ CTA ═══════════════════════════ *@
<section class="cta-band" id="join">
    <span class="cta-mark" aria-hidden="true">Life.</span>
    <div class="container">
        <div class="row align-items-end g-4">
            <div class="col-lg-7">
                <p class="eyebrow">Join the network</p>
                <h2>Your donation could be someone's <em>only option.</em></h2>
                <p>
                    Register once and we will only reach out when a patient with a compatible group
                    needs you. One donation can support up to three people.
                </p>
                <div class="cta-row">
                    <a class="btn btn-blood btn-lg" asp-controller="Account" asp-action="Register" data-magnetic>
                        <i class="fas fa-heart" aria-hidden="true"></i> Register as a donor
                        <span class="sheen" aria-hidden="true"></span>
                    </a>
                    <a class="btn btn-on-ink btn-lg" asp-controller="Home" asp-action="About">
                        How we work
                    </a>
                </div>
            </div>
            <div class="col-lg-5">
                <div style="border-top:1px solid rgba(255,246,238,.16);padding-top:20px;display:grid;gap:14px">
                    <div class="d-flex justify-content-between align-items-baseline gap-3">
                        <span class="meta" style="color:rgba(255,246,238,.5)">Emergency helpline</span>
                        <a href="tel:@helpline" class="num" style="color:#fff;font-size:1.1rem">@helpline</a>
                    </div>
                    <div class="d-flex justify-content-between align-items-baseline gap-3">
                        <span class="meta" style="color:rgba(255,246,238,.5)">Blood requests open</span>
                        <span class="num" style="color:#ffb3bd;font-size:1.1rem">@Model.TotalActiveRequests</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-baseline gap-3">
                        <span class="meta" style="color:rgba(255,246,238,.5)">Donors registered</span>
                        <span class="num" style="color:#fff;font-size:1.1rem">@Model.TotalDonors</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
