@model BBDMS.Model.Models.Entities.PageContent
@using System.Linq
@{
    ViewData["Title"] = "About the network";
    var allPages = ViewBag.AllPages as IEnumerable<BBDMS.Model.Models.Entities.PageContent>;
    var cmsPages = allPages?
        .Where(p => !string.IsNullOrWhiteSpace(p.Detail))
        .Where(p => Model == null || p.Id != Model.Id)
        .ToList() ?? new List<BBDMS.Model.Models.Entities.PageContent>();
}

<section class="page-head">
    <div class="container">
        <nav aria-label="Breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item active" aria-current="page">About</li>
            </ol>
        </nav>
        <div class="page-head-row">
            <div>
                <p class="eyebrow">Who we are</p>
                <h1>@(Model?.PageName ?? "About the network")</h1>
                <p>Connecting voluntary blood donors, emergency hospitals, ambulance fleets and oxygen suppliers across the country.</p>
            </div>
            <div class="page-head-actions">
                <a class="btn btn-ghost" asp-controller="Home" asp-action="Contact">Talk to our team</a>
                <a class="btn btn-blood" asp-controller="Account" asp-action="Register">
                    <i class="fas fa-droplet" aria-hidden="true"></i> Register as a donor
                </a>
            </div>
        </div>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="row g-5 align-items-start">
            <div class="col-lg-7">
                <p class="lead-display">
                    A patient should never wait for blood because the right person could not be found
                    <em>in time.</em>
                </p>
                <p style="font-size:1.02rem;color:var(--text);max-width:62ch">
                    BloodBank is an emergency healthcare network. It brings the pieces that usually sit in
                    separate systems — donor registries, hospital bed counts, blood bank stock, ambulances and
                    oxygen suppliers — into one searchable place, so families and clinicians can act quickly.
                </p>
                <p style="font-size:1.02rem;color:var(--text);max-width:62ch">
                    Voluntary donors stay in control: contact details are only visible to signed-in donors,
                    and requests are shared without exposing patient identity in public listings.
                </p>
            </div>
            <div class="col-lg-5">
                <div class="panel" style="padding:0">
                    <div style="padding:22px 24px;border-bottom:1px solid var(--line)">
                        <p class="eyebrow" style="margin:0 0 6px">What we operate</p>
                        <p style="margin:0;font-size:.9rem;color:var(--muted)">Five connected directories, one emergency workflow.</p>
                    </div>
                    <div class="quick-grid" style="border:0">
                        <a class="quick-cell" asp-controller="Donor" asp-action="Search">
                            <span class="ico"><i class="fas fa-droplet" aria-hidden="true"></i></span>
                            <span><span class="t">Donors</span><span class="s">Verified, voluntary</span></span>
                        </a>
                        <a class="quick-cell" asp-controller="Emergency" asp-action="Hospitals">
                            <span class="ico"><i class="fas fa-hospital" aria-hidden="true"></i></span>
                            <span><span class="t">Hospitals</span><span class="s">ICU capacity</span></span>
                        </a>
                        <a class="quick-cell" asp-controller="Emergency" asp-action="BloodBanks">
                            <span class="ico"><i class="fas fa-building" aria-hidden="true"></i></span>
                            <span><span class="t">Blood banks</span><span class="s">Stock by group</span></span>
                        </a>
                        <a class="quick-cell" asp-controller="Emergency" asp-action="Ambulances">
                            <span class="ico"><i class="fas fa-ambulance" aria-hidden="true"></i></span>
                            <span><span class="t">Ambulances</span><span class="s">Dispatch + tracking</span></span>
                        </a>
                    </div>
                    <div style="padding:20px 24px;border-top:1px solid var(--line)">
                        <a class="link-arrow" asp-controller="Emergency" asp-action="Index">Open the emergency hub <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section band-sand rule-top rule-bottom">
    <div class="container">
        <div class="section-head">
            <div class="section-head-copy">
                <p class="eyebrow">What guides us</p>
                <h2 class="section-title">Mission, vision and values</h2>
            </div>
        </div>
        <div class="steps" data-motion-stagger>
            <div class="step">
                <span class="step-num">01 <i class="fas fa-bullseye ico ms-auto" aria-hidden="true"></i></span>
                <h3>Our mission</h3>
                <p>Make voluntary blood donation, ICU bed discovery, ambulance fleets and medical oxygen accessible to everyone in seconds.</p>
            </div>
            <div class="step">
                <span class="step-num">02 <i class="fas fa-eye ico ms-auto" aria-hidden="true"></i></span>
                <h3>Our vision</h3>
                <p>A country where no patient suffers or loses a life because compatible blood, critical care or transport could not be found.</p>
            </div>
            <div class="step">
                <span class="step-num">03 <i class="fas fa-hand-holding-heart ico ms-auto" aria-hidden="true"></i></span>
                <h3>Our values</h3>
                <p>Humanity, reliability, data integrity, transparency and rapid community cooperation when every second counts.</p>
            </div>
        </div>
    </div>
</section>

@if (Model != null && !string.IsNullOrWhiteSpace(Model.Detail))
{
    <section class="section">
        <div class="container">
            <div class="row g-5">
                <div class="col-lg-4">
                    <p class="eyebrow">In detail</p>
                    <h2 class="section-title" style="font-size:clamp(1.6rem,2.6vw,2.1rem)">@Model.PageName</h2>
                    <p class="section-sub">Published by the network team and updated from the admin console.</p>
                </div>
                <div class="col-lg-8">
                    <div class="prose">
                        @Html.Raw(BBDMS.Web.Common.HtmlSanitizerHelper.Sanitize(Model.Detail))
                    </div>
                </div>
            </div>
        </div>
    </section>
}

@if (cmsPages.Any())
{
    <section class="section band-surface rule-top">
        <div class="container">
            <div class="row g-4">
                @foreach (var pageItem in cmsPages)
                {
                    <div class="col-lg-6">
                        <article class="panel h-100" data-motion>
                            <p class="eyebrow">@(pageItem.Type == "aboutus" ? "Background" : "Policy")</p>
                            <h3 class="section-title" style="font-size:1.45rem">@pageItem.PageName</h3>
                            <div class="prose" style="font-size:.94rem">
                                @Html.Raw(BBDMS.Web.Common.HtmlSanitizerHelper.Sanitize(pageItem.Detail))
                            </div>
                        </article>
                    </div>
                }
            </div>
        </div>
    </section>
}

<section class="cta-band">
    <div class="container">
        <p class="eyebrow">Get involved</p>
        <h2>Join a network built on <em>people.</em></h2>
        <p>Donate blood, list an emergency service, or partner with us. Every registration makes the next search faster.</p>
        <div class="cta-row">
            <a class="btn btn-blood btn-lg" asp-controller="Account" asp-action="Register">
                <i class="fas fa-droplet" aria-hidden="true"></i> Register as a donor
            </a>
            <a class="btn btn-on-ink btn-lg" asp-controller="Home" asp-action="Contact">Contact our team</a>
        </div>
    </div>
</section>
