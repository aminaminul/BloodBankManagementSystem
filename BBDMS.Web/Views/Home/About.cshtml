@model BBDMS.Model.Models.Entities.PageContent
@{
    ViewData["Title"] = "About Us - Blood Bank";
    var allPages = ViewBag.AllPages as IEnumerable<BBDMS.Model.Models.Entities.PageContent>;
}

<section class="page-hero-sm" style="background:linear-gradient(135deg,#e63946 0%,#9b1a26 100%); color:#fff; padding:56px 0 40px;">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-2" style="background:transparent; padding:0;">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-white-50">Home</a></li>
                <li class="breadcrumb-item active text-white" aria-current="page">About Us</li>
            </ol>
        </nav>
        <h1 class="fw-bold mb-1" style="font-size:2rem;">@(Model?.PageName ?? "About Us")</h1>
        <p class="mb-0 text-white-50">Connecting voluntary blood donors, emergency hospitals, and healthcare facilities across the nation.</p>
    </div>
</section>

<section class="py-5" style="background:#f8fafc;">
    <div class="container py-2">

        <!-- 3 Core Pillars -->
        <div class="row g-4 mb-5">
            <div class="col-md-4">
                <div class="card-modern h-100 p-4 text-center">
                    <div class="service-icon-box mx-auto mb-3">
                        <i class="fas fa-bullseye"></i>
                    </div>
                    <h5 class="fw-bold mb-2">Our Mission</h5>
                    <p class="text-muted small mb-0">
                        To save lives by making voluntary blood donation, hospital ICU bed discovery, ambulance fleets, and medical oxygen accessible for everyone in seconds.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card-modern h-100 p-4 text-center">
                    <div class="service-icon-box mx-auto mb-3">
                        <i class="fas fa-eye"></i>
                    </div>
                    <h5 class="fw-bold mb-2">Our Vision</h5>
                    <p class="text-muted small mb-0">
                        A nation where no patient suffers or loses precious life due to a shortage of compatible blood, critical care beds, or emergency medical transport.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card-modern h-100 p-4 text-center">
                    <div class="service-icon-box mx-auto mb-3">
                        <i class="fas fa-hand-holding-heart"></i>
                    </div>
                    <h5 class="fw-bold mb-2">Our Values</h5>
                    <p class="text-muted small mb-0">
                        Humanity, reliability, data integrity, transparency, and rapid community cooperation to deliver healthcare when every second counts.
                    </p>
                </div>
            </div>
        </div>

        <!-- Database CMS Content Sections -->
        @if (allPages != null && allPages.Any())
        {
            foreach (var pageItem in allPages)
            {
                <div class="card-modern p-4 p-md-5 mb-4">
                    <h4 class="fw-bold text-dark mb-3">
                        <i class="fas @(pageItem.Type == "aboutus" ? "fa-info-circle text-danger" : "fa-tint text-danger") me-2"></i>@pageItem.PageName
                    </h4>
                    <div class="text-muted" style="line-height: 1.8;">
                        @Html.Raw(BBDMS.Web.Common.HtmlSanitizerHelper.Sanitize(pageItem.Detail))
                    </div>
                </div>
            }
        }
        else if (Model != null)
        {
            <div class="card-modern p-4 p-md-5 mb-4">
                <h4 class="fw-bold text-dark mb-3"><i class="fas fa-info-circle text-danger me-2"></i>@Model.PageName</h4>
                <div class="text-muted" style="line-height: 1.8;">
                    @Html.Raw(BBDMS.Web.Common.HtmlSanitizerHelper.Sanitize(Model.Detail))
                </div>
            </div>
        }

        <!-- Call to action -->
        <div class="card border-0 text-white p-4 p-md-5 text-center mt-4" style="background: linear-gradient(135deg, #b91c1c, #e63946); border-radius: 20px;">
            <h3 class="fw-bold text-white mb-2">Want to Join Our Lifesaver Mission?</h3>
            <p class="text-white-50 mb-4 mx-auto" style="max-width: 600px;">
                Whether you want to donate blood, list an emergency service, or partner with us, your involvement saves lives.
            </p>
            <div class="d-flex justify-content-center flex-wrap gap-2">
                <a asp-controller="Account" asp-action="Register" class="btn btn-light rounded-pill fw-bold text-danger px-4 shadow">
                    Register as a Donor
                </a>
                <a asp-controller="Home" asp-action="Contact" class="btn btn-outline-light rounded-pill px-4">
                    Contact Our Team
                </a>
            </div>
        </div>

    </div>
</section>
