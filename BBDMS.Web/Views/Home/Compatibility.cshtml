@{
    ViewData["Title"] = "Compatibility & eligibility";
    var groups = new[] { "O-", "O+", "A-", "A+", "B-", "B+", "AB-", "AB+" };
}

<section class="page-head">
    <div class="container">
        <nav aria-label="Breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item active" aria-current="page">Compatibility</li>
            </ol>
        </nav>
        <div class="page-head-row">
            <div>
                <p class="eyebrow">Know before you donate</p>
                <h1>Blood compatibility</h1>
                <p>Pick a blood group to see who it can help and where it can come from — then run the four-question self-check.</p>
            </div>
            <div class="page-head-actions">
                <a class="btn btn-blood" asp-controller="Account" asp-action="Register">
                    <i class="fas fa-droplet" aria-hidden="true"></i> Register as a donor
                </a>
            </div>
        </div>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="row g-4">

            @* ── Matrix ── *@
            <div class="col-lg-7">
                <div class="panel h-100">
                    <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-4">
                        <div>
                            <p class="eyebrow" style="margin-bottom:8px">Compatibility matrix</p>
                            <h2 class="section-title" style="font-size:1.6rem">Red cell matching</h2>
                        </div>
                        <span class="tag tag-muted">Whole blood</span>
                    </div>

                    <label id="groupSelectorLabel">Choose a blood group</label>
                    <div class="group-picker mb-4" id="groupSelector" role="group" aria-labelledby="groupSelectorLabel">
                        @foreach (var bg in groups)
                        {
                            <button type="button" class="group-btn @(bg == "O+" ? "active" : "")"
                                    data-group="@bg" aria-pressed="@(bg == "O+" ? "true" : "false")">@bg</button>
                        }
                    </div>

                    <div class="group-highlight mb-4" id="groupHighlightCard">
                        <div>
                            <span class="sel">Selected type</span>
                            <h2 id="currentGroupTitle">O+ (O Positive)</h2>
                            <p id="currentGroupSubtitle">One of the most frequently needed blood types</p>
                        </div>
                        <span class="tag tag-blood" id="universalBadge">High demand</span>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="panel panel-quiet h-100" style="padding:18px">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <i class="fas fa-arrow-up-right-from-square" aria-hidden="true" style="color:var(--signal);font-size:.85rem"></i>
                                    <h3 style="font-size:.9rem;font-weight:600;margin:0">Can donate to</h3>
                                </div>
                                <p class="section-sub" style="font-size:.8rem;margin-bottom:10px">Red cells can safely be given to:</p>
                                <div class="d-flex flex-wrap gap-2" id="donateToList"></div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="panel panel-quiet h-100" style="padding:18px">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <i class="fas fa-arrow-down-left" aria-hidden="true" style="color:var(--blood);font-size:.85rem"></i>
                                    <h3 style="font-size:.9rem;font-weight:600;margin:0">Can receive from</h3>
                                </div>
                                <p class="section-sub" style="font-size:.8rem;margin-bottom:10px">Can receive red cells from:</p>
                                <div class="d-flex flex-wrap gap-2" id="receiveFromList"></div>
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-info mt-4 mb-0">
                        <i class="fas fa-circle-info" aria-hidden="true"></i>
                        <strong>Did you know?</strong> While <strong>O−</strong> is the universal red cell donor,
                        <strong>AB+</strong> is the universal plasma donor — AB plasma carries no anti-A or anti-B antibodies.
                    </div>
                </div>
            </div>

            @* ── Self check ── *@
            <div class="col-lg-5">
                <div class="panel h-100 d-flex flex-column">
                    <p class="eyebrow" style="margin-bottom:8px">60-second self check</p>
                    <h2 class="section-title" style="font-size:1.6rem">Can you donate today?</h2>
                    <p class="section-sub mb-3">Four questions against the criteria our donor network uses.</p>

                    <form id="eligibilityQuizForm">
                        <div class="quiz-q">
                            <span class="q-label"><span class="n">01</span>Are you between 18 and 65 years old, and weigh at least 50&nbsp;kg?</span>
                            <div class="choice-row">
                                <label class="choice"><input type="radio" id="q1_yes" name="q1" value="yes" required checked /><span>Yes</span></label>
                                <label class="choice"><input type="radio" id="q1_no" name="q1" value="no" /><span>No</span></label>
                            </div>
                        </div>

                        <div class="quiz-q">
                            <span class="q-label"><span class="n">02</span>Has it been at least 90 days since your last whole-blood donation?</span>
                            <div class="choice-row">
                                <label class="choice"><input type="radio" id="q2_yes" name="q2" value="yes" checked /><span>Yes / never donated</span></label>
                                <label class="choice"><input type="radio" id="q2_no" name="q2" value="no" /><span>No, recently</span></label>
                            </div>
                        </div>

                        <div class="quiz-q">
                            <span class="q-label"><span class="n">03</span>Do you feel well today, with no fever, cold or flu?</span>
                            <div class="choice-row">
                                <label class="choice"><input type="radio" id="q3_yes" name="q3" value="yes" checked /><span>Yes, feeling well</span></label>
                                <label class="choice"><input type="radio" id="q3_no" name="q3" value="no" /><span>No, unwell</span></label>
                            </div>
                        </div>

                        <div class="quiz-q">
                            <span class="q-label"><span class="n">04</span>In the last 6 months, have you had major surgery, a tattoo or a body piercing?</span>
                            <div class="choice-row">
                                <label class="choice"><input type="radio" id="q4_no" name="q4" value="no" checked /><span>No</span></label>
                                <label class="choice"><input type="radio" id="q4_yes" name="q4" value="yes" /><span>Yes</span></label>
                            </div>
                        </div>

                        <button type="button" class="btn btn-blood btn-block mt-4" id="btnCheckEligibility">
                            <i class="fas fa-check" aria-hidden="true"></i> Check eligibility
                        </button>
                    </form>

                    <div id="quizResultBox" class="mt-4" style="display:none" aria-live="polite"></div>

                    <p class="meta mt-4" style="margin-top:auto;padding-top:16px;text-transform:none;letter-spacing:0;font-family:var(--font-sans);font-size:.78rem;color:var(--muted)">
                        This self-check is a guide, not a medical decision. Final eligibility is confirmed at the donation centre.
                    </p>
                </div>
            </div>
        </div>

        @* ── Reference table ── *@
        <div class="panel mt-4" data-motion>
            <div class="d-flex justify-content-between align-items-end gap-3 flex-wrap mb-3">
                <div>
                    <p class="eyebrow" style="margin-bottom:6px">Reference</p>
                    <h2 class="section-title" style="font-size:1.45rem">Complete compatibility table</h2>
                </div>
                <span class="meta">Red blood cells</span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Blood type</th>
                            <th>Can donate red cells to</th>
                            <th>Can receive red cells from</th>
                            <th>Special trait</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><strong style="color:var(--blood);font-family:var(--font-mono)">O−</strong></td>
                            <td>All blood types</td>
                            <td>O−</td>
                            <td><span class="tag tag-ok">Universal red cell donor</span></td>
                        </tr>
                        <tr>
                            <td><strong style="color:var(--blood);font-family:var(--font-mono)">O+</strong></td>
                            <td>O+, A+, B+, AB+</td>
                            <td>O+, O−</td>
                            <td><span class="tag tag-muted">Most common type</span></td>
                        </tr>
                        <tr>
                            <td><strong style="color:var(--blood);font-family:var(--font-mono)">A−</strong></td>
                            <td>A−, A+, AB−, AB+</td>
                            <td>A−, O−</td>
                            <td><span class="tag tag-muted">Supports A &amp; AB patients</span></td>
                        </tr>
                        <tr>
                            <td><strong style="color:var(--blood);font-family:var(--font-mono)">A+</strong></td>
                            <td>A+, AB+</td>
                            <td>A+, A−, O+, O−</td>
                            <td><span class="tag tag-muted">High patient demand</span></td>
                        </tr>
                        <tr>
                            <td><strong style="color:var(--blood);font-family:var(--font-mono)">B−</strong></td>
                            <td>B−, B+, AB−, AB+</td>
                            <td>B−, O−</td>
                            <td><span class="tag tag-warn">Rare &amp; critical</span></td>
                        </tr>
                        <tr>
                            <td><strong style="color:var(--blood);font-family:var(--font-mono)">B+</strong></td>
                            <td>B+, AB+</td>
                            <td>B+, B−, O+, O−</td>
                            <td><span class="tag tag-muted">Common in South Asia</span></td>
                        </tr>
                        <tr>
                            <td><strong style="color:var(--blood);font-family:var(--font-mono)">AB−</strong></td>
                            <td>AB−, AB+</td>
                            <td>AB−, A−, B−, O−</td>
                            <td><span class="tag tag-warn">Rare group</span></td>
                        </tr>
                        <tr>
                            <td><strong style="color:var(--blood);font-family:var(--font-mono)">AB+</strong></td>
                            <td>AB+ only</td>
                            <td>All blood types</td>
                            <td><span class="tag tag-ok">Universal recipient</span></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        // ── Blood compatibility data ──
        const bloodRules = {
            'O-': { name: 'O− (O Negative)', subtitle: 'Universal red blood cell donor', universal: 'Universal donor',
                    donateTo: ['O−', 'O+', 'A−', 'A+', 'B−', 'B+', 'AB−', 'AB+'], receiveFrom: ['O−'] },
            'O+': { name: 'O+ (O Positive)', subtitle: 'Highest demand group in emergency wards', universal: 'High demand',
                    donateTo: ['O+', 'A+', 'B+', 'AB+'], receiveFrom: ['O+', 'O−'] },
            'A-': { name: 'A− (A Negative)', subtitle: 'Crucial for A and AB emergency transfusions', universal: 'Targeted donor',
                    donateTo: ['A−', 'A+', 'AB−', 'AB+'], receiveFrom: ['A−', 'O−'] },
            'A+': { name: 'A+ (A Positive)', subtitle: 'Second most common blood group worldwide', universal: 'High hospital need',
                    donateTo: ['A+', 'AB+'], receiveFrom: ['A+', 'A−', 'O+', 'O−'] },
            'B-': { name: 'B− (B Negative)', subtitle: 'Rare group needing dedicated voluntary donors', universal: 'Rare & critical',
                    donateTo: ['B−', 'B+', 'AB−', 'AB+'], receiveFrom: ['B−', 'O−'] },
            'B+': { name: 'B+ (B Positive)', subtitle: 'Common in Bangladesh and South Asia', universal: 'Vital community need',
                    donateTo: ['B+', 'AB+'], receiveFrom: ['B+', 'B−', 'O+', 'O−'] },
            'AB-': { name: 'AB− (AB Negative)', subtitle: 'The rarest type, essential for AB− patients', universal: 'Extremely rare',
                    donateTo: ['AB−', 'AB+'], receiveFrom: ['AB−', 'A−', 'B−', 'O−'] },
            'AB+': { name: 'AB+ (AB Positive)', subtitle: 'Universal recipient and universal plasma donor', universal: 'Universal recipient',
                    donateTo: ['AB+'], receiveFrom: ['O−', 'O+', 'A−', 'A+', 'B−', 'B+', 'AB−', 'AB+'] }
        };

        function groupChips(list, tone) {
            return list.map(g => `<span class="tag ${tone}">${g}</span>`).join('');
        }

        function updateCompatibilityView(group) {
            const data = bloodRules[group];
            if (!data) return;

            document.getElementById('currentGroupTitle').textContent = data.name;
            document.getElementById('currentGroupSubtitle').textContent = data.subtitle;
            document.getElementById('universalBadge').textContent = data.universal;
            document.getElementById('donateToList').innerHTML = groupChips(data.donateTo, 'tag-ok');
            document.getElementById('receiveFromList').innerHTML = groupChips(data.receiveFrom, 'tag-blood');
        }

        document.querySelectorAll('.group-btn').forEach(btn => {
            btn.addEventListener('click', function () {
                document.querySelectorAll('.group-btn').forEach(b => {
                    b.classList.remove('active');
                    b.setAttribute('aria-pressed', 'false');
                });
                this.classList.add('active');
                this.setAttribute('aria-pressed', 'true');
                updateCompatibilityView(this.dataset.group);
            });
        });

        updateCompatibilityView('O+');

        // ── Eligibility self-check ──
        document.getElementById('btnCheckEligibility').addEventListener('click', function () {
            const q1 = document.querySelector('input[name="q1"]:checked')?.value;
            const q2 = document.querySelector('input[name="q2"]:checked')?.value;
            const q3 = document.querySelector('input[name="q3"]:checked')?.value;
            const q4 = document.querySelector('input[name="q4"]:checked')?.value;
            const box = document.getElementById('quizResultBox');
            box.style.display = 'block';

            if (q1 === 'yes' && q2 === 'yes' && q3 === 'yes' && q4 === 'no') {
                box.innerHTML = `
                    <div class="alert alert-success mb-0" style="padding:18px">
                        <div style="font-family:var(--font-display);font-size:1.35rem;letter-spacing:-.02em;color:var(--signal);margin-bottom:6px">
                            You are likely eligible to donate
                        </div>
                        <p style="font-size:.86rem;margin-bottom:12px">Based on your answers you meet the primary criteria for whole-blood donation. A final check happens at the centre.</p>
                        <div class="d-flex flex-wrap gap-2">
                            <a href="/Account/Register" class="btn btn-blood btn-sm">Register as a donor</a>
                            <a href="/Emergency/Hospitals" class="btn btn-ghost btn-sm">Find a centre</a>
                        </div>
                    </div>`;
            } else {
                const reasons = [];
                if (q1 !== 'yes') reasons.push('Donors must be aged 18–65 and weigh at least 50 kg.');
                if (q2 !== 'yes') reasons.push('At least 90 days must pass between whole-blood donations.');
                if (q3 !== 'yes') reasons.push('You must be well, with no fever or active infection.');
                if (q4 === 'yes') reasons.push('A temporary deferral applies after major surgery, tattoos or piercings.');

                box.innerHTML = `
                    <div class="alert alert-warning mb-0" style="padding:18px">
                        <div style="font-family:var(--font-display);font-size:1.35rem;letter-spacing:-.02em;color:var(--amber);margin-bottom:6px">
                            A temporary deferral may apply
                        </div>
                        <p style="font-size:.86rem;margin-bottom:8px">Thank you for being willing to give. For your safety and your recipient's:</p>
                        <ul style="font-size:.84rem;padding-left:18px;margin:0 0 10px">
                            ${reasons.map(r => `<li style="margin-bottom:4px">${r}</li>`).join('')}
                        </ul>
                        <p style="font-size:.8rem;margin:0;color:var(--muted)">Once that window passes, you are welcome back.</p>
                    </div>`;
            }
        });
    </script>
}
