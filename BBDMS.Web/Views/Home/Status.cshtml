@{
    ViewData["Title"] = "Something went wrong";
    var code = ViewBag.Code is int c ? c : 404;
    var message = ViewBag.Message as string ?? "Something went wrong while handling that request.";
}

<section class="py-5" style="background:#f8fafc;">
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-7">
                <div class="card-modern text-center py-5 px-4">
                    <div class="display-3 fw-bold text-danger mb-2">@code</div>
                    <h4 class="fw-bold text-dark mb-2">@message</h4>
                    <p class="text-muted mb-4">
                        If you followed a link from another page, it may have moved.
                        Try the emergency hub or head back to the home page.
                    </p>
                    <div class="d-flex flex-wrap justify-content-center gap-2">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-brand-red">
                            <i class="fas fa-home me-1"></i>Home
                        </a>
                        <a asp-controller="Emergency" asp-action="Index" class="btn btn-brand-outline">
                            <i class="fas fa-search-location me-1"></i>Emergency Hub
                        </a>
                        <a asp-controller="Donor" asp-action="Search" class="btn btn-brand-outline">
                            <i class="fas fa-tint me-1"></i>Find Donors
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
