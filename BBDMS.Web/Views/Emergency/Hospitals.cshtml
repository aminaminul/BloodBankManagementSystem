@model IEnumerable<BBDMS.Model.Models.Entities.Hospital>
@{
    ViewData["Title"] = "Hospitals, Emergency Beds & ICU Directory";
}

<div class="container my-5">
    <div class="mb-4">
        <h2 class="font-weight-bold mb-1">Find a Hospital</h2>
        <p class="text-muted">Search nearby hospitals, live emergency bed capacity, and 24/7 ICU availability.</p>
    </div>

    <!-- Filter Card -->
    <div class="card card-modern border-0 mb-4 p-3 bg-white">
        <form method="get" asp-action="Hospitals">
            <div class="row align-items-end">
                <div class="col-md-5 mb-3 mb-md-0">
                    <label class="font-weight-bold small text-dark"><i class="fas fa-map-marker-alt text-danger mr-1"></i> Search by Hospital or City</label>
                    <input type="text" name="location" value="@ViewBag.Location" class="form-control form-control-modern" placeholder="e.g. Dhaka, Chittagong, Sylhet..." />
                </div>
                <div class="col-md-4 mb-3 mb-md-0 d-flex align-items-center pt-md-3">
                    <div class="custom-control custom-checkbox mr-3">
                        <input type="checkbox" class="custom-control-input" id="icuOnly" name="icuOnly" value="true" @(ViewBag.IcuOnly == true ? "checked" : "") />
                        <label class="custom-control-label font-weight-bold text-danger small" for="icuOnly">ICU Beds Only</label>
                    </div>
                    <div class="custom-control custom-checkbox">
                        <input type="checkbox" class="custom-control-input" id="emergencyBedOnly" name="emergencyBedOnly" value="true" @(ViewBag.EmergencyBedOnly == true ? "checked" : "") />
                        <label class="custom-control-label font-weight-bold text-success small" for="emergencyBedOnly">Emergency Beds Only</label>
                    </div>
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-brand-red btn-block py-2 font-weight-bold">
                        <i class="fas fa-search mr-1"></i> Filter Hospitals
                    </button>
                </div>
            </div>
        </form>
    </div>

    <!-- Interactive Leaflet Map -->
    <div class="card card-modern border-0 mb-4">
        <div class="card-header bg-white font-weight-bold d-flex justify-content-between align-items-center py-3">
            <span><i class="fas fa-map-marked-alt text-danger mr-2"></i>Interactive Hospital & Bed Availability Map</span>
            <span class="badge badge-soft-success"><i class="fas fa-satellite-dish mr-1"></i> OpenStreetMap Live</span>
        </div>
        <div class="card-body p-0">
            <div id="hospitalsMap" style="height: 380px; width: 100%; z-index: 1;"></div>
        </div>
    </div>

    <!-- Hospitals Listing -->
    @if (Model != null && Model.Any())
    {
        <div class="row">
            @foreach (var hospital in Model)
            {
                <div class="col-lg-6 mb-4">
                    <div class="card card-modern h-100 p-4">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div class="d-flex align-items-center">
                                <div class="service-icon-box mr-3 mb-0" style="width: 48px; height: 48px; min-width: 48px; font-size: 1.2rem;">
                                    <i class="fas fa-hospital"></i>
                                </div>
                                <div>
                                    <h5 class="font-weight-bold text-dark mb-0">@hospital.Name</h5>
                                    <p class="text-muted small mb-0"><i class="fas fa-map-marker-alt text-danger mr-1"></i>@hospital.Address, @hospital.City</p>
                                </div>
                            </div>
                            <span class="badge badge-light border text-primary font-weight-bold px-3 py-1">@hospital.City</span>
                        </div>

                        <!-- Bed & ICU Stats Pill Display -->
                        <div class="row text-center mb-3">
                            <div class="col-6">
                                <div class="p-3 bg-light rounded" style="border: 1px solid #f1f5f9;">
                                    <div class="text-muted small font-weight-bold text-uppercase">Emergency Beds</div>
                                    <div class="h3 font-weight-bold text-success mb-0">@hospital.AvailableEmergencyBeds <small class="text-muted h6 font-weight-normal">/ @hospital.TotalEmergencyBeds</small></div>
                                    @if (hospital.AvailableEmergencyBeds > 0)
                                    {
                                        <span class="badge badge-soft-success mt-1 small">Available</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-soft-danger mt-1 small">Full</span>
                                    }
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-3 bg-light rounded" style="border: 1px solid #f1f5f9;">
                                    <div class="text-muted small font-weight-bold text-uppercase">ICU Units</div>
                                    <div class="h3 font-weight-bold text-danger mb-0">@hospital.AvailableIcuBeds <small class="text-muted h6 font-weight-normal">/ @hospital.TotalIcuBeds</small></div>
                                    @if (hospital.AvailableIcuBeds > 0)
                                    {
                                        <span class="badge badge-soft-danger mt-1 small">ICU Available</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-light border mt-1 small">ICU Full</span>
                                    }
                                </div>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(hospital.EmergencyServices))
                        {
                            <div class="mb-3 small">
                                <strong class="text-dark d-block">Services:</strong>
                                <span class="text-muted">@hospital.EmergencyServices</span>
                            </div>
                        }

                        <div class="mt-auto pt-3 border-top d-flex justify-content-between align-items-center">
                            <div>
                                <small class="text-muted d-block">Emergency Helpline:</small>
                                <span class="font-weight-bold text-danger small"><i class="fas fa-phone mr-1"></i>@hospital.EmergencyHelpline</span>
                            </div>
                            <a href="tel:@hospital.EmergencyHelpline" class="btn btn-sm btn-brand-red font-weight-bold">
                                <i class="fas fa-phone-volume mr-1"></i> Call Helpline
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-warning text-center p-5">
            <i class="fas fa-info-circle fa-2x mb-3"></i>
            <h4>No hospitals found matching your criteria</h4>
            <p>Try searching for a different city or removing the bed filter.</p>
            <a asp-action="Hospitals" class="btn btn-outline-primary mt-2">Clear Filters</a>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const mapElement = document.getElementById("hospitalsMap");
            if (!mapElement) return;

            // Default center: Dhaka, Bangladesh
            const map = L.map('hospitalsMap').setView([23.8103, 90.4125], 7);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
                maxZoom: 18
            }).addTo(map);

            const cityCoords = {
                'dhaka': [23.8103, 90.4125],
                'chittagong': [22.3569, 91.7832],
                'chattogram': [22.3569, 91.7832],
                'sylhet': [24.8949, 91.8687],
                'khulna': [22.8456, 89.5403],
                'rajshahi': [24.3745, 88.6042],
                'barishal': [22.7010, 90.3535],
                'barisal': [22.7010, 90.3535],
                'rangpur': [25.7439, 89.2752],
                'mymensingh': [24.7471, 90.4203],
                'comilla': [23.4607, 91.1809],
                'cumilla': [23.4607, 91.1809],
                'gazipur': [23.9999, 90.4203],
                'narayanganj': [23.6238, 90.5000],
                'bogra': [24.8481, 89.3730],
                'bogura': [24.8481, 89.3730],
                'jessore': [23.1664, 89.2081],
                'jashore': [23.1664, 89.2081],
                'cox\'s bazar': [21.4272, 92.0058]
            };

            const hospitalsData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                Model?.Select(h => new {
                    id = h.Id,
                    name = h.Name,
                    city = h.City,
                    address = h.Address,
                    emergencyBeds = h.AvailableEmergencyBeds,
                    totalEmergencyBeds = h.TotalEmergencyBeds,
                    icuBeds = h.AvailableIcuBeds,
                    totalIcuBeds = h.TotalIcuBeds,
                    helpline = h.EmergencyHelpline
                }) ?? Enumerable.Empty<object>()
            ));

            const markers = [];
            hospitalsData.forEach(function (hosp, index) {
                const cityKey = (hosp.city || "").toLowerCase().trim();
                let baseCoords = [23.8103, 90.4125];

                for (const [key, coords] of Object.entries(cityCoords)) {
                    if (cityKey.includes(key)) {
                        baseCoords = coords;
                        break;
                    }
                }

                // Add slight dispersion offset for hospitals in the same city
                const offsetLat = ((index % 5) - 2) * 0.012;
                const offsetLng = (Math.floor(index / 5) - 2) * 0.012;
                const lat = baseCoords[0] + offsetLat;
                const lng = baseCoords[1] + offsetLng;

                const popupHtml = `
                    <div style="min-width: 200px;">
                        <h6 class="font-weight-bold mb-1 text-danger">${hosp.name}</h6>
                        <p class="small text-muted mb-2"><i class="fas fa-map-marker-alt text-danger mr-1"></i>${hosp.address}, ${hosp.city}</p>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="badge badge-success p-1">Beds: ${hosp.emergencyBeds}/${hosp.totalEmergencyBeds}</span>
                            <span class="badge badge-danger p-1">ICU: ${hosp.icuBeds}/${hosp.totalIcuBeds}</span>
                        </div>
                        ${hosp.helpline ? `<a href="tel:${hosp.helpline}" class="btn btn-sm btn-danger btn-block text-white font-weight-bold"><i class="fas fa-phone mr-1"></i> ${hosp.helpline}</a>` : ''}
                    </div>
                `;

                const marker = L.marker([lat, lng]).bindPopup(popupHtml);
                marker.addTo(map);
                markers.push(marker);
            });

            if (markers.length > 0) {
                const group = new L.featureGroup(markers);
                map.fitBounds(group.getBounds().pad(0.2));
            }
        });
    </script>
}

