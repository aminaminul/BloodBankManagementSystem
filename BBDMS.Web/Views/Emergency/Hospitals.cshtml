@model IEnumerable<BBDMS.Model.Models.Entities.Hospital>
@{
    ViewData["Title"] = "Hospitals, Emergency Beds & ICU Directory";
    var hospitals = Model ?? Enumerable.Empty<BBDMS.Model.Models.Entities.Hospital>();
    var any = hospitals.Any();
}

@section Styles {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
}

<section class="page-head">
    <div class="container">
        <nav aria-label="Breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item"><a asp-action="Index">Emergency</a></li>
                <li class="breadcrumb-item active" aria-current="page">Hospitals</li>
            </ol>
        </nav>
        <div class="page-head-row">
            <div>
                <p class="eyebrow">Emergency directory</p>
                <h1>Find a hospital with a free bed, right now.</h1>
                <p>Search live emergency bed and ICU availability across the network, then call the ward directly. No account needed.</p>
            </div>
            <div class="page-head-actions">
                <a class="btn btn-ghost" asp-action="Index"><i class="fas fa-triangle-exclamation" aria-hidden="true"></i> Emergency hub</a>
                <a class="btn btn-blood" href="#directory">Browse directory <i class="fas fa-arrow-down" aria-hidden="true"></i></a>
            </div>
        </div>
    </div>
</section>

<section class="section-tight band-surface rule-bottom" aria-label="Network at a glance">
    <div class="container">
        <div class="stat-strip" data-reveal>
            <div class="stat-cell">
                <span class="stat-val">@hospitals.Count()</span>
                <span class="stat-label">Facilities listed</span>
            </div>
            <div class="stat-cell">
                <span class="stat-val">@hospitals.Sum(h => h.AvailableEmergencyBeds)</span>
                <span class="stat-label">Emergency beds free</span>
            </div>
            <div class="stat-cell">
                <span class="stat-val">@hospitals.Sum(h => h.AvailableIcuBeds)</span>
                <span class="stat-label">ICU units free</span>
            </div>
        </div>
    </div>
</section>

<section class="section-tight" id="directory" aria-labelledby="directoryHeading">
    <div class="container">

        <form method="get" asp-action="Hospitals" class="filter-bar" data-reveal>
            <div class="filter-bar-grid">
                <div>
                    <label for="hospitalSearch">Hospital or city</label>
                    <input id="hospitalSearch" type="text" name="location" value="@ViewBag.Location" class="form-control" placeholder="e.g. Dhaka, Chittagong, Sylhet" autocomplete="address-level2" />
                </div>
                <div class="filter-checks">
                    <label class="check">
                        <input type="checkbox" name="icuOnly" value="true" @(ViewBag.IcuOnly == true ? "checked" : "") />
                        <span>ICU beds only</span>
                    </label>
                    <label class="check">
                        <input type="checkbox" name="emergencyBedOnly" value="true" @(ViewBag.EmergencyBedOnly == true ? "checked" : "") />
                        <span>Emergency beds only</span>
                    </label>
                </div>
                <div class="filter-actions">
                    <button type="submit" class="btn btn-ink">Filter</button>
                    <a class="btn btn-ghost" asp-action="Hospitals">Reset</a>
                </div>
            </div>
        </form>

        <div class="map-frame mt-5" data-reveal>
            <div class="map-frame-head">
                <h2 id="directoryHeading">Live availability map</h2>
                <span class="pill pill-live"><span class="pulse-dot" aria-hidden="true"></span> OpenStreetMap</span>
            </div>
            <div id="hospitalsMap"></div>
        </div>

        @if (any)
        {
            <div class="directory-grid mt-5">
                @foreach (var hospital in hospitals)
                {
                    var bedsFree = hospital.AvailableEmergencyBeds > 0;
                    var icuFree = hospital.AvailableIcuBeds > 0;
                    <article class="directory-card" data-reveal>
                        <header>
                            <div>
                                <h3>@hospital.Name</h3>
                                <p class="meta"><i class="fas fa-location-dot" aria-hidden="true"></i>@hospital.Address, @hospital.City</p>
                            </div>
                            <span class="pill">@hospital.City</span>
                        </header>

                        <dl class="capacity">
                            <div>
                                <dt>Emergency beds</dt>
                                <dd>
                                    <span class="capacity-num">@hospital.AvailableEmergencyBeds</span>
                                    <span class="capacity-total">/ @hospital.TotalEmergencyBeds</span>
                                </dd>
                                <span class="pill @(bedsFree ? "pill-live" : "pill-muted")">@(bedsFree ? "Available" : "Full")</span>
                            </div>
                            <div>
                                <dt>ICU units</dt>
                                <dd>
                                    <span class="capacity-num">@hospital.AvailableIcuBeds</span>
                                    <span class="capacity-total">/ @hospital.TotalIcuBeds</span>
                                </dd>
                                <span class="pill @(icuFree ? "pill-live" : "pill-muted")">@(icuFree ? "Available" : "Full")</span>
                            </div>
                        </dl>

                        @if (!string.IsNullOrEmpty(hospital.EmergencyServices))
                        {
                            <p class="services"><strong>Services:</strong> @hospital.EmergencyServices</p>
                        }

                        <footer>
                            <div>
                                <span class="meta-label">Emergency helpline</span>
                                <a class="phone" href="tel:@hospital.EmergencyHelpline">@hospital.EmergencyHelpline</a>
                            </div>
                            <a href="tel:@hospital.EmergencyHelpline" class="btn btn-ghost btn-sm">
                                <i class="fas fa-phone-volume" aria-hidden="true"></i> Call
                            </a>
                        </footer>
                    </article>
                }
            </div>
        }
        else
        {
            <div class="empty-state mt-5">
                <i class="fas fa-hospital" aria-hidden="true"></i>
                <h4>No facilities match those filters</h4>
                <p>Try another city, or clear the bed filters to see the whole network.</p>
                <a asp-action="Hospitals" class="btn btn-ink">Clear filters</a>
            </div>
        }
    </div>
</section>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const mapElement = document.getElementById("hospitalsMap");
            if (!mapElement) return;

            // Default center: Dhaka, Bangladesh
            const map = L.map('hospitalsMap').setView([23.8103, 90.4125], 7);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
                maxZoom: 18
            }).addTo(map);

            const cityCoords = {
                'dhaka': [23.8103, 90.4125],
                'chittagong': [22.3569, 91.7832],
                'chattogram': [22.3569, 91.7832],
                'sylhet': [24.8949, 91.8687],
                'khulna': [22.8456, 89.5403],
                'rajshahi': [24.3745, 88.6042],
                'barishal': [22.7010, 90.3535],
                'barisal': [22.7010, 90.3535],
                'rangpur': [25.7439, 89.2752],
                'mymensingh': [24.7471, 90.4203],
                'comilla': [23.4607, 91.1809],
                'cumilla': [23.4607, 91.1809],
                'gazipur': [23.9999, 90.4203],
                'narayanganj': [23.6238, 90.5000],
                'bogra': [24.8481, 89.3730],
                'bogura': [24.8481, 89.3730],
                'jessore': [23.1664, 89.2081],
                'jashore': [23.1664, 89.2081],
                'cox\'s bazar': [21.4272, 92.0058]
            };

            const hospitalsData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                hospitals.Select(h => new {
                    id = h.Id,
                    name = h.Name,
                    city = h.City,
                    address = h.Address,
                    emergencyBeds = h.AvailableEmergencyBeds,
                    totalEmergencyBeds = h.TotalEmergencyBeds,
                    icuBeds = h.AvailableIcuBeds,
                    totalIcuBeds = h.TotalIcuBeds,
                    helpline = h.EmergencyHelpline
                }) ?? Enumerable.Empty<object>()
            ));

            const markers = [];
            hospitalsData.forEach(function (hosp, index) {
                const cityKey = (hosp.city || "").toLowerCase().trim();
                let baseCoords = [23.8103, 90.4125];

                for (const [key, coords] of Object.entries(cityCoords)) {
                    if (cityKey.includes(key)) {
                        baseCoords = coords;
                        break;
                    }
                }

                // Add slight dispersion offset for hospitals in the same city
                const offsetLat = ((index % 5) - 2) * 0.012;
                const offsetLng = (Math.floor(index / 5) - 2) * 0.012;
                const lat = baseCoords[0] + offsetLat;
                const lng = baseCoords[1] + offsetLng;

                const popupHtml = `
                    <div class="map-popup">
                        <h6>${hosp.name}</h6>
                        <p class="meta">${hosp.address}, ${hosp.city}</p>
                        <div class="map-popup-stats">
                            <span>Beds ${hosp.emergencyBeds}/${hosp.totalEmergencyBeds}</span>
                            <span>ICU ${hosp.icuBeds}/${hosp.totalIcuBeds}</span>
                        </div>
                        ${hosp.helpline ? `<a href="tel:${hosp.helpline}">${hosp.helpline}</a>` : ''}
                    </div>
                `;

                const marker = L.marker([lat, lng]).bindPopup(popupHtml);
                marker.addTo(map);
                markers.push(marker);
            });

            if (markers.length > 0) {
                const group = new L.featureGroup(markers);
                map.fitBounds(group.getBounds().pad(0.2));
            }
        });
    </script>
}
