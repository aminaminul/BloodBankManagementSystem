@model BBDMS.Model.Models.ViewModels.EmergencySearchViewModel
@{
    ViewData["Title"] = "Nearby Emergency Healthcare Services - Blood Bank";
}

<section class="page-hero-sm" style="background:linear-gradient(135deg,#e63946 0%,#9b1a26 100%); color:#fff; padding:56px 0 40px;">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-2" style="background:transparent; padding:0;">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-white-50">Home</a></li>
                <li class="breadcrumb-item active text-white" aria-current="page">Emergency Hub</li>
            </ol>
        </nav>
        <h1 class="fw-bold mb-1" style="font-size:2rem;">Emergency Healthcare Support Hub</h1>
        <p class="mb-0 text-white-50">Find voluntary blood donors, emergency hospital ICU beds, blood banks, ambulances &amp; oxygen supplies instantly.</p>
    </div>
</section>

<section class="py-5" style="background:#f8fafc;">
    <div class="container py-2">

        <!-- Search Bar -->
        <div class="card-modern mb-5 p-4">
            <form method="get" asp-action="Index">
                <div class="row g-3 align-items-end">
                    <div class="col-md-5">
                        <label class="form-label small fw-bold text-dark">
                            <i class="fas fa-map-marker-alt text-danger me-1"></i>Location / City / Area
                        </label>
                        <input type="text" name="location" value="@Model.Location" class="form-control form-control-modern" placeholder="Enter city (e.g. Dhaka, Chittagong, Sylhet)" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-bold text-dark">
                            <i class="fas fa-filter text-primary me-1"></i>Service Category
                        </label>
                        <select name="serviceType" class="form-select form-control-modern">
                            <option value="All" selected="@(Model.ServiceType == "All")">All Emergency Services</option>
                            <option value="Hospitals" selected="@(Model.ServiceType == "Hospitals")">Hospitals &amp; ICU Beds</option>
                            <option value="BloodBanks" selected="@(Model.ServiceType == "BloodBanks")">Blood Banks</option>
                            <option value="Ambulance" selected="@(Model.ServiceType == "Ambulance")">Ambulance Fleets</option>
                            <option value="Oxygen" selected="@(Model.ServiceType == "Oxygen")">Oxygen Supplies</option>
                            <option value="Donors" selected="@(Model.ServiceType == "Donors")">Blood Donors</option>
                            <option value="BloodRequests" selected="@(Model.ServiceType == "BloodRequests")">Emergency Blood Requests</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <button type="submit" class="btn btn-brand-red w-100 py-2 fw-bold">
                            <i class="fas fa-search me-1"></i>Find Resources
                        </button>
                    </div>
                </div>
            </form>
        </div>

        <!-- Quick Category Shortcuts -->
        <div class="row g-3 text-center mb-5">
            <div class="col-6 col-md-4 col-lg-2">
                <a asp-action="Hospitals" class="service-cat-card">
                    <div class="service-icon-box">
                        <i class="fas fa-hospital"></i>
                    </div>
                    <h6 class="fw-bold mb-0">Hospitals &amp; ICU</h6>
                </a>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <a asp-action="BloodBanks" class="service-cat-card">
                    <div class="service-icon-box">
                        <i class="fas fa-landmark"></i>
                    </div>
                    <h6 class="fw-bold mb-0">Blood Banks</h6>
                </a>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <a asp-action="Ambulances" class="service-cat-card">
                    <div class="service-icon-box">
                        <i class="fas fa-ambulance"></i>
                    </div>
                    <h6 class="fw-bold mb-0">Ambulances</h6>
                </a>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <a asp-action="Oxygen" class="service-cat-card">
                    <div class="service-icon-box">
                        <i class="fas fa-lungs"></i>
                    </div>
                    <h6 class="fw-bold mb-0">Oxygen Gas</h6>
                </a>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <a asp-controller="Donor" asp-action="Search" class="service-cat-card">
                    <div class="service-icon-box">
                        <i class="fas fa-user-friends"></i>
                    </div>
                    <h6 class="fw-bold mb-0">Find Donors</h6>
                </a>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <a asp-action="BloodRequests" class="service-cat-card">
                    <div class="service-icon-box">
                        <i class="fas fa-heartbeat"></i>
                    </div>
                    <h6 class="fw-bold mb-0">Blood Requests</h6>
                </a>
            </div>
        </div>

        <!-- 1. Active Emergency Blood Requests (FROM DATABASE) -->
        @if (Model.EmergencyRequests != null && Model.EmergencyRequests.Any())
        {
            <div class="mb-5">
                <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                    <h4 class="fw-bold text-danger mb-0"><i class="fas fa-exclamation-triangle me-2"></i>Active Urgent Blood Needs</h4>
                    <a asp-action="BloodRequests" class="btn btn-outline-danger btn-sm fw-bold">View All Blood Requests &rarr;</a>
                </div>
                <div class="row g-4">
                    @foreach (var req in Model.EmergencyRequests.Take(3))
                    {
                        <div class="col-md-4">
                            <div class="card-modern h-100 p-4" style="border-left: 4px solid var(--brand-red) !important;">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="badge-soft-danger px-3 py-2 fw-bold">@(req.BloodGroup ?? req.BloodRequireFor) Blood</span>
                                    <span class="badge @(req.Urgency == "Critical" || req.Urgency?.Contains("Critical") == true ? "badge-soft-danger" : "badge-soft-warning")">
                                        @req.Urgency
                                    </span>
                                </div>
                                <h5 class="fw-bold text-dark mb-1">@(string.IsNullOrEmpty(req.HospitalName) ? "Emergency Ward" : req.HospitalName)</h5>
                                <p class="text-muted small mb-2"><i class="fas fa-map-marker-alt text-danger me-1"></i>@req.Location</p>
                                <p class="small text-dark mb-3"><strong>Reason:</strong> @req.BloodRequireFor (@req.UnitsRequired Unit@(req.UnitsRequired > 1 ? "s" : ""))</p>
                                <div class="mt-auto pt-2 border-top d-flex justify-content-between align-items-center">
                                    <span class="small fw-bold text-muted"><i class="fas fa-phone me-1 text-success"></i>@req.ContactNumber</span>
                                    <a asp-action="BloodRequests" class="btn btn-sm btn-brand-red fw-bold">Details</a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- 2. Hospitals Section (FROM DATABASE) -->
        @if (Model.Hospitals != null && Model.Hospitals.Any())
        {
            <div class="mb-5">
                <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                    <h4 class="fw-bold text-dark mb-0"><i class="fas fa-hospital me-2 text-primary"></i>Hospitals &amp; ICU Beds</h4>
                    <a asp-action="Hospitals" class="btn btn-outline-primary btn-sm fw-bold">View All Hospitals &rarr;</a>
                </div>
                <div class="row g-4">
                    @foreach (var hospital in Model.Hospitals.Take(4))
                    {
                        <div class="col-md-6">
                            <div class="card-modern h-100 p-4">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h5 class="fw-bold text-dark mb-0">@hospital.Name</h5>
                                    <span class="badge-soft-primary">@hospital.City</span>
                                </div>
                                <p class="text-muted small mb-3"><i class="fas fa-map-marker-alt text-danger me-1"></i>@hospital.Address</p>
                                
                                <div class="p-2 rounded mb-3 text-center" style="background: #f8fafc; border: 1px solid #edf2f7;">
                                    <div class="row g-0">
                                        <div class="col-6 border-end">
                                            <div class="text-muted small">Emergency Beds</div>
                                            <span class="fw-bold text-success fs-5">@hospital.AvailableEmergencyBeds</span>
                                            <small class="text-muted">/@hospital.TotalEmergencyBeds</small>
                                        </div>
                                        <div class="col-6">
                                            <div class="text-muted small">ICU Beds</div>
                                            <span class="fw-bold text-danger fs-5">@hospital.AvailableIcuBeds</span>
                                            <small class="text-muted">/@hospital.TotalIcuBeds</small>
                                        </div>
                                    </div>
                                </div>
                                <div class="d-flex justify-content-between align-items-center pt-2 border-top mt-auto">
                                    <span class="text-danger fw-semibold small"><i class="fas fa-phone me-1"></i>Helpline: @hospital.EmergencyHelpline</span>
                                    <a href="tel:@hospital.EmergencyHelpline" class="btn btn-sm btn-brand-red">Call Now</a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- 3. Blood Banks Section (FROM DATABASE) -->
        @if (Model.BloodBanks != null && Model.BloodBanks.Any())
        {
            <div class="mb-5">
                <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                    <h4 class="fw-bold text-dark mb-0"><i class="fas fa-landmark me-2 text-danger"></i>Registered Blood Banks</h4>
                    <a asp-action="BloodBanks" class="btn btn-outline-danger btn-sm fw-bold">View All Blood Banks &rarr;</a>
                </div>
                <div class="row g-4">
                    @foreach (var bb in Model.BloodBanks.Take(4))
                    {
                        <div class="col-md-6">
                            <div class="card-modern h-100 p-4">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h5 class="fw-bold text-dark mb-0">@bb.Name</h5>
                                    <span class="badge-soft-danger">@bb.City</span>
                                </div>
                                <p class="text-muted small mb-2"><i class="fas fa-map-marker-alt text-danger me-1"></i>@bb.Address</p>
                                <p class="small text-muted mb-2"><strong>Affiliation:</strong> @bb.HospitalAffiliation</p>
                                
                                <div class="mb-3">
                                    <small class="text-muted d-block mb-1">Available Blood Groups in Stock:</small>
                                    <div class="d-flex flex-wrap gap-1">
                                        @if (!string.IsNullOrEmpty(bb.AvailableBloodGroups))
                                        {
                                            foreach (var grp in bb.AvailableBloodGroups.Split(new[] { ',', ' ' }, StringSplitOptions.RemoveEmptyEntries))
                                            {
                                                <span class="badge-soft-danger px-1 py-0 small fw-bold">@grp</span>
                                            }
                                        }
                                    </div>
                                </div>

                                <div class="d-flex justify-content-between align-items-center pt-2 border-top mt-auto">
                                    <span class="text-dark small fw-semibold"><i class="fas fa-phone me-1 text-success"></i>@bb.ContactNumber</span>
                                    <a href="tel:@bb.ContactNumber" class="btn btn-sm btn-brand-outline">Contact Bank</a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- 4. Ambulances Section (FROM DATABASE) -->
        @if (Model.Ambulances != null && Model.Ambulances.Any())
        {
            <div class="mb-5">
                <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                    <h4 class="fw-bold text-dark mb-0"><i class="fas fa-ambulance me-2 text-warning"></i>Emergency Ambulance Fleets</h4>
                    <a asp-action="Ambulances" class="btn btn-outline-warning text-dark btn-sm fw-bold">View All Ambulances &rarr;</a>
                </div>
                <div class="row g-4">
                    @foreach (var amb in Model.Ambulances.Take(4))
                    {
                        <div class="col-md-6">
                            <div class="card-modern h-100 p-4">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div>
                                        <h5 class="fw-bold mb-1 text-dark">@amb.ProviderName</h5>
                                        <span class="badge-soft-warning me-1">@amb.AmbulanceType</span>
                                        <span class="badge-soft-primary"><i class="fas fa-map-marker-alt text-danger me-1"></i>@amb.Location</span>
                                    </div>
                                    @if (amb.IsAvailable)
                                    {
                                        <span class="badge-soft-success">Available 24/7</span>
                                    }
                                    else
                                    {
                                        <span class="badge-soft-secondary">On Duty</span>
                                    }
                                </div>
                                <div class="d-flex justify-content-between align-items-center pt-3 border-top mt-auto">
                                    <span class="fw-bold text-dark small"><i class="fas fa-phone me-1 text-success"></i>@amb.ContactNumber</span>
                                    <a asp-action="RequestAmbulance" asp-route-serviceId="@amb.Id" class="btn btn-sm btn-brand-red">
                                        Request Ambulance
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- 5. Oxygen Suppliers Section (FROM DATABASE) -->
        @if (Model.OxygenServices != null && Model.OxygenServices.Any())
        {
            <div class="mb-5">
                <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                    <h4 class="fw-bold text-dark mb-0"><i class="fas fa-lungs me-2 text-info"></i>Medical Oxygen Gas Suppliers</h4>
                    <a asp-action="Oxygen" class="btn btn-outline-info btn-sm fw-bold">View All Oxygen Suppliers &rarr;</a>
                </div>
                <div class="row g-4">
                    @foreach (var oxy in Model.OxygenServices.Take(4))
                    {
                        <div class="col-md-6">
                            <div class="card-modern h-100 p-4">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div>
                                        <h5 class="fw-bold mb-1 text-dark">@oxy.ProviderName</h5>
                                        <span class="badge-soft-primary"><i class="fas fa-map-marker-alt text-danger me-1"></i>@oxy.Location</span>
                                    </div>
                                    <span class="badge @(oxy.OxygenAvailability == "In Stock" ? "badge-soft-success" : oxy.OxygenAvailability == "Limited" ? "badge-soft-warning" : "badge-soft-secondary")">
                                        @oxy.OxygenAvailability
                                    </span>
                                </div>
                                <p class="text-muted small mb-2">@oxy.Address</p>
                                <p class="small text-muted mb-2"><strong>Cylinders:</strong> @oxy.CylinderCapacity</p>
                                @if (oxy.HomeDeliveryAvailable)
                                {
                                    <span class="badge-soft-success small mb-3 d-inline-block"><i class="fas fa-truck me-1"></i>24/7 Home Delivery</span>
                                }
                                <div class="d-flex justify-content-between align-items-center pt-2 border-top mt-auto">
                                    <span class="fw-bold text-dark small"><i class="fas fa-phone me-1 text-success"></i>@oxy.ContactNumber</span>
                                    <a href="tel:@oxy.ContactNumber" class="btn btn-sm btn-brand-red">Contact Supplier</a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- 6. Donors Section (FROM DATABASE) -->
        @if (Model.Donors != null && Model.Donors.Any())
        {
            <div class="mb-5">
                <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                    <h4 class="fw-bold text-dark mb-0"><i class="fas fa-user-friends me-2 text-danger"></i>Voluntary Blood Donors</h4>
                    <a asp-controller="Donor" asp-action="Search" class="btn btn-outline-danger btn-sm fw-bold">Search Donors &rarr;</a>
                </div>
                <div class="row g-4">
                    @foreach (var donor in Model.Donors.Take(6))
                    {
                        <div class="col-md-6 col-lg-4">
                            <div class="card-modern h-100 p-3">
                                <div class="d-flex align-items-center">
                                    <div class="rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px; min-width: 50px; background: #fff5f5; border: 2px solid #fee2e2;">
                                        <i class="fas fa-user text-danger"></i>
                                    </div>
                                    <div class="flex-grow-1 overflow-hidden">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <h6 class="fw-bold mb-0 text-truncate">@donor.FullName</h6>
                                            <span class="badge-soft-danger fw-bold">@donor.BloodGroup</span>
                                        </div>
                                        <p class="text-muted small mb-1 text-truncate"><i class="fas fa-map-marker-alt text-muted me-1"></i>@donor.Address</p>
                                        <span class="badge-soft-success small"><i class="fas fa-check-circle me-1"></i>Available</span>
                                    </div>
                                </div>
                                <div class="mt-3 pt-2 border-top d-flex justify-content-between align-items-center">
                                    <span class="small fw-semibold text-muted">@donor.Gender &bull; @donor.Age yrs</span>
                                    <a href="tel:@donor.MobileNumber" class="btn btn-sm btn-brand-outline">
                                        <i class="fas fa-phone me-1"></i>Call
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

    </div>
</section>
