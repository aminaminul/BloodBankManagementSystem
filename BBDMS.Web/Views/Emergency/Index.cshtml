@model BBDMS.Model.Models.ViewModels.EmergencySearchViewModel
@using System.Linq
@{
    ViewData["Title"] = "Emergency hub";
    var requests = (Model.EmergencyRequests ?? Enumerable.Empty<BBDMS.Model.Models.Entities.BloodRequest>()).Take(4).ToList();
    var hospitals = (Model.Hospitals ?? Enumerable.Empty<BBDMS.Model.Models.Entities.Hospital>()).Take(3).ToList();
    var banks = (Model.BloodBanks ?? Enumerable.Empty<BBDMS.Model.Models.Entities.BloodBank>()).Take(4).ToList();
    var ambulances = (Model.Ambulances ?? Enumerable.Empty<BBDMS.Model.Models.Entities.AmbulanceService>()).Take(4).ToList();
    var oxygen = (Model.OxygenServices ?? Enumerable.Empty<BBDMS.Model.Models.Entities.OxygenService>()).Take(4).ToList();
    var donors = (Model.Donors ?? Enumerable.Empty<BBDMS.Model.Models.ViewModels.DonorListItemViewModel>()).Take(4).ToList();

    var quick = new (string Ctrl, string Act, string Icon, string Title, string Sub)[]
    {
        ("Emergency", "Hospitals", "fa-hospital", "Hospitals & ICU", "Bed availability"),
        ("Emergency", "BloodBanks", "fa-building", "Blood banks", "Stock by group"),
        ("Emergency", "Ambulances", "fa-ambulance", "Ambulances", "Rapid transport"),
        ("Emergency", "Oxygen", "fa-lungs", "Oxygen", "Cylinders & refills"),
        ("Donor", "Search", "fa-droplet", "Blood donors", "Search by group"),
        ("Emergency", "BloodRequests", "fa-heart-pulse", "Blood requests", "Patients waiting"),
        ("Emergency", "Map", "fa-map-location-dot", "Live map", "Facilities near you"),
        ("Emergency", "TrackAmbulance", "fa-satellite-dish", "Track dispatch", "Ambulance status")
    };
}

<section class="page-head">
    <div class="container">
        <nav aria-label="Breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item active" aria-current="page">Emergency hub</li>
            </ol>
        </nav>
        <div class="page-head-row">
            <div>
                <p class="eyebrow">One hub for urgent care</p>
                <h1>Emergency hub</h1>
                <p>Find hospitals with free beds, blood banks with stock, ambulances and oxygen suppliers — filtered by where you are.</p>
            </div>
            <div class="page-head-actions">
                <a class="btn btn-ghost" asp-action="Map">
                    <i class="fas fa-map-location-dot" aria-hidden="true"></i> Open live map
                </a>
                <a class="btn btn-blood" asp-action="CreateBloodRequest">
                    <i class="fas fa-plus" aria-hidden="true"></i> Post a blood request
                </a>
            </div>
        </div>
    </div>
</section>

<section class="section-tight">
    <div class="container">

        @* Search *@
        <div class="filter-bar">
            <form method="get" asp-action="Index" role="search">
                <div class="row g-3 align-items-end">
                    <div class="col-md-5">
                        <label for="loc">Location / city / area</label>
                        <input id="loc" type="text" name="location" value="@Model.Location" class="form-control"
                               placeholder="e.g. Dhaka, Chattogram, Sylhet" autocomplete="address-level2" />
                    </div>
                    <div class="col-md-4">
                        <label for="svc">Service category</label>
                        <select id="svc" name="serviceType" class="form-select">
                            <option value="All" selected="@(Model.ServiceType == "All")">All emergency services</option>
                            <option value="Hospitals" selected="@(Model.ServiceType == "Hospitals")">Hospitals &amp; ICU beds</option>
                            <option value="BloodBanks" selected="@(Model.ServiceType == "BloodBanks")">Blood banks</option>
                            <option value="Ambulance" selected="@(Model.ServiceType == "Ambulance")">Ambulance fleets</option>
                            <option value="Oxygen" selected="@(Model.ServiceType == "Oxygen")">Oxygen supplies</option>
                            <option value="Donors" selected="@(Model.ServiceType == "Donors")">Blood donors</option>
                            <option value="BloodRequests" selected="@(Model.ServiceType == "BloodRequests")">Blood requests</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <button type="submit" class="btn btn-ink w-100" style="height:46px">
                            <i class="fas fa-magnifying-glass" aria-hidden="true"></i> Find resources
                        </button>
                    </div>
                </div>
            </form>
        </div>

        <div class="d-flex flex-wrap gap-3 align-items-center mt-4 mb-5">
            <span class="live-pill"><span class="live-dot" aria-hidden="true"></span> Network live</span>
            <span class="meta" style="text-transform:none;letter-spacing:0;font-family:var(--font-sans);font-size:.85rem;color:var(--muted)">
                Availability is reported by registered facilities and refreshed as they update their records.
            </span>
        </div>

        @* Directory *@
        <div class="section-head" style="margin-bottom:24px">
            <div class="section-head-copy">
                <p class="eyebrow">Jump to a service</p>
                <h2 class="section-title" style="font-size:clamp(1.5rem,2.4vw,2rem)">Everything in the network</h2>
            </div>
        </div>
        <div class="quick-grid mb-5" data-motion-stagger>
            @foreach (var q in quick)
            {
                <a class="quick-cell" asp-controller="@q.Ctrl" asp-action="@q.Act">
                    <span class="ico"><i class="fas @q.Icon" aria-hidden="true"></i></span>
                    <span>
                        <span class="t">@q.Title</span>
                        <span class="s">@q.Sub</span>
                    </span>
                </a>
            }
        </div>

        @* Active blood requests *@
        @if (requests.Any())
        {
            <div class="board mb-5" data-motion>
                <div class="board-head">
                    <h2 class="board-title">Open blood requests</h2>
                    <span class="live-pill"><span class="live-dot" aria-hidden="true"></span> Live</span>
                </div>
                <div class="board-body">
                    @foreach (var req in requests)
                    {
                        <a class="board-row" asp-action="RequestDetails" asp-route-id="@req.ID">
                            <span class="board-group">@(req.BloodGroup ?? req.BloodRequireFor)</span>
                            <span style="min-width:0">
                                <span class="board-name">@(string.IsNullOrEmpty(req.HospitalName) ? "Emergency ward" : req.HospitalName)</span>
                                <span class="board-meta">
                                    @(string.IsNullOrEmpty(req.Location) ? "Location on request" : req.Location)
                                    · @req.UnitsRequired unit@(req.UnitsRequired > 1 ? "s" : "")
                                    · @(req.Status ?? "Open")
                                    · @(req.ApplyDate.HasValue ? req.ApplyDate.Value.ToString("dd MMM") : "today")
                                </span>
                            </span>
                            <span class="board-go" aria-hidden="true"><i class="fas fa-arrow-right"></i></span>
                        </a>
                    }
                </div>
                <div class="board-foot">
                    <a class="link-arrow" asp-action="BloodRequests" style="font-size:.8rem">
                        Full request board <i class="fas fa-arrow-right" aria-hidden="true"></i>
                    </a>
                    <span class="meta">Patient identity stays on the request page</span>
                </div>
            </div>
        }

        @* Hospitals *@
        @if (hospitals.Any())
        {
            <div class="section-head">
                <div class="section-head-copy">
                    <p class="eyebrow">Critical care</p>
                    <h2 class="section-title">Hospitals with capacity</h2>
                </div>
                <a class="link-arrow" asp-action="Hospitals">All hospitals <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
            </div>
            <div class="capacity-grid mb-5" data-motion-stagger>
                @foreach (var hosp in hospitals)
                {
                    var icuTotal = hosp.TotalIcuBeds <= 0 ? 1 : hosp.TotalIcuBeds;
                    var erTotal = hosp.TotalEmergencyBeds <= 0 ? 1 : hosp.TotalEmergencyBeds;
                    var icuPct = Math.Round(Math.Clamp((double)hosp.AvailableIcuBeds / icuTotal * 100, 0, 100));
                    var erPct = Math.Round(Math.Clamp((double)hosp.AvailableEmergencyBeds / erTotal * 100, 0, 100));
                    <article class="capacity-card">
                        <div>
                            <h3 class="capacity-name">@hosp.Name</h3>
                            <p class="capacity-loc">
                                <i class="fas fa-location-dot" aria-hidden="true"></i>
                                <span>@hosp.City@(string.IsNullOrEmpty(hosp.Address) ? "" : " · " + hosp.Address)</span>
                            </p>
                        </div>
                        <div>
                            <div class="meter">
                                <div class="meter-head">
                                    <span class="meter-label">ICU beds</span>
                                    <span class="meter-value"><b>@hosp.AvailableIcuBeds</b> / @hosp.TotalIcuBeds</span>
                                </div>
                                <div class="meter-track"><span class="meter-fill @(icuPct < 25 ? "is-low" : icuPct < 60 ? "is-mid" : "")" style="width:@icuPct%"></span></div>
                            </div>
                            <div class="meter">
                                <div class="meter-head">
                                    <span class="meter-label">Emergency beds</span>
                                    <span class="meter-value"><b>@hosp.AvailableEmergencyBeds</b> / @hosp.TotalEmergencyBeds</span>
                                </div>
                                <div class="meter-track"><span class="meter-fill @(erPct < 25 ? "is-low" : erPct < 60 ? "is-mid" : "")" style="width:@erPct%"></span></div>
                            </div>
                        </div>
                        <div class="capacity-foot">
                            @if (!string.IsNullOrEmpty(hosp.EmergencyHelpline))
                            {
                                <a class="capacity-tel" href="tel:@hosp.EmergencyHelpline"><i class="fas fa-phone" aria-hidden="true"></i> @hosp.EmergencyHelpline</a>
                            }
                            else
                            {
                                <span class="capacity-tel" style="color:var(--muted)">Helpline on profile</span>
                            }
                            <a class="btn btn-ghost btn-sm" asp-action="Hospitals">Details</a>
                        </div>
                    </article>
                }
            </div>
        }

        @* Blood banks + ambulances *@
        <div class="split-grid">
            @if (banks.Any())
            {
                <div>
                    <div class="section-head" style="margin-bottom:20px">
                        <div class="section-head-copy">
                            <p class="eyebrow">Blood supply</p>
                            <h2 class="section-title" style="font-size:1.6rem">Registered blood banks</h2>
                        </div>
                        <a class="link-arrow" asp-action="BloodBanks" style="font-size:.8rem">All banks <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
                    </div>
                    <div class="panel" style="padding:8px 22px">
                        @foreach (var bb in banks)
                        {
                            <div class="data-row" style="grid-template-columns:1fr auto">
                                <div class="data-row-main">
                                    <p class="data-row-title">@bb.Name</p>
                                    <p class="data-row-sub">
                                        <i class="fas fa-location-dot" aria-hidden="true"></i>@bb.City
                                        @if (!string.IsNullOrEmpty(bb.AvailableBloodGroups))
                                        {
                                            <span>·</span><span>Stock: @bb.AvailableBloodGroups</span>
                                        }
                                    </p>
                                </div>
                                <div class="data-row-actions">
                                    @if (!string.IsNullOrEmpty(bb.ContactNumber))
                                    {
                                        <a class="ledger-call" href="tel:@bb.ContactNumber" aria-label="Call @bb.Name"><i class="fas fa-phone" aria-hidden="true"></i></a>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            @if (ambulances.Any())
            {
                <div>
                    <div class="section-head" style="margin-bottom:20px">
                        <div class="section-head-copy">
                            <p class="eyebrow">Transport</p>
                            <h2 class="section-title" style="font-size:1.6rem">Ambulance fleets</h2>
                        </div>
                        <a class="link-arrow" asp-action="Ambulances" style="font-size:.8rem">All fleets <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
                    </div>
                    <div class="panel" style="padding:8px 22px">
                        @foreach (var amb in ambulances)
                        {
                            <div class="data-row" style="grid-template-columns:1fr auto">
                                <div class="data-row-main">
                                    <p class="data-row-title">@amb.ProviderName</p>
                                    <p class="data-row-sub">
                                        <i class="fas fa-location-dot" aria-hidden="true"></i>@amb.Location
                                        <span>·</span><span>@amb.AmbulanceType</span>
                                    </p>
                                </div>
                                <div class="data-row-actions">
                                    <span class="tag @(amb.IsAvailable ? "tag-ok" : "tag-muted")">@(amb.IsAvailable ? "Available" : "On duty")</span>
                                    <a class="btn btn-ghost btn-sm" asp-action="RequestAmbulance" asp-route-serviceId="@amb.Id">Request</a>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @* Oxygen *@
        @if (oxygen.Any())
        {
            <div class="section-head" style="margin-top:var(--s8)">
                <div class="section-head-copy">
                    <p class="eyebrow">Respiratory support</p>
                    <h2 class="section-title">Medical oxygen suppliers</h2>
                </div>
                <a class="link-arrow" asp-action="Oxygen">All suppliers <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
            </div>
            <div class="row g-4">
                @foreach (var oxy in oxygen)
                {
                    <div class="col-md-6 col-xl-3">
                        <article class="card-modern h-100 d-flex flex-column" data-motion>
                            <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                <h3 style="font-size:.98rem;font-weight:600;margin:0">@oxy.ProviderName</h3>
                                <span class="tag @(oxy.OxygenAvailability == "In Stock" ? "tag-ok" : oxy.OxygenAvailability == "Limited" ? "tag-warn" : "tag-muted")">@oxy.OxygenAvailability</span>
                            </div>
                            <p class="data-row-sub mb-1"><i class="fas fa-location-dot" aria-hidden="true"></i>@oxy.Location</p>
                            <p class="data-row-sub"><i class="fas fa-cylinder" aria-hidden="true"></i>@oxy.CylinderCapacity</p>
                            @if (oxy.HomeDeliveryAvailable)
                            {
                                <span class="tag tag-ok mt-2 mb-3" style="align-self:flex-start"><i class="fas fa-truck" aria-hidden="true"></i> Home delivery</span>
                            }
                            <div class="capacity-foot mt-auto">
                                @if (!string.IsNullOrEmpty(oxy.ContactNumber))
                                {
                                    <a class="capacity-tel" href="tel:@oxy.ContactNumber"><i class="fas fa-phone" aria-hidden="true"></i> @oxy.ContactNumber</a>
                                }
                            </div>
                        </article>
                    </div>
                }
            </div>
        }

        @* Donors *@
        @if (donors.Any())
        {
            <div class="section-head" style="margin-top:var(--s8)">
                <div class="section-head-copy">
                    <p class="eyebrow">Community</p>
                    <h2 class="section-title">Donors near this search</h2>
                </div>
                <a class="link-arrow" asp-controller="Donor" asp-action="Search">Search all donors <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
            </div>
            <div class="ledger">
                @foreach (var donor in donors)
                {
                    <a class="ledger-row" asp-controller="Donor" asp-action="Contact" asp-route-id="@donor.Id">
                        <span class="ledger-group">@donor.BloodGroup</span>
                        <div style="min-width:0">
                            <p class="ledger-name text-truncate">@donor.FullName</p>
                            <p class="ledger-sub">
                                <i class="fas fa-location-dot" aria-hidden="true"></i>
                                <span class="text-truncate">@donor.Address</span>
                            </p>
                        </div>
                        <div class="ledger-right">
                            <span class="tag @(donor.IsEligibleToDonate ? "tag-ok" : "tag-warn")">
                                @(donor.IsEligibleToDonate ? "Eligible" : "Deferred")
                            </span>
                            <span class="data-row-arrow" aria-hidden="true"><i class="fas fa-arrow-right"></i></span>
                        </div>
                    </a>
                }
            </div>
        }
    </div>
</section>

<section class="cta-band">
    <div class="container">
        <p class="eyebrow">Need help now?</p>
        <h2>Post a request. Let the network <em>find you.</em></h2>
        <p>Describe the blood group, units and hospital. Compatible donors and nearby facilities see it immediately.</p>
        <div class="cta-row">
            <a class="btn btn-blood btn-lg" asp-action="CreateBloodRequest">
                <i class="fas fa-plus" aria-hidden="true"></i> Create a blood request
            </a>
            <a class="btn btn-on-ink btn-lg" asp-action="RequestAmbulance">
                <i class="fas fa-ambulance" aria-hidden="true"></i> Request an ambulance
            </a>
        </div>
    </div>
</section>
