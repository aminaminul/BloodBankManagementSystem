@model BBDMS.Model.Models.Entities.AmbulanceRequest
@{
    ViewData["Title"] = "Emergency Ambulance Request";
}

<section class="page-head">
    <div class="container">
        <nav aria-label="Breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item"><a asp-action="Ambulances">Ambulances</a></li>
                <li class="breadcrumb-item active" aria-current="page">Request dispatch</li>
            </ol>
        </nav>
        <div class="page-head-row">
            <div>
                <p class="eyebrow">Dispatch request</p>
                <h1>Book an ambulance dispatch.</h1>
                <p>Give us the pickup point and the patient's condition. The dispatch team calls you back immediately to confirm the nearest vehicle.</p>
            </div>
            <div class="page-head-actions">
                <a asp-action="TrackAmbulance" class="btn btn-ghost">
                    <i class="fas fa-location-crosshairs" aria-hidden="true"></i> Track a dispatch
                </a>
                <a asp-action="Ambulances" class="btn btn-ghost">
                    <i class="fas fa-truck-medical" aria-hidden="true"></i> Browse fleet
                </a>
            </div>
        </div>
    </div>
</section>

<section class="section-tight">
    <div class="container">
        <div class="form-layout">
            <div class="form-main">
                <form method="post" asp-action="RequestAmbulance" class="panel">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="AmbulanceServiceId" />

                    @if (ViewBag.SelectedProvider != null)
                    {
                        <div class="alert alert-info" role="status">
                            <i class="fas fa-circle-info" aria-hidden="true"></i>
                            <div>
                                Requesting dispatch from <strong>@ViewBag.SelectedProvider</strong>
                                @if (ViewBag.AmbulanceType != null)
                                {
                                    <span class="badge-soft" style="margin-left:8px;">@ViewBag.AmbulanceType</span>
                                }
                            </div>
                        </div>
                    }

                    <div class="form-section is-first">
                        <h3 class="form-section-title">Patient &amp; contact</h3>
                        <div class="field-grid">
                            <div>
                                <label asp-for="PatientName">Patient name <span class="req">*</span></label>
                                <input asp-for="PatientName" class="form-control" placeholder="Patient's full name" required autocomplete="name" />
                                <span asp-validation-for="PatientName" class="field-validation-error"></span>
                            </div>
                            <div>
                                <label asp-for="ContactNumber">Emergency contact phone <span class="req">*</span></label>
                                <input asp-for="ContactNumber" type="tel" class="form-control" placeholder="e.g. 01712345678" required autocomplete="tel" />
                                <span asp-validation-for="ContactNumber" class="field-validation-error"></span>
                            </div>
                        </div>
                    </div>

                    <div class="form-section">
                        <h3 class="form-section-title">Pickup &amp; destination</h3>
                        <div class="field-grid">
                            <div class="span-2">
                                <label asp-for="PickupAddress">Pickup address &amp; landmarks <span class="req">*</span></label>
                                <textarea asp-for="PickupAddress" class="form-control" rows="3" placeholder="House / road number, area and a recognisable landmark…" required></textarea>
                                <span asp-validation-for="PickupAddress" class="field-validation-error"></span>
                            </div>
                            <div>
                                <label asp-for="DestinationHospital">Destination hospital</label>
                                <input asp-for="DestinationHospital" class="form-control" placeholder="e.g. City Central Hospital" />
                            </div>
                            <div>
                                <label asp-for="AmbulanceType">Required ambulance type</label>
                                <select asp-for="AmbulanceType" class="form-select">
                                    <option value="Advanced Life Support (ALS) / ICU">Advanced life support (ICU)</option>
                                    <option value="Basic Life Support (BLS)">Basic life support</option>
                                    <option value="AC Ambulance">AC ambulance</option>
                                    <option value="Non-AC Ambulance">Non-AC ambulance</option>
                                    <option value="Neonatal ICU Ambulance">Neonatal ICU ambulance</option>
                                </select>
                            </div>
                            <div class="span-2">
                                <label asp-for="Urgency">Urgency</label>
                                <select asp-for="Urgency" class="form-select">
                                    <option value="Emergency (Immediate Dispatch)">Emergency — dispatch immediately</option>
                                    <option value="Urgent (Within 1 Hour)">Urgent — within an hour</option>
                                    <option value="Scheduled Patient Transfer">Scheduled patient transfer</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="form-section">
                        <h3 class="form-section-title">Medical notes <span class="optional">optional</span></h3>
                        <label asp-for="Notes" class="sr-only">Medical condition or special instructions</label>
                        <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Oxygen needed, stretcher required, cardiac condition…"></textarea>
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn btn-blood">
                            <i class="fas fa-bell" aria-hidden="true"></i> Request dispatch
                        </button>
                        <p class="form-note">You will be taken to a live status timeline as soon as the request is submitted.</p>
                    </div>
                </form>
            </div>

            <aside class="form-aside">
                <div class="panel panel-ink">
                    <p class="eyebrow" style="color:rgba(255,246,238,.55)">Dispatch line</p>
                    <h2 class="hotline">
                        <i class="fas fa-truck-medical" aria-hidden="true"></i>
                        <a href="tel:999">999</a>
                    </h2>
                    <p class="panel-note">Life-threatening emergency? Call 999 now, then submit this form so the nearest vehicle is reserved.</p>

                    <div style="margin-top: var(--s5);">
                        <span class="meta-label">What happens next</span>
                        <ol class="rail-list">
                            <li><strong>Dispatch calls you</strong> to confirm the pickup and patient condition.</li>
                            <li><strong>A vehicle is assigned</strong> and appears on your tracking timeline.</li>
                            <li><strong>You track arrival</strong> with the token generated for this request.</li>
                        </ol>
                    </div>
                </div>

                <div class="panel panel-quiet">
                    <span class="meta-label">Area contacts</span>
                    <p class="panel-note" style="margin-bottom:14px">Local ambulance and hospital emergency numbers, no form required.</p>
                    <a asp-action="AmbulanceContact" class="link-arrow">Emergency contacts <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
                </div>
            </aside>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
