@model BBDMS.Model.Models.Entities.AmbulanceRequest
@{
    ViewData["Title"] = "Emergency Ambulance Request";
}

<div class="inner-banner py-5" style="background: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.6)), url('/images/banner1.jpg') no-repeat center; background-size: cover;">
    <div class="container py-lg-4 text-center">
        <h2 class="text-white font-weight-bold">Emergency Ambulance Request</h2>
        <p class="text-light mt-2">Submit an urgent dispatch request — our ambulance team will call you immediately</p>
    </div>
</div>

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow border-0">
                <div class="card-header bg-danger text-white py-3">
                    <h5 class="mb-0 font-weight-bold"><i class="fas fa-ambulance mr-2"></i>Patient & Pickup Information</h5>
                </div>
                <div class="card-body p-4 p-md-5">
                    @if (ViewBag.SelectedProvider != null)
                    {
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle mr-1"></i>You are requesting dispatch from <strong>@ViewBag.SelectedProvider</strong> (@ViewBag.AmbulanceType).
                        </div>
                    }

                    <form method="post" asp-action="RequestAmbulance">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="AmbulanceServiceId" />

                        <div class="form-row">
                            <div class="form-group col-md-6">
                                <label asp-for="PatientName" class="font-weight-bold">Patient Name <span class="text-danger">*</span></label>
                                <input asp-for="PatientName" class="form-control" placeholder="Patient's full name" required />
                                <span asp-validation-for="PatientName" class="text-danger small"></span>
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="ContactNumber" class="font-weight-bold">Emergency Contact Phone <span class="text-danger">*</span></label>
                                <input asp-for="ContactNumber" class="form-control" placeholder="e.g. 01712345678" required />
                                <span asp-validation-for="ContactNumber" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="form-group">
                            <label asp-for="PickupAddress" class="font-weight-bold">Pickup Address & Landmarks <span class="text-danger">*</span></label>
                            <textarea asp-for="PickupAddress" class="form-control" rows="3" placeholder="Provide complete pickup address, house/road number, area and recognizable landmarks..." required></textarea>
                            <span asp-validation-for="PickupAddress" class="text-danger small"></span>
                        </div>

                        <div class="form-row">
                            <div class="form-group col-md-6">
                                <label asp-for="DestinationHospital" class="font-weight-bold">Destination Hospital (if decided)</label>
                                <input asp-for="DestinationHospital" class="form-control" placeholder="e.g. City Central Hospital" />
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="AmbulanceType" class="font-weight-bold">Required Ambulance Type</label>
                                <select asp-for="AmbulanceType" class="form-control">
                                    <option value="Advanced Life Support (ALS) / ICU">Advanced Life Support (ALS) / ICU</option>
                                    <option value="Basic Life Support (BLS)">Basic Life Support (BLS)</option>
                                    <option value="AC Ambulance">AC Ambulance</option>
                                    <option value="Non-AC Ambulance">Non-AC Ambulance</option>
                                    <option value="Neonatal ICU Ambulance">Neonatal ICU Ambulance</option>
                                </select>
                            </div>
                        </div>

                        <div class="form-group">
                            <label asp-for="Urgency" class="font-weight-bold">Urgency Level</label>
                            <select asp-for="Urgency" class="form-control">
                                <option value="Emergency (Immediate Dispatch)">Emergency (Immediate Dispatch)</option>
                                <option value="Urgent (Within 1 Hour)">Urgent (Within 1 Hour)</option>
                                <option value="Scheduled Patient Transfer">Scheduled Patient Transfer</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label asp-for="Notes" class="font-weight-bold">Medical Condition / Special Instructions</label>
                            <textarea asp-for="Notes" class="form-control" rows="2" placeholder="Briefly describe patient's condition (e.g. Oxygen needed, stretcher needed, cardiac issue)..."></textarea>
                        </div>

                        <div class="text-center mt-4">
                            <button type="submit" class="btn btn-danger btn-lg font-weight-bold px-5">
                                <i class="fas fa-bell mr-2"></i>Submit Emergency Request
                            </button>
                            <div class="mt-2">
                                <a asp-action="Ambulances" class="text-muted small">Cancel and back to ambulance list</a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
