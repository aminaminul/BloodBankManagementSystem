@model BBDMS.Model.Models.Entities.AmbulanceRequest
@{
    ViewData["Title"] = "Emergency Ambulance Request";
}

<section class="page-hero-sm" style="background:linear-gradient(135deg,#e63946 0%,#9b1a26 100%); color:#fff; padding:56px 0 40px;">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-2" style="background:transparent; padding:0;">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-white-50">Home</a></li>
                <li class="breadcrumb-item"><a asp-controller="Emergency" asp-action="Ambulances" class="text-white-50">Ambulances</a></li>
                <li class="breadcrumb-item active text-white" aria-current="page">Request Dispatch</li>
            </ol>
        </nav>
        <h1 class="fw-bold mb-1" style="font-size:2rem;">Emergency Ambulance Dispatch</h1>
        <p class="mb-0 text-white-50">Submit an urgent dispatch request &mdash; our ambulance team will call you immediately.</p>
    </div>
</section>

<section class="py-5" style="background:#f8fafc;">
    <div class="container py-2">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card-modern p-4 p-md-5">
                    @if (ViewBag.SelectedProvider != null)
                    {
                        <div class="alert alert-info d-flex align-items-center mb-4" role="alert">
                            <i class="fas fa-info-circle fa-lg me-3"></i>
                            <div>
                                Requesting dispatch from: <strong>@ViewBag.SelectedProvider</strong>
                                @if (ViewBag.AmbulanceType != null)
                                {
                                    <span class="badge-soft-primary ms-2">@ViewBag.AmbulanceType</span>
                                }
                            </div>
                        </div>
                    }

                    <div class="mb-4 pb-3 border-bottom">
                        <h4 class="fw-bold text-dark mb-1">
                            <i class="fas fa-ambulance me-2 text-danger"></i>Patient &amp; Pickup Information
                        </h4>
                        <p class="text-muted small mb-0">Fill out the pickup location so the driver can navigate to you promptly.</p>
                    </div>

                    <form method="post" asp-action="RequestAmbulance">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="AmbulanceServiceId" />

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="PatientName" class="form-label fw-semibold">Patient Name <span class="text-danger">*</span></label>
                                <input asp-for="PatientName" class="form-control form-control-modern" placeholder="Patient's full name" required />
                                <span asp-validation-for="PatientName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ContactNumber" class="form-label fw-semibold">Emergency Contact Phone <span class="text-danger">*</span></label>
                                <input asp-for="ContactNumber" class="form-control form-control-modern" placeholder="e.g. 01712345678" required />
                                <span asp-validation-for="ContactNumber" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PickupAddress" class="form-label fw-semibold">Pickup Address &amp; Landmarks <span class="text-danger">*</span></label>
                            <textarea asp-for="PickupAddress" class="form-control form-control-modern" rows="3" placeholder="Provide complete pickup address, house/road number, area and recognizable landmarks..." required></textarea>
                            <span asp-validation-for="PickupAddress" class="text-danger small"></span>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="DestinationHospital" class="form-label fw-semibold">Destination Hospital (if decided)</label>
                                <input asp-for="DestinationHospital" class="form-control form-control-modern" placeholder="e.g. City Central Hospital" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="AmbulanceType" class="form-label fw-semibold">Required Ambulance Type</label>
                                <select asp-for="AmbulanceType" class="form-select form-control-modern">
                                    <option value="Advanced Life Support (ALS) / ICU">Advanced Life Support (ALS) / ICU</option>
                                    <option value="Basic Life Support (BLS)">Basic Life Support (BLS)</option>
                                    <option value="AC Ambulance">AC Ambulance</option>
                                    <option value="Non-AC Ambulance">Non-AC Ambulance</option>
                                    <option value="Neonatal ICU Ambulance">Neonatal ICU Ambulance</option>
                                </select>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Urgency" class="form-label fw-semibold">Urgency Level</label>
                            <select asp-for="Urgency" class="form-select form-control-modern">
                                <option value="Emergency (Immediate Dispatch)">Emergency (Immediate Dispatch)</option>
                                <option value="Urgent (Within 1 Hour)">Urgent (Within 1 Hour)</option>
                                <option value="Scheduled Patient Transfer">Scheduled Patient Transfer</option>
                            </select>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Notes" class="form-label fw-semibold">Medical Condition / Special Instructions</label>
                            <textarea asp-for="Notes" class="form-control form-control-modern" rows="2" placeholder="Briefly describe patient's condition (e.g. Oxygen needed, stretcher needed, cardiac issue)..."></textarea>
                        </div>

                        <div class="text-center pt-3 border-top">
                            <button type="submit" class="btn btn-brand-red px-5 py-2 fs-6">
                                <i class="fas fa-bell me-2"></i>Submit Emergency Dispatch Request
                            </button>
                            <div class="mt-3">
                                <a asp-action="Ambulances" class="text-muted small">Cancel and back to ambulance fleets</a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
