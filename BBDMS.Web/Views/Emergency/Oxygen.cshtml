@model IEnumerable<BBDMS.Model.Models.Entities.OxygenService>
@{
    ViewData["Title"] = "Oxygen When You Need It - Blood Bank";
    var providers = Model ?? Enumerable.Empty<BBDMS.Model.Models.Entities.OxygenService>();
}

<section class="page-head">
    <div class="container">
        <nav aria-label="Breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item"><a asp-action="Index">Emergency</a></li>
                <li class="breadcrumb-item active" aria-current="page">Medical oxygen</li>
            </ol>
        </nav>
        <div class="page-head-row">
            <div>
                <p class="eyebrow">Oxygen supply</p>
                <h1>Medical oxygen, delivered when it counts.</h1>
                <p>Cylinders, concentrators and 24/7 refills from verified suppliers, with home delivery where available.</p>
            </div>
            <div class="page-head-actions">
                <a class="btn btn-ghost" asp-action="Hospitals">
                    <i class="fas fa-hospital" aria-hidden="true"></i> Hospitals with ICU
                </a>
            </div>
        </div>
    </div>
</section>

<section class="section-tight">
    <div class="container">

        <form method="get" asp-action="Oxygen" class="filter-bar" role="search" data-reveal>
            <div class="filter-bar-grid">
                <div>
                    <label for="oxyLocation">City or location</label>
                    <input id="oxyLocation" type="text" name="location" value="@ViewBag.Location" class="form-control" placeholder="e.g. Dhaka, Chattogram, Sylhet" autocomplete="address-level2" />
                </div>
                <div class="filter-checks">
                    <label class="check">
                        <input type="checkbox" name="homeDeliveryOnly" value="true" @(ViewBag.HomeDeliveryOnly == true ? "checked" : "") />
                        <span>Home delivery only</span>
                    </label>
                </div>
                <div class="filter-actions">
                    <button type="submit" class="btn btn-ink"><i class="fas fa-magnifying-glass" aria-hidden="true"></i> Search suppliers</button>
                    <a class="btn btn-ghost" asp-action="Oxygen">Reset</a>
                </div>
            </div>
        </form>

        @if (providers.Any())
        {
            <div class="provider-grid mt-5">
                @foreach (var oxy in providers)
                {
                    var inStock = oxy.OxygenAvailability == "In Stock";
                    <article class="provider-card" data-reveal>
                        <header class="provider-head">
                            <span class="provider-ico"><i class="fas fa-lungs" aria-hidden="true"></i></span>
                            <div>
                                <h3>@oxy.ProviderName</h3>
                                <p class="meta"><i class="fas fa-location-dot" aria-hidden="true"></i>@oxy.Location</p>
                            </div>
                        </header>

                        <div class="provider-tags">
                            <span class="@(inStock ? "is-ok" : "")">
                                <i class="fas @(inStock ? "fa-circle-check" : "fa-clock")" aria-hidden="true"></i>@oxy.OxygenAvailability
                            </span>
                            @if (oxy.HomeDeliveryAvailable)
                            {
                                <span class="is-blood"><i class="fas fa-truck" aria-hidden="true"></i>Home delivery</span>
                            }
                        </div>

                        <dl class="provider-facts">
                            <div><dt>Cylinder capacity</dt><dd>@oxy.CylinderCapacity</dd></div>
                        </dl>

                        @if (!string.IsNullOrEmpty(oxy.ServiceDetails))
                        {
                            <p class="provider-note line-clamp-2">@oxy.ServiceDetails</p>
                        }

                        <footer>
                            <div>
                                <span class="meta-label">Order line</span>
                                <a class="phone" href="tel:@oxy.ContactNumber">@oxy.ContactNumber</a>
                            </div>
                            <a href="tel:@oxy.ContactNumber" class="btn btn-blood btn-sm">
                                <i class="fas fa-phone" aria-hidden="true"></i> Order / refill
                            </a>
                        </footer>
                    </article>
                }
            </div>
        }
        else
        {
            <div class="empty-state mt-5">
                <i class="fas fa-lungs" aria-hidden="true"></i>
                <h4>No oxygen suppliers match that search</h4>
                <p>Clear the filters, or call the central emergency helpline and we will source oxygen for you.</p>
                <a asp-action="Oxygen" class="btn btn-ink">Clear filters</a>
            </div>
        }
    </div>
</section>
