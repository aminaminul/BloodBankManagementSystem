@model IEnumerable<BBDMS.Model.Models.Entities.BloodRequest>
@using System.Linq
@{
    ViewData["Title"] = "Blood requests board";
    var bloodGroups = ViewBag.BloodGroups as IEnumerable<BBDMS.Model.Models.Entities.BloodGroup>;
    var location = ViewBag.Location as string;
    var selectedGroup = ViewBag.BloodGroup as string;
    var list = Model?.ToList() ?? new List<BBDMS.Model.Models.Entities.BloodRequest>();
}

<section class="page-head">
    <div class="container">
        <nav aria-label="Breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item"><a asp-controller="Emergency" asp-action="Index">Emergency hub</a></li>
                <li class="breadcrumb-item active" aria-current="page">Blood requests</li>
            </ol>
        </nav>
        <div class="page-head-row">
            <div>
                <p class="eyebrow">Live request board</p>
                <h1>Patients waiting for blood</h1>
                <p>Requirements posted by hospitals and families. Respond to a request, or publish your own.</p>
            </div>
            <div class="page-head-actions">
                <a class="btn btn-blood" asp-action="CreateBloodRequest">
                    <i class="fas fa-plus" aria-hidden="true"></i> Post a blood request
                </a>
            </div>
        </div>
    </div>
</section>

<section class="section-tight">
    <div class="container">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success d-flex align-items-start gap-2 mb-4" role="status">
                <i class="fas fa-circle-check" aria-hidden="true"></i><span>@TempData["Success"]</span>
            </div>
        }

        <div class="filter-bar mb-5">
            <form method="get" asp-action="BloodRequests" role="search">
                <div class="row g-3 align-items-end">
                    <div class="col-md-5">
                        <label for="reqLoc">Location / city / hospital</label>
                        <input id="reqLoc" type="text" name="location" value="@location" class="form-control"
                               placeholder="Search city or hospital name" autocomplete="address-level2" />
                    </div>
                    <div class="col-md-4">
                        <label for="reqGroup">Required blood group</label>
                        <select id="reqGroup" name="bloodGroup" class="form-select">
                            <option value="All">All blood groups</option>
                            @if (bloodGroups != null)
                            {
                                foreach (var bg in bloodGroups)
                                {
                                    <option value="@bg.GroupName" selected="@(string.Equals(selectedGroup, bg.GroupName, StringComparison.OrdinalIgnoreCase))">@bg.GroupName</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <button type="submit" class="btn btn-ink w-100" style="height:46px">
                            <i class="fas fa-filter" aria-hidden="true"></i> Filter requests
                        </button>
                    </div>
                </div>
            </form>
        </div>

        @if (list.Any())
        {
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
                <p class="meta" style="margin:0"><span class="num">@list.Count</span> open request@(list.Count == 1 ? "" : "s")</p>
                <span class="live-pill"><span class="live-dot" aria-hidden="true"></span> Updated live</span>
            </div>

            <div class="row g-4">
                @foreach (var req in list)
                {
                    var critical = req.Urgency != null && req.Urgency.Contains("Critical", StringComparison.OrdinalIgnoreCase);
                    var fulfilled = string.Equals(req.Status, "Fulfilled", StringComparison.OrdinalIgnoreCase);
                    <div class="col-lg-6">
                        <article class="request-card" data-motion>
                            <div class="request-group">
                                <span class="g">@(req.BloodGroup ?? req.BloodRequireFor)</span>
                                <span class="u">@req.UnitsRequired unit@(req.UnitsRequired > 1 ? "s" : "")</span>
                            </div>
                            <div class="request-body">
                                <div class="request-tags">
                                    @if (critical)
                                    {
                                        <span class="tag tag-blood"><i class="fas fa-circle-exclamation" aria-hidden="true"></i> Critical</span>
                                    }
                                    else
                                    {
                                        <span class="tag tag-warn">@(req.Urgency ?? "Urgent")</span>
                                    }
                                    <span class="tag @(fulfilled ? "tag-ok" : "tag-muted")">@(req.Status ?? "Open")</span>
                                </div>

                                <h3 class="request-title">@(string.IsNullOrEmpty(req.HospitalName) ? "Emergency medical requirement" : req.HospitalName)</h3>
                                <p class="request-meta">
                                    <span><i class="fas fa-location-dot" aria-hidden="true"></i> @(string.IsNullOrEmpty(req.Location) ? "Emergency ward" : req.Location)</span>
                                    <span>· @req.BloodRequireFor</span>
                                    <span>· @(req.ApplyDate.HasValue ? req.ApplyDate.Value.ToString("dd MMM, HH:mm") : "Recently")</span>
                                </p>

                                @if (!string.IsNullOrEmpty(req.Message))
                                {
                                    <p class="request-notes">@req.Message</p>
                                }

                                <div class="request-foot">
                                    <div>
                                        <div class="request-contact">
                                            <i class="fas fa-phone" aria-hidden="true"></i>
                                            @if (!string.IsNullOrEmpty(req.ContactNumber))
                                            {
                                                <a href="tel:@req.ContactNumber" style="color:inherit">@req.ContactNumber</a>
                                            }
                                        </div>
                                        @if (!string.IsNullOrEmpty(req.Name))
                                        {
                                            <div class="meta" style="margin-top:2px;font-size:.6rem">Contact: @req.Name</div>
                                        }
                                    </div>
                                    <div class="d-flex gap-2">
                                        <a class="btn btn-ghost btn-sm" asp-action="RequestDetails" asp-route-id="@req.ID">Details</a>
                                        @if (!string.IsNullOrEmpty(req.ContactNumber))
                                        {
                                            <a class="btn btn-blood btn-sm" href="tel:@req.ContactNumber">
                                                <i class="fas fa-phone" aria-hidden="true"></i> Respond
                                            </a>
                                        }
                                    </div>
                                </div>
                            </div>
                        </article>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="fas fa-heart-pulse" aria-hidden="true"></i>
                <h4>No open blood requests</h4>
                <p>Nothing is waiting right now. If a patient needs blood, publish a request and compatible donors will see it immediately.</p>
                <div class="d-flex flex-wrap justify-content-center gap-2">
                    <a class="btn btn-blood" asp-action="CreateBloodRequest"><i class="fas fa-plus" aria-hidden="true"></i> Post a request</a>
                    <a class="btn btn-ghost" asp-controller="Donor" asp-action="Search">Find donors</a>
                </div>
            </div>
        }
    </div>
</section>
