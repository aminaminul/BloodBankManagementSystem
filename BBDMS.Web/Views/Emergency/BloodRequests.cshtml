@model IEnumerable<BBDMS.Model.Models.Entities.BloodRequest>
@{
    ViewData["Title"] = "Emergency Blood Requests Board";
    var bloodGroups = ViewBag.BloodGroups as IEnumerable<BBDMS.Model.Models.Entities.BloodGroup>;
}

<div class="inner-banner py-5" style="background: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.6)), url('/images/banner1.jpg') no-repeat center; background-size: cover;">
    <div class="container py-lg-4 text-center">
        <h2 class="text-white font-weight-bold">Live Emergency Blood Requests Board</h2>
        <p class="text-light mt-2">Urgent blood requirements submitted by hospitals, families, and patients across regions</p>
    </div>
</div>

<div class="container my-5">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-center mb-4">
        <div>
            <h3 class="font-weight-bold text-dark mb-0">Active Blood Inquiries</h3>
            <p class="text-muted mb-0">Donors can respond to emergencies immediately</p>
        </div>
        <a asp-action="CreateBloodRequest" class="btn btn-danger btn-lg font-weight-bold shadow-sm mt-3 mt-md-0">
            <i class="fas fa-plus-circle mr-2"></i>Post Emergency Request
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle mr-2"></i>@TempData["Success"]
            <button type="button" class="close" data-dismiss="alert">&times;</button>
        </div>
    }

    <!-- Search/Filter Bar -->
    <div class="card shadow-sm border-0 mb-4 bg-light">
        <div class="card-body p-3">
            <form method="get" asp-action="BloodRequests">
                <div class="row align-items-end">
                    <div class="col-md-5 mb-2 mb-md-0">
                        <label class="small font-weight-bold text-muted">Filter by Location / City / Hospital</label>
                        <input type="text" name="location" value="@ViewBag.Location" class="form-control" placeholder="Search city or hospital name..." />
                    </div>
                    <div class="col-md-4 mb-2 mb-md-0">
                        <label class="small font-weight-bold text-muted">Required Blood Group</label>
                        <select name="bloodGroup" class="form-control">
                            <option value="All">All Blood Groups</option>
                            @if (bloodGroups != null)
                            {
                                foreach (var bg in bloodGroups)
                                {
                                    <option value="@bg.GroupName" selected="@(ViewBag.BloodGroup == bg.GroupName)">@bg.GroupName</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <button type="submit" class="btn btn-danger btn-block font-weight-bold">
                            <i class="fas fa-filter mr-1"></i>Filter Requests
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Requests Grid -->
    @if (Model != null && Model.Any())
    {
        <div class="row">
            @foreach (var req in Model)
            {
                <div class="col-lg-6 mb-4">
                    <div class="card h-100 shadow-sm border-0 position-relative">
                        <div class="card-header bg-white border-bottom-0 pt-3 pb-0 d-flex justify-content-between align-items-center">
                            <div>
                                <span class="badge badge-danger font-weight-bold px-3 py-2 mr-2" style="font-size: 1rem;">
                                    <i class="fas fa-tint mr-1"></i>@(req.BloodGroup ?? req.BloodRequireFor)
                                </span>
                                <span class="badge @(req.Urgency == "Critical" ? "badge-danger" : "badge-warning text-dark") font-weight-bold px-2 py-1">
                                    @req.Urgency Priority
                                </span>
                            </div>
                            <span class="badge @(req.Status == "Fulfilled" ? "badge-success" : req.Status == "Approved" ? "badge-primary" : "badge-secondary")">
                                Status: @req.Status
                            </span>
                        </div>
                        <div class="card-body">
                            <h5 class="font-weight-bold text-dark mb-1">
                                @(string.IsNullOrEmpty(req.HospitalName) ? "Emergency Medical Requirement" : req.HospitalName)
                            </h5>
                            <p class="text-muted small mb-2">
                                <i class="fas fa-map-marker-alt text-danger mr-1"></i>@(string.IsNullOrEmpty(req.Location) ? "Emergency Ward" : req.Location)
                            </p>

                            <div class="bg-light p-3 rounded mb-3">
                                <div class="row small">
                                    <div class="col-6 mb-1">
                                        <strong>Units Needed:</strong> <span class="badge badge-dark">@req.UnitsRequired Unit@(req.UnitsRequired > 1 ? "s" : "")</span>
                                    </div>
                                    <div class="col-6 mb-1">
                                        <strong>Reason:</strong> <span>@req.BloodRequireFor</span>
                                    </div>
                                    <div class="col-12 mt-2">
                                        <strong>Patient Notes:</strong>
                                        <p class="text-muted mb-0">@req.Message</p>
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                <div>
                                    <small class="text-muted d-block">Contact Person: @req.Name</small>
                                    <span class="font-weight-bold text-dark"><i class="fas fa-phone mr-1 text-success"></i>@req.ContactNumber</span>
                                </div>
                                <a href="tel:@req.ContactNumber" class="btn btn-danger font-weight-bold btn-sm">
                                    <i class="fas fa-phone-alt mr-1"></i>Call Requester
                                </a>
                            </div>
                        </div>
                        <div class="card-footer bg-light small text-muted text-right">
                            Posted: @(req.ApplyDate.HasValue ? req.ApplyDate.Value.ToString("MMM dd, yyyy - hh:mm tt") : "Recently")
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info text-center p-5">
            <i class="fas fa-heart fa-2x mb-3 text-danger"></i>
            <h4>No active emergency blood requests found</h4>
            <p>If you or someone you know needs blood urgently, submit a request now.</p>
            <a asp-action="CreateBloodRequest" class="btn btn-danger font-weight-bold">Post Blood Request</a>
        </div>
    }
</div>
