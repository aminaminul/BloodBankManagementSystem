@model IEnumerable<BBDMS.Model.Models.Entities.BloodRequest>
@{
    ViewData["Title"] = "Emergency Blood Requests Board";
    var bloodGroups = ViewBag.BloodGroups as IEnumerable<BBDMS.Model.Models.Entities.BloodGroup>;
}

<section class="page-hero-sm" style="background:linear-gradient(135deg,#e63946 0%,#9b1a26 100%); color:#fff; padding:56px 0 40px;">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-2" style="background:transparent; padding:0;">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-white-50">Home</a></li>
                <li class="breadcrumb-item"><a asp-controller="Emergency" asp-action="Index" class="text-white-50">Emergency Hub</a></li>
                <li class="breadcrumb-item active text-white" aria-current="page">Blood Requests</li>
            </ol>
        </nav>
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div>
                <h1 class="fw-bold mb-1" style="font-size:2rem;">Live Blood Requests Board</h1>
                <p class="mb-0 text-white-50">Urgent blood requirements submitted by hospitals, families, and patients across regions.</p>
            </div>
            <div>
                <a asp-action="CreateBloodRequest" class="btn btn-light text-danger fw-bold px-4 py-2" style="border-radius:50rem;">
                    <i class="fas fa-plus-circle me-2"></i>Post Blood Request
                </a>
            </div>
        </div>
    </div>
</section>

<section class="py-5" style="background:#f8fafc;">
    <div class="container py-2">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- Filter Card -->
        <div class="card-modern mb-4 p-3">
            <form method="get" asp-action="BloodRequests">
                <div class="row g-3 align-items-end">
                    <div class="col-md-5">
                        <label class="form-label small fw-bold text-muted">Filter by Location / City / Hospital</label>
                        <input type="text" name="location" value="@ViewBag.Location" class="form-control form-control-modern" placeholder="Search city or hospital name..." />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-bold text-muted">Required Blood Group</label>
                        <select name="bloodGroup" class="form-select form-control-modern">
                            <option value="All">All Blood Groups</option>
                            @if (bloodGroups != null)
                            {
                                foreach (var bg in bloodGroups)
                                {
                                    <option value="@bg.GroupName" selected="@(ViewBag.BloodGroup == bg.GroupName)">@bg.GroupName</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <button type="submit" class="btn btn-brand-red w-100">
                            <i class="fas fa-filter me-2"></i>Filter Requests
                        </button>
                    </div>
                </div>
            </form>
        </div>

        <!-- Requests Grid -->
        @if (Model != null && Model.Any())
        {
            <div class="row g-4">
                @foreach (var req in Model)
                {
                    <div class="col-lg-6">
                        <div class="card-modern h-100 d-flex flex-column p-4 position-relative">
                            <div class="d-flex justify-content-between align-items-start mb-3 gap-2">
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    <span class="badge-soft-danger fw-bold px-3 py-2" style="font-size: 1.05rem;">
                                        <i class="fas fa-tint me-1"></i>@(req.BloodGroup ?? req.BloodRequireFor)
                                    </span>
                                    <span class="badge @(req.Urgency == "Critical" || req.Urgency?.Contains("Critical") == true ? "badge-soft-danger" : "badge-soft-warning") fw-semibold px-2 py-1">
                                        @req.Urgency Priority
                                    </span>
                                </div>
                                <span class="badge @(req.Status == "Fulfilled" ? "badge-soft-success" : req.Status == "Approved" ? "badge-soft-primary" : "badge-soft-secondary") px-2 py-1">
                                    Status: @req.Status
                                </span>
                            </div>

                            <div class="mb-3">
                                <h5 class="fw-bold text-dark mb-1">
                                    @(string.IsNullOrEmpty(req.HospitalName) ? "Emergency Medical Requirement" : req.HospitalName)
                                </h5>
                                <div class="text-muted small">
                                    <i class="fas fa-map-marker-alt text-danger me-1"></i>@(string.IsNullOrEmpty(req.Location) ? "Emergency Ward" : req.Location)
                                </div>
                            </div>

                            <div class="p-3 rounded-3 mb-3" style="background:#f8fafc; border:1px solid #edf2f7;">
                                <div class="row g-2 small">
                                    <div class="col-6">
                                        <span class="text-muted">Units Needed:</span>
                                        <span class="badge-soft-primary ms-1">@req.UnitsRequired Unit@(req.UnitsRequired > 1 ? "s" : "")</span>
                                    </div>
                                    <div class="col-6">
                                        <span class="text-muted">Reason:</span>
                                        <span class="fw-semibold text-dark ms-1">@req.BloodRequireFor</span>
                                    </div>
                                    @if (!string.IsNullOrEmpty(req.Message))
                                    {
                                        <div class="col-12 mt-2 pt-2 border-top">
                                            <span class="text-muted d-block mb-1">Patient / Emergency Notes:</span>
                                            <p class="text-secondary mb-0 fst-italic">@req.Message</p>
                                        </div>
                                    }
                                </div>
                            </div>

                            <div class="mt-auto pt-3 border-top d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="text-muted small">Contact: <strong>@req.Name</strong></div>
                                    <div class="fw-bold text-dark"><i class="fas fa-phone me-1 text-success"></i>@req.ContactNumber</div>
                                </div>
                                <a href="tel:@req.ContactNumber" class="btn btn-brand-red btn-sm px-3">
                                    <i class="fas fa-phone-alt me-1"></i>Call Now
                                </a>
                            </div>

                            <div class="text-muted small mt-2 pt-1 text-end" style="font-size:0.75rem;">
                                Posted: @(req.ApplyDate.HasValue ? req.ApplyDate.Value.ToString("MMM dd, yyyy - hh:mm tt") : "Recently")
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="card-modern text-center py-5">
                <div class="mb-3">
                    <i class="fas fa-heartbeat fa-3x text-danger opacity-75"></i>
                </div>
                <h4 class="fw-bold text-dark">No Active Emergency Blood Requests Found</h4>
                <p class="text-muted mb-4">If you or a patient needs blood urgently, submit a request to alert donors instantly.</p>
                <div>
                    <a asp-action="CreateBloodRequest" class="btn btn-brand-red px-4 py-2">
                        <i class="fas fa-plus-circle me-2"></i>Post Blood Request
                    </a>
                </div>
            </div>
        }
    </div>
</section>
