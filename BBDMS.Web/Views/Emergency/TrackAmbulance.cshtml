@model BBDMS.Model.Models.Entities.AmbulanceRequest
@using BBDMS.Model.Models.ViewModels
@{
    ViewData["Title"] = "Track Ambulance Dispatch";
    var contact = ViewBag.Contact as string;
    var provider = ViewBag.Provider as BBDMS.Model.Models.Entities.AmbulanceService;
    var request = Model;
    var status = AmbulanceTracking.NormalizeStatus(request?.Status);
    var steps = AmbulanceTracking.BuildSteps(request);
    var progress = AmbulanceTracking.ProgressPercent(status);
}

<section class="page-head">
    <div class="container">
        <nav aria-label="Breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item"><a asp-action="Ambulances">Ambulances</a></li>
                <li class="breadcrumb-item active" aria-current="page">Track dispatch</li>
            </ol>
        </nav>
        <div class="page-head-row">
            <div>
                <p class="eyebrow">Live dispatch</p>
                <h1>Track your ambulance dispatch.</h1>
                <p>Status updates automatically while the vehicle is on the way. Keep this page open during the transfer.</p>
            </div>
            <div class="page-head-actions">
                <a asp-action="AmbulanceContact" class="btn btn-ghost">
                    <i class="fas fa-address-book" aria-hidden="true"></i> Emergency contacts
                </a>
                <a asp-action="RequestAmbulance" class="btn btn-blood">
                    <i class="fas fa-bell" aria-hidden="true"></i> Book a dispatch
                </a>
            </div>
        </div>
    </div>
</section>

<section class="section-tight">
    <div class="container">

        <form method="get" asp-action="TrackAmbulance" class="filter-bar" data-reveal>
            <div class="filter-bar-grid is-inline">
                <div>
                    <label for="trackContact">Contact number used for the booking</label>
                    <input id="trackContact" type="tel" name="contact" value="@contact" class="form-control" placeholder="e.g. 01712345678" autocomplete="tel" />
                </div>
                <div class="filter-actions">
                    <button type="submit" class="btn btn-ink"><i class="fas fa-location-crosshairs" aria-hidden="true"></i> Track dispatch</button>
                </div>
            </div>
        </form>

        @if (request == null)
        {
            <div class="empty-state mt-5">
                <i class="fas fa-truck-medical" aria-hidden="true"></i>
                <h4>No dispatch found for that number</h4>
                <p>Check the contact number used when booking, or start a new dispatch request — the team calls back immediately.</p>
                <div class="d-flex flex-wrap justify-content-center gap-2">
                    <a asp-action="RequestAmbulance" class="btn btn-blood">Book a dispatch</a>
                    <a asp-action="AmbulanceContact" class="btn btn-ghost">Emergency contacts</a>
                </div>
            </div>
        }
        else
        {
            var ambShareUrl = Context.Request.Scheme + "://" + Context.Request.Host + Context.Request.Path + Context.Request.QueryString;
            var ambShareMsg = $"🚨 Ambulance dispatched for {request.PatientName}. Live Status: {AmbulanceTracking.StatusLabel(status)}. Track live here: {ambShareUrl}";
            var ambWaUrl = "https://api.whatsapp.com/send?text=" + System.Net.WebUtility.UrlEncode(ambShareMsg);

            <div class="detail-layout mt-5">
                <div class="detail-main">
                    <article class="panel" data-motion>
                        <div class="panel-head">
                            <div>
                                <span class="meta-label">Dispatch #@request.Id</span>
                                <h2>@request.PatientName</h2>
                            </div>
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <span class="live-pill" id="ambLivePill"><span class="live-dot" aria-hidden="true"></span> Live</span>
                                <span id="ambStatusBadge" class="@AmbulanceTracking.StatusBadge(status)">
                                    <i class="fas @AmbulanceTracking.StatusIcon(status)" aria-hidden="true"></i>
                                    <span id="ambStatusLabel">@AmbulanceTracking.StatusLabel(status)</span>
                                </span>
                            </div>
                        </div>

                        <dl class="detail-list">
                            <div><dt>Pickup</dt><dd>@request.PickupAddress</dd></div>
                            <div><dt>Destination</dt><dd>@(string.IsNullOrEmpty(request.DestinationHospital) ? "Not decided yet" : request.DestinationHospital)</dd></div>
                            <div><dt>Ambulance type</dt><dd>@request.AmbulanceType</dd></div>
                            <div><dt>Urgency</dt><dd>@request.Urgency</dd></div>
                            <div><dt>Booked</dt><dd>@request.RequestDate.ToString("dd MMM yyyy, hh:mm tt")</dd></div>
                            <div><dt>Contact</dt><dd><a class="phone" href="tel:@request.ContactNumber">@request.ContactNumber</a></dd></div>
                        </dl>

                        @if (provider != null)
                        {
                            <div class="hospital-row">
                                <div>
                                    <span class="meta-label">Assigned fleet</span>
                                    <p class="hospital-name">@provider.ProviderName</p>
                                    <p class="meta"><i class="fas fa-location-dot" aria-hidden="true"></i>@provider.Location</p>
                                </div>
                                <a href="tel:@provider.ContactNumber" class="btn btn-blood btn-sm">
                                    <i class="fas fa-phone" aria-hidden="true"></i> @provider.ContactNumber
                                </a>
                            </div>
                        }
                    </article>

                    <article class="panel" data-motion>
                        <div class="panel-head">
                            <h2>Dispatch timeline</h2>
                            <span class="meta">Updated <span id="ambUpdated">@DateTime.Now.ToString("hh:mm:ss tt")</span></span>
                        </div>
                        <p class="panel-note" id="ambEta" style="margin-top:8px">@AmbulanceTracking.EtaText(status)</p>

                        <div class="progress" style="height:6px;margin-bottom:var(--s5)">
                            <div class="progress-bar" id="ambProgress" role="progressbar" style="width:@progress%" aria-valuenow="@progress" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>

                        <ul class="track-timeline track-timeline-live" id="ambTimeline" data-motion-stagger>
                            @foreach (var step in steps)
                            {
                                var cls = step.Done ? "done" : step.Current ? "current" : "";
                                if (step.Cancelled) { cls = "current cancelled"; }
                                <li class="@cls">
                                    <span class="dot"><i class="fas @step.Icon" aria-hidden="true"></i></span>
                                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                                        <div>
                                            <div class="t-title">@step.Title</div>
                                            <div class="t-sub">@step.Sub</div>
                                        </div>
                                        <span class="t-time">@step.Time</span>
                                    </div>
                                </li>
                            }
                        </ul>
                    </article>
                </div>

                <aside class="detail-aside">
                    <div class="panel panel-sticky" data-motion>
                        <h2>Need the dispatcher?</h2>
                        <p class="panel-note">Call the fleet directly, or open the contact desk for national hotlines.</p>
                        @if (provider != null)
                        {
                            <a href="tel:@provider.ContactNumber" class="btn btn-blood btn-block">
                                <i class="fas fa-phone" aria-hidden="true"></i> Call fleet
                            </a>
                        }
                        <a asp-action="AmbulanceContact" asp-route-id="@request.Id" class="btn btn-ghost btn-block mt-2">
                            <i class="fas fa-address-book" aria-hidden="true"></i> Emergency contacts
                        </a>

                        <div class="aside-divider">
                            <h3>Share live status</h3>
                            <p class="panel-note">Send the tracking link to family so they can follow the transfer.</p>
                            <a href="@ambWaUrl" target="_blank" rel="noopener noreferrer" class="btn share-wa btn-block btn-sm">
                                <i class="fab fa-whatsapp" aria-hidden="true"></i> Share on WhatsApp
                            </a>
                        </div>

                        @if (!string.IsNullOrEmpty(request.Notes))
                        {
                            <div class="aside-divider">
                                <span class="meta-label">Medical notes</span>
                                <p class="panel-note" style="margin:0">@request.Notes</p>
                            </div>
                        }

                        <a asp-action="RequestAmbulance" class="link-arrow mt-4">
                            Book another ambulance <i class="fas fa-arrow-right" aria-hidden="true"></i>
                        </a>
                    </div>
                </aside>
            </div>
        }
    </div>
</section>

@section Scripts {
    @if (request != null)
    {
        <script>
            (function () {
                var requestId = @request.Id;
                var endpoint = '@Url.Action("AmbulanceStatus", "Emergency", new { token = request.TrackingToken })';
                var pollTimer = null;

                // Signature of the server rendered timeline so the first poll does not re-render needlessly
                function currentSignature() {
                    var parts = [];
                    document.querySelectorAll('#ambTimeline li').forEach(function (li) {
                        var t = li.querySelector('.t-title');
                        parts.push((li.classList.contains('done') ? '1' : '0') +
                                   (li.classList.contains('current') ? 'c' : '') +
                                   (t ? t.textContent.trim() : ''));
                    });
                    return parts.join('|');
                }
                var lastSignature = currentSignature();

                function esc(value) {
                    return String(value == null ? '' : value)
                        .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
                        .replace(/"/g, '&quot;').replace(/'/g, '&#039;');
                }

                function renderSteps(steps) {
                    var list = document.getElementById('ambTimeline');
                    if (!list || !steps) return;
                    var signature = steps.map(function (s) { return (s.done ? '1' : '0') + (s.current ? 'c' : '') + s.title; }).join('|');
                    if (signature === lastSignature) return;

                    var previousDone = {};
                    list.querySelectorAll('li').forEach(function (li) {
                        var t = li.querySelector('.t-title');
                        if (t) previousDone[t.textContent.trim()] = li.classList.contains('done');
                    });

                    list.innerHTML = '';
                    steps.forEach(function (step, index) {
                        var li = document.createElement('li');
                        li.className = step.done ? 'done' : (step.current ? 'current' : '');
                        if (step.cancelled) { li.className = 'current cancelled'; }
                        li.style.setProperty('--i', index);
                        if (previousDone[step.title] === false && step.done) { li.classList.add('step-flash'); }
                        li.innerHTML =
                            '<span class="dot"><i class="fas ' + esc(step.icon) + '"></i></span>' +
                            '<div class="d-flex justify-content-between align-items-start flex-wrap gap-2">' +
                                '<div>' +
                                    '<div class="t-title">' + esc(step.title) + '</div>' +
                                    '<div class="t-sub">' + esc(step.sub) + '</div>' +
                                '</div>' +
                                '<span class="t-time">' + esc(step.time) + '</span>' +
                            '</div>';
                        list.appendChild(li);
                    });

                    // Re-draw so a freshly pushed step animates in like the first render
                    list.classList.remove('is-drawn');
                    void list.offsetWidth;
                    list.classList.add('is-drawn');

                    lastSignature = signature;
                }

                function render(payload) {
                    if (!payload) return;
                    var label = document.getElementById('ambStatusLabel');
                    var badge = document.getElementById('ambStatusBadge');
                    var eta = document.getElementById('ambEta');
                    var updated = document.getElementById('ambUpdated');
                    var progress = document.getElementById('ambProgress');
                    var pill = document.getElementById('ambLivePill');

                    if (label) label.textContent = payload.statusLabel;
                    if (badge) {
                        badge.className = payload.badge;
                        badge.innerHTML = '<i class="fas ' + esc(payload.icon) + '"></i><span id="ambStatusLabel">' + esc(payload.statusLabel) + '</span>';
                    }
                    if (eta) eta.textContent = payload.eta;
                    if (updated) updated.textContent = payload.updatedAt;
                    if (progress && typeof payload.progress === 'number') {
                        progress.style.width = payload.progress + '%';
                    }
                    if (pill) { pill.classList.toggle('is-idle', !payload.isActive); }

                    renderSteps(payload.steps);

                    // Stop polling once the dispatch is closed (completed or cancelled)
                    if (!payload.isActive && pollTimer !== null) { clearInterval(pollTimer); pollTimer = null; }
                    if (payload.isActive && pollTimer === null) { startPolling(); }
                }

                function refresh() {
                    fetch(endpoint, { headers: { 'Accept': 'application/json' }, credentials: 'same-origin' })
                        .then(function (r) { return r.ok ? r.json() : null; })
                        .then(function (data) { if (data) render(data); })
                        .catch(function () { /* keep the last known state, poller retries */ });
                }

                function startPolling() {
                    if (pollTimer !== null) return;
                    pollTimer = setInterval(refresh, 10000);
                }

                // Real-time status push from the hub (also covers other tabs / dispatcher actions)
                if (window.signalR) {
                    var hub = new signalR.HubConnectionBuilder()
                        .withUrl('/emergencyHub')
                        .withAutomaticReconnect()
                        .build();
                    hub.on('ReceiveAmbulanceStatusUpdate', function (data) {
                        if (!data || parseInt(data.id, 10) !== requestId) return;
                        refresh();
                    });
                    hub.start().catch(function () { /* polling keeps the page live */ });
                }

                startPolling();
                document.addEventListener('visibilitychange', function () {
                    if (!document.hidden) refresh();
                });
            })();
        </script>
    }
}
