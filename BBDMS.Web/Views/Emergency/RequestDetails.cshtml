@model BBDMS.Model.Models.Entities.BloodRequest
@{
    ViewData["Title"] = "Blood Request Details";
    var hospital = ViewBag.Hospital as BBDMS.Model.Models.Entities.Hospital;
    var urgency = string.IsNullOrEmpty(Model.Urgency) ? "Urgent" : Model.Urgency;
    var isCritical = urgency.Contains("Critical");
    var status = string.IsNullOrEmpty(Model.Status) ? "Pending" : Model.Status;
    var group = Model.BloodGroup ?? Model.BloodRequireFor;

    var reqUnits = Model.UnitsRequired > 0 ? Model.UnitsRequired.ToString() : "1";
    var reqHospital = Model.HospitalName ?? "Emergency Hospital";
    var reqLoc = string.IsNullOrEmpty(Model.Location) ? "" : $"in {Model.Location}";
    var currentUrl = Context.Request.Scheme + "://" + Context.Request.Host + Context.Request.Path + Context.Request.QueryString;
    var msgText = $"🚨 URGENT: {reqUnits} unit(s) of {group} blood urgently needed at {reqHospital} {reqLoc}. Respond or view details here: {currentUrl}";
    var waUrl = "https://api.whatsapp.com/send?text=" + System.Net.WebUtility.UrlEncode(msgText);
    var tgUrl = "https://t.me/share/url?url=" + System.Net.WebUtility.UrlEncode(currentUrl) + "&text=" + System.Net.WebUtility.UrlEncode($"🚨 URGENT: {group} Blood needed at {reqHospital}");
}

<section class="page-head">
    <div class="container">
        <nav aria-label="Breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item"><a asp-action="BloodRequests">Blood requests</a></li>
                <li class="breadcrumb-item active" aria-current="page">Request #@Model.ID</li>
            </ol>
        </nav>

        <div class="page-head-row">
            <div>
                <p class="eyebrow">@(isCritical ? "Critical request" : "Open request") · #@Model.ID</p>
                <h1><span class="blood-type">@group</span> blood needed at @reqHospital</h1>
                <p>
                    @reqUnits unit@(Model.UnitsRequired > 1 ? "s" : "") required@(string.IsNullOrEmpty(Model.Location) ? "" : ", " + Model.Location) · posted @(Model.ApplyDate?.ToString("dd MMM yyyy, HH:mm") ?? "recently")
                </p>
            </div>
            <div class="page-head-actions">
                <a asp-action="BloodRequests" class="btn btn-ghost"><i class="fas fa-arrow-left" aria-hidden="true"></i> All requests</a>
                <a href="tel:@Model.ContactNumber" class="btn btn-blood"><i class="fas fa-phone" aria-hidden="true"></i> Call the requester</a>
            </div>
        </div>

        <div class="request-flags" data-reveal>
            <span class="badge-soft@(isCritical ? " is-alert" : "")"><i class="fas fa-circle-exclamation" aria-hidden="true"></i>@urgency</span>
            <span class="badge-soft"><i class="fas fa-wave-square" aria-hidden="true"></i>Status: @status</span>
            <span class="badge-soft"><i class="fas fa-user-clock" aria-hidden="true"></i>Posted @(Model.ApplyDate?.ToString("dd MMM, HH:mm") ?? "recently")</span>
        </div>
    </div>
</section>

<section class="section-tight">
    <div class="container">
        <div class="detail-layout">

            <div class="detail-main">
                <article class="panel" data-reveal>
                    <h2>Request details</h2>
                    <dl class="detail-list">
                        <div><dt>Patient needs</dt><dd>@Model.BloodRequireFor</dd></div>
                        <div><dt>Contact person</dt><dd>@Model.Name</dd></div>
                        <div>
                            <dt>Phone</dt>
                            <dd><a href="tel:@Model.ContactNumber" class="phone">@Model.ContactNumber</a></dd>
                        </div>
                        <div><dt>Facility</dt><dd>@(Model.HospitalName ?? "Emergency facility")</dd></div>
                        <div><dt>Location</dt><dd>@(string.IsNullOrEmpty(Model.Location) ? "—" : Model.Location)</dd></div>
                    </dl>

                    @if (!string.IsNullOrEmpty(Model.Message))
                    {
                        <div class="note-block">
                            <h3>Notes from the requester</h3>
                            <p>@Model.Message</p>
                        </div>
                    }
                </article>

                @if (hospital != null)
                {
                    <article class="panel" data-reveal>
                        <h2>Hospital information</h2>
                        <div class="hospital-row">
                            <div>
                                <p class="hospital-name">@hospital.Name</p>
                                <p class="meta"><i class="fas fa-location-dot" aria-hidden="true"></i>@hospital.Address, @hospital.City</p>
                                <p class="meta"><i class="fas fa-phone" aria-hidden="true"></i>@hospital.EmergencyHelpline</p>
                            </div>
                            <a href="tel:@hospital.EmergencyHelpline" class="btn btn-ghost btn-sm">Call hospital</a>
                        </div>
                    </article>
                }
            </div>

            <aside class="detail-aside">
                <div class="panel panel-sticky" data-reveal>
                    <h2>Respond</h2>
                    <p class="panel-note">If you can donate, call the requester directly. Every minute counts.</p>
                    <a href="tel:@Model.ContactNumber" class="btn btn-blood btn-block"><i class="fas fa-phone" aria-hidden="true"></i> Respond now</a>

                    <div class="aside-divider">
                        <h3>Broadcast to your circle</h3>
                        <p class="panel-note">Share this request where local donors will see it.</p>
                        <div class="share-stack">
                            <a href="@waUrl" target="_blank" rel="noopener noreferrer" class="btn btn-block share-wa">
                                <i class="fab fa-whatsapp" aria-hidden="true"></i> WhatsApp
                            </a>
                            <a href="@tgUrl" target="_blank" rel="noopener noreferrer" class="btn btn-ghost btn-block">
                                <i class="fab fa-telegram" aria-hidden="true"></i> Telegram
                            </a>
                            <button type="button" class="btn btn-ghost btn-block" id="nativeShareBtn" onclick="shareEmergencyRequest()">
                                <i class="fas fa-share-nodes" aria-hidden="true"></i> Share
                            </button>
                            <button type="button" class="btn btn-ghost btn-block" id="copyLinkBtn">
                                <i class="fas fa-link" aria-hidden="true"></i> Copy link
                            </button>
                        </div>
                    </div>

                    <a asp-action="TrackRequest" class="link-arrow mt-4">
                        Track this request <i class="fas fa-arrow-right" aria-hidden="true"></i>
                    </a>
                </div>
            </aside>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        const shareTitle = '🚨 Urgent Blood Request: @group';
        const shareText = 'Urgent blood needed at @(Model.HospitalName ?? "Emergency Center"). Can you donate or help share?';
        const shareUrl = window.location.href;

        function shareEmergencyRequest() {
            if (navigator.share) {
                navigator.share({
                    title: shareTitle,
                    text: shareText,
                    url: shareUrl
                }).catch(err => console.log('Share dismissed', err));
            } else {
                navigator.clipboard.writeText(shareUrl).then(() => {
                    alert('Request link copied to clipboard!');
                });
            }
        }

        document.getElementById('copyLinkBtn')?.addEventListener('click', function () {
            navigator.clipboard.writeText(window.location.href).then(function () {
                document.getElementById('copyLinkBtn').innerHTML = '<i class="fas fa-check" aria-hidden="true"></i> Link copied';
                setTimeout(() => {
                    document.getElementById('copyLinkBtn').innerHTML = '<i class="fas fa-link" aria-hidden="true"></i> Copy link';
                }, 2500);
            });
        });
    </script>
}
