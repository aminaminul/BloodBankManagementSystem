@model BBDMS.Model.Models.Entities.BloodRequest
@{
    ViewData["Title"] = "Track Emergency Request";
    var contact = ViewBag.Contact as string;
}

<section class="page-hero-sm">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item active" aria-current="page">Track Request</li>
            </ol>
        </nav>
        <h1 class="fw-bold mb-1">Track Your Emergency Request</h1>
        <p class="mb-0">Enter your contact number to see the live status of a blood request.</p>
    </div>
</section>

<section class="py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">

                <!-- Lookup form -->
                <div class="card-modern mb-4">
                    <form method="get" asp-action="TrackRequest">
                        <div class="row g-2">
                            <div class="col-md-6">
                                <label class="form-label"><i class="fas fa-key text-primary me-1"></i>Tracking Token</label>
                                <input type="text" name="token" value="@ViewBag.Token" class="form-control form-control-modern" placeholder="e.g. 128-bit secure token" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label"><i class="fas fa-phone text-danger me-1"></i>Or Contact Number</label>
                                <div class="input-group">
                                    <input type="text" name="contact" value="@contact" class="form-control form-control-modern" placeholder="e.g. 01711223344" />
                                    <div class="input-group-append">
                                        <button type="submit" class="btn btn-brand-red"><i class="fas fa-search"></i> Track</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>

                @if (Model == null)
                {
                    <div class="card-modern text-center py-5">
                        <i class="fas fa-stream fa-2x text-muted mb-3 d-block"></i>
                        <h5 class="fw-bold">No request found</h5>
                        <p class="text-muted mb-0">We couldn't find a request for that contact number. Please check and try again.</p>
                    </div>
                }
                else
                {
                    var status = string.IsNullOrEmpty(Model.Status) ? "Pending" : Model.Status;
                    var responded = status == "Accepted" || status == "Fulfilled" || status == "Completed";
                    var accepted = status == "Fulfilled" || status == "Completed";
                    var provided = status == "Fulfilled" || status == "Completed";
                    var baseTime = Model.ApplyDate ?? DateTime.Now;

                    @if (!string.IsNullOrEmpty(Model.TrackingToken))
                    {
                        var shareUrl = Url.Action("TrackRequest", "Emergency", new { token = Model.TrackingToken }, Context.Request.Scheme);
                        var reqGroup = Model.BloodGroup ?? Model.BloodRequireFor;
                        var reqHospital = Model.HospitalName ?? "Emergency Facility";
                        var reqUnits = Model.UnitsRequired > 0 ? Model.UnitsRequired.ToString() : "1";
                        var shareMsg = $"🚨 URGENT: {reqUnits} Unit(s) of {reqGroup} Blood needed at {reqHospital}. Track request and respond here: {shareUrl}";
                        var waUrl = "https://api.whatsapp.com/send?text=" + System.Net.WebUtility.UrlEncode(shareMsg);

                        <div class="card bg-light border shadow-sm rounded-3 mb-4">
                            <div class="card-body p-3">
                                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                                    <div class="small">
                                        <i class="fas fa-link text-primary me-1"></i> <strong>Private Tracking &amp; Share Link:</strong>
                                        <span class="text-muted d-block">Share this secure link with hospital staff, family, or volunteer groups.</span>
                                    </div>
                                    <div class="btn-group">
                                        <button type="button" class="btn btn-outline-primary btn-sm" onclick="navigator.clipboard.writeText('@shareUrl'); alert('Tracking link copied to clipboard!');">
                                            <i class="fas fa-copy me-1"></i> Copy Link
                                        </button>
                                        <a href="@waUrl" target="_blank" rel="noopener noreferrer" class="btn btn-success btn-sm text-white">
                                            <i class="fab fa-whatsapp me-1"></i> WhatsApp
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    var steps = new List<(string Title, string Sub, bool Done, bool Current, string Time)>
                    {
                        ("Request Created", "Your emergency request has been submitted.", true, false, baseTime.ToString("hh:mm tt")),
                        ("Donors Notified", "Nearby donors of the required blood group have been notified.", true, !responded, baseTime.AddMinutes(5).ToString("hh:mm tt")),
                        ("Donor Responded", "A donor has responded to your request.", responded, responded && !accepted, responded ? baseTime.AddMinutes(20).ToString("hh:mm tt") : "Pending"),
                        ("Request Accepted", "The donor has accepted your request.", accepted, accepted && !provided, accepted ? baseTime.AddMinutes(35).ToString("hh:mm tt") : "Pending"),
                        ("Support Provided", "The necessary blood support has been provided.", provided, false, provided ? baseTime.AddHours(1).ToString("hh:mm tt") : "Pending")
                    };

                    <div class="card-modern mb-4">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                            <h5 class="fw-bold mb-0">Request #@Model.ID</h5>
                            <span class="badge-soft-danger">@(Model.BloodGroup ?? Model.BloodRequireFor) Blood</span>
                        </div>
                        <div class="row g-3 small">
                            <div class="col-sm-4"><span class="text-muted d-block">Hospital</span><span class="fw-semibold text-dark">@(Model.HospitalName ?? "Emergency Facility")</span></div>
                            <div class="col-sm-4"><span class="text-muted d-block">Location</span><span class="fw-semibold text-dark">@(Model.Location ?? "—")</span></div>
                            <div class="col-sm-4"><span class="text-muted d-block">Units</span><span class="fw-semibold text-dark">@Model.UnitsRequired</span></div>
                        </div>
                    </div>

                    <div class="card-modern">
                        <h5 class="fw-bold mb-4">Request Status</h5>
                        <ul class="track-timeline">
                            @foreach (var step in steps)
                            {
                                var cls = step.Done ? "done" : step.Current ? "current" : "";
                                <li class="@cls">
                                    <span class="dot"><i class="fas @(step.Done ? "fa-check" : step.Current ? "fa-dot-circle" : "fa-circle")"></i></span>
                                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                                        <div>
                                            <div class="t-title">@step.Title</div>
                                            <div class="t-sub">@step.Sub</div>
                                        </div>
                                        <span class="t-time">@step.Time</span>
                                    </div>
                                </li>
                            }
                        </ul>
                    </div>
                }

            </div>
        </div>
    </div>
</section>
