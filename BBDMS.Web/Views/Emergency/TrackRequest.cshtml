@model BBDMS.Model.Models.Entities.BloodRequest
@{
    ViewData["Title"] = "Track Emergency Request";
    var contact = ViewBag.Contact as string;
}

<section class="page-head">
    <div class="container">
        <nav aria-label="Breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item"><a asp-action="BloodRequests">Blood requests</a></li>
                <li class="breadcrumb-item active" aria-current="page">Track request</li>
            </ol>
        </nav>
        <div class="page-head-row">
            <div>
                <p class="eyebrow">Live status</p>
                <h1>Track your emergency request.</h1>
                <p>Use your tracking token or the contact number you posted with to see live status.</p>
            </div>
            <div class="page-head-actions">
                <a class="btn btn-ghost" asp-action="CreateBloodRequest">
                    <i class="fas fa-plus" aria-hidden="true"></i> New request
                </a>
                <a class="btn btn-blood" asp-action="BloodRequests">
                    <i class="fas fa-list" aria-hidden="true"></i> Request board
                </a>
            </div>
        </div>
    </div>
</section>

<section class="py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">

                <!-- Lookup form -->
                <div class="filter-bar mb-4">
                    <form method="get" asp-action="TrackRequest">
                        <div class="row g-3 align-items-end">
                            <div class="col-md-5">
                                <label for="trackToken">Tracking token</label>
                                <input id="trackToken" type="text" name="token" value="@ViewBag.Token" class="form-control" placeholder="Paste the token from your request" />
                            </div>
                            <div class="col-md-4">
                                <label for="trackContact">Or contact number</label>
                                <input id="trackContact" type="text" name="contact" value="@contact" class="form-control" placeholder="e.g. 01711223344" autocomplete="tel" />
                            </div>
                            <div class="col-md-3">
                                <button type="submit" class="btn btn-blood w-100" style="height:46px">
                                    <i class="fas fa-magnifying-glass" aria-hidden="true"></i> Track request
                                </button>
                            </div>
                        </div>
                    </form>
                </div>

                @if (Model == null)
                {
                    <div class="empty-state is-compact">
                        <i class="fas fa-magnifying-glass" aria-hidden="true"></i>
                        <h4>No request found</h4>
                        <p>We couldn't find a request for that token or contact number. Check the details and try again.</p>
                        <a class="btn btn-ghost" asp-action="BloodRequests">Browse the request board</a>
                    </div>
                }
                else
                {
                    var status = string.IsNullOrEmpty(Model.Status) ? "Pending" : Model.Status;
                    var responded = status == "Accepted" || status == "Fulfilled" || status == "Completed";
                    var accepted = status == "Fulfilled" || status == "Completed";
                    var provided = status == "Fulfilled" || status == "Completed";
                    var baseTime = Model.ApplyDate ?? DateTime.Now;

                    @if (!string.IsNullOrEmpty(Model.TrackingToken))
                    {
                        var shareUrl = Url.Action("TrackRequest", "Emergency", new { token = Model.TrackingToken }, Context.Request.Scheme);
                        var reqGroup = Model.BloodGroup ?? Model.BloodRequireFor;
                        var reqHospital = Model.HospitalName ?? "Emergency Facility";
                        var reqUnits = Model.UnitsRequired > 0 ? Model.UnitsRequired.ToString() : "1";
                        var shareMsg = $"🚨 URGENT: {reqUnits} Unit(s) of {reqGroup} Blood needed at {reqHospital}. Track request and respond here: {shareUrl}";
                        var waUrl = "https://api.whatsapp.com/send?text=" + System.Net.WebUtility.UrlEncode(shareMsg);

                        <div class="share-bar mb-4">
                            <div>
                                <span class="meta-label">Private tracking link</span>
                                <p class="panel-note" style="margin:0">Share this secure link with hospital staff, family, or volunteer groups.</p>
                            </div>
                            <div class="share-bar-actions">
                                <button type="button" class="btn btn-ghost btn-sm" onclick="navigator.clipboard.writeText('@shareUrl'); alert('Tracking link copied to clipboard!');">
                                    <i class="fas fa-copy" aria-hidden="true"></i> Copy link
                                </button>
                                <a href="@waUrl" target="_blank" rel="noopener noreferrer" class="btn btn-sm share-wa">
                                    <i class="fab fa-whatsapp" aria-hidden="true"></i> WhatsApp
                                </a>
                            </div>
                        </div>
                    }

                    var steps = new List<(string Title, string Sub, bool Done, bool Current, string Time)>
                    {
                        ("Request Created", "Your emergency request has been submitted.", true, false, baseTime.ToString("hh:mm tt")),
                        ("Donors Notified", "Nearby donors of the required blood group have been notified.", true, !responded, baseTime.AddMinutes(5).ToString("hh:mm tt")),
                        ("Donor Responded", "A donor has responded to your request.", responded, responded && !accepted, responded ? baseTime.AddMinutes(20).ToString("hh:mm tt") : "Pending"),
                        ("Request Accepted", "The donor has accepted your request.", accepted, accepted && !provided, accepted ? baseTime.AddMinutes(35).ToString("hh:mm tt") : "Pending"),
                        ("Support Provided", "The necessary blood support has been provided.", provided, false, provided ? baseTime.AddHours(1).ToString("hh:mm tt") : "Pending")
                    };

                    <div class="panel mb-4">
                        <div class="panel-head">
                            <h2>Request #@Model.ID</h2>
                            <span class="badge-soft is-alert">@(Model.BloodGroup ?? Model.BloodRequireFor) blood</span>
                        </div>
                        <dl class="detail-list">
                            <div><dt>Hospital</dt><dd>@(Model.HospitalName ?? "Emergency facility")</dd></div>
                            <div><dt>Location</dt><dd>@(Model.Location ?? "—")</dd></div>
                            <div><dt>Units required</dt><dd>@Model.UnitsRequired</dd></div>
                        </dl>
                    </div>

                    <div class="panel">
                        <h2>Request status</h2>
                        <ul class="track-timeline">
                            @foreach (var step in steps)
                            {
                                var cls = step.Done ? "done" : step.Current ? "current" : "";
                                <li class="@cls">
                                    <span class="dot"><i class="fas @(step.Done ? "fa-check" : step.Current ? "fa-dot-circle" : "fa-circle")"></i></span>
                                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                                        <div>
                                            <div class="t-title">@step.Title</div>
                                            <div class="t-sub">@step.Sub</div>
                                        </div>
                                        <span class="t-time">@step.Time</span>
                                    </div>
                                </li>
                            }
                        </ul>
                    </div>
                }

            </div>
        </div>
    </div>
</section>
