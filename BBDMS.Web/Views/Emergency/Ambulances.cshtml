@model IEnumerable<BBDMS.Model.Models.Entities.AmbulanceService>
@{
    ViewData["Title"] = "Need an Ambulance? - Blood Bank";
    var fleet = Model ?? Enumerable.Empty<BBDMS.Model.Models.Entities.AmbulanceService>();
    var available = fleet.Count(a => a.IsAvailable);
}

<section class="page-head">
    <div class="container">
        <nav aria-label="Breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item"><a asp-action="Index">Emergency</a></li>
                <li class="breadcrumb-item active" aria-current="page">Ambulance fleet</li>
            </ol>
        </nav>
        <div class="page-head-row">
            <div>
                <p class="eyebrow">Dispatch network</p>
                <h1>Need an ambulance? Book the nearest one.</h1>
                <p>Compare ICU, neonatal and basic life-support transport near you, or book a dispatch and track it live.</p>
            </div>
            <div class="page-head-actions">
                <a asp-action="TrackAmbulance" class="btn btn-ghost">
                    <i class="fas fa-location-crosshairs" aria-hidden="true"></i> Track a dispatch
                </a>
                <a asp-action="RequestAmbulance" class="btn btn-blood">
                    <i class="fas fa-paper-plane" aria-hidden="true"></i> Book a dispatch
                </a>
            </div>
        </div>
    </div>
</section>

<section class="section-tight">
    <div class="container">

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success" role="status">
                <i class="fas fa-check-circle" aria-hidden="true"></i> @TempData["Success"]
            </div>
        }

        <form method="get" asp-action="Ambulances" class="filter-bar" role="search" data-reveal>
            <div class="filter-bar-grid">
                <div>
                    <label for="ambLocation">City or location</label>
                    <input id="ambLocation" type="text" name="location" value="@ViewBag.Location" class="form-control" placeholder="e.g. Dhaka, Chattogram, Sylhet" autocomplete="address-level2" />
                </div>
                <div>
                    <label for="ambType">Ambulance type</label>
                    <select id="ambType" name="ambulanceType" class="form-select">
                        <option value="All">All types</option>
                        <option value="ICU" selected="@(ViewBag.AmbulanceType == "ICU")">Advanced life support (ICU)</option>
                        <option value="Basic" selected="@(ViewBag.AmbulanceType == "Basic")">Basic life support</option>
                        <option value="AC" selected="@(ViewBag.AmbulanceType == "AC")">AC ambulance</option>
                        <option value="Non-AC" selected="@(ViewBag.AmbulanceType == "Non-AC")">Non-AC ambulance</option>
                        <option value="Neonatal" selected="@(ViewBag.AmbulanceType == "Neonatal")">Neonatal support</option>
                    </select>
                </div>
                <div class="filter-actions">
                    <button type="submit" class="btn btn-ink"><i class="fas fa-magnifying-glass" aria-hidden="true"></i> Search fleet</button>
                    <a class="btn btn-ghost" asp-action="Ambulances">Reset</a>
                </div>
            </div>
        </form>

        <p class="result-count mt-4">
            <span class="num">@fleet.Count()</span> vehicle@(fleet.Count() == 1 ? "" : "s") listed ·
            <span class="num">@available</span> available now
        </p>

        @if (fleet.Any())
        {
            <div class="provider-grid mt-4">
                @foreach (var amb in fleet)
                {
                    <article class="provider-card" data-reveal>
                        <header class="provider-head">
                            <span class="provider-ico"><i class="fas fa-truck-medical" aria-hidden="true"></i></span>
                            <div>
                                <h3>@amb.ProviderName</h3>
                                <p class="meta"><i class="fas fa-location-dot" aria-hidden="true"></i>@amb.Location</p>
                            </div>
                        </header>

                        <div class="provider-tags">
                            <span>@amb.AmbulanceType</span>
                            <span class="@(amb.IsAvailable ? "is-ok" : "")">
                                <i class="fas @(amb.IsAvailable ? "fa-circle-check" : "fa-circle-clock")" aria-hidden="true"></i>
                                @(amb.IsAvailable ? "Available" : "On mission")
                            </span>
                        </div>

                        <dl class="provider-facts">
                            <div><dt>Registration</dt><dd>@amb.VehicleNumber</dd></div>
                            <div><dt>Service hours</dt><dd>@amb.ServiceHours</dd></div>
                        </dl>

                        <footer>
                            <div>
                                <span class="meta-label">Helpline</span>
                                <a class="phone" href="tel:@amb.ContactNumber">@amb.ContactNumber</a>
                            </div>
                            <div class="provider-actions">
                                <a asp-action="AmbulanceContact" asp-route-location="@amb.Location" class="btn btn-ghost btn-sm" title="Emergency contacts for this area">
                                    <i class="fas fa-address-book" aria-hidden="true"></i><span class="sr-only">Area contacts</span>
                                </a>
                                <a href="tel:@amb.ContactNumber" class="btn btn-blood btn-sm">
                                    <i class="fas fa-phone" aria-hidden="true"></i> Call
                                </a>
                            </div>
                        </footer>
                    </article>
                }
            </div>
        }
        else
        {
            <div class="empty-state mt-4">
                <i class="fas fa-truck-medical" aria-hidden="true"></i>
                <h4>No ambulances match that search</h4>
                <p>Clear the filters, or call the central emergency helpline for immediate dispatch.</p>
                <a asp-action="Ambulances" class="btn btn-ink">Clear filters</a>
            </div>
        }
    </div>
</section>
