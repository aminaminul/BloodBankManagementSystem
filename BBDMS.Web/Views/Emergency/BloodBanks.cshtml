@model IEnumerable<BBDMS.Model.Models.Entities.BloodBank>
@{
    ViewData["Title"] = "Blood Banks Near You - Blood Bank";
    var bloodGroups = ViewBag.BloodGroups as IEnumerable<BBDMS.Model.Models.Entities.BloodGroup>;
    var banks = Model ?? Enumerable.Empty<BBDMS.Model.Models.Entities.BloodBank>();
}

<section class="page-head">
    <div class="container">
        <nav aria-label="Breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item"><a asp-action="Index">Emergency</a></li>
                <li class="breadcrumb-item active" aria-current="page">Blood banks</li>
            </ol>
        </nav>
        <div class="page-head-row">
            <div>
                <p class="eyebrow">Blood bank directory</p>
                <h1>Find a licensed blood bank near you.</h1>
                <p>Check live blood-group inventory at licensed banks, then call the counter directly before you travel.</p>
            </div>
            <div class="page-head-actions">
                <a class="btn btn-ghost" asp-controller="Home" asp-action="Compatibility">
                    <i class="fas fa-droplet" aria-hidden="true"></i> Compatibility guide
                </a>
                <a class="btn btn-blood" asp-action="CreateBloodRequest">
                    <i class="fas fa-plus" aria-hidden="true"></i> Post a request
                </a>
            </div>
        </div>
    </div>
</section>

<section class="section-tight">
    <div class="container">

        <form method="get" asp-action="BloodBanks" class="filter-bar" role="search" data-reveal>
            <div class="filter-bar-grid">
                <div>
                    <label for="bankLocation">City or location</label>
                    <input id="bankLocation" type="text" name="location" value="@ViewBag.Location" class="form-control" placeholder="e.g. Dhaka, Chattogram, Sylhet" autocomplete="address-level2" />
                </div>
                <div>
                    <label for="bankGroup">Blood group</label>
                    <select id="bankGroup" name="bloodGroup" class="form-select">
                        <option value="">All blood groups</option>
                        @if (bloodGroups != null)
                        {
                            foreach (var bg in bloodGroups)
                            {
                                <option value="@bg.GroupName" selected="@(ViewBag.BloodGroup == bg.GroupName)">@bg.GroupName</option>
                            }
                        }
                    </select>
                </div>
                <div class="filter-actions">
                    <button type="submit" class="btn btn-ink"><i class="fas fa-magnifying-glass" aria-hidden="true"></i> Search banks</button>
                    <a class="btn btn-ghost" asp-action="BloodBanks">Reset</a>
                </div>
            </div>
        </form>

        @if (banks.Any())
        {
            <div class="provider-grid mt-5">
                @foreach (var bank in banks)
                {
                    <article class="provider-card" data-reveal>
                        <header class="provider-head">
                            <span class="provider-ico"><i class="fas fa-building-columns" aria-hidden="true"></i></span>
                            <div>
                                <h3>@bank.Name</h3>
                                <p class="meta"><i class="fas fa-location-dot" aria-hidden="true"></i>@bank.Address, @bank.City</p>
                            </div>
                        </header>

                        @if (!string.IsNullOrEmpty(bank.HospitalAffiliation))
                        {
                            <dl class="provider-facts">
                                <div><dt>Affiliated hospital</dt><dd>@bank.HospitalAffiliation</dd></div>
                            </dl>
                        }

                        <div class="provider-tags">
                            @if (!string.IsNullOrEmpty(bank.AvailableBloodGroups))
                            {
                                var groups = bank.AvailableBloodGroups.Split(new[] { ',', ' ', ';' }, StringSplitOptions.RemoveEmptyEntries);
                                foreach (var g in groups)
                                {
                                    <span class="is-blood">@g</span>
                                }
                            }
                            else
                            {
                                <span>Call for inventory</span>
                            }
                        </div>

                        <footer>
                            <div>
                                <span class="meta-label">@(string.IsNullOrEmpty(bank.OperatingHours) ? "Open hours" : bank.OperatingHours)</span>
                                <a class="phone" href="tel:@bank.ContactNumber">@bank.ContactNumber</a>
                            </div>
                            <a href="tel:@bank.ContactNumber" class="btn btn-blood btn-sm">
                                <i class="fas fa-phone" aria-hidden="true"></i> Call bank
                            </a>
                        </footer>
                    </article>
                }
            </div>
        }
        else
        {
            <div class="empty-state mt-5">
                <i class="fas fa-building-columns" aria-hidden="true"></i>
                <h4>No blood banks match that search</h4>
                <p>Try another city, or clear the blood group filter to see the full network.</p>
                <a asp-action="BloodBanks" class="btn btn-ink">Clear filters</a>
            </div>
        }
    </div>
</section>
