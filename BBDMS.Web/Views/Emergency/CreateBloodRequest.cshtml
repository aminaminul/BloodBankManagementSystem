@model BBDMS.Model.Models.Entities.BloodRequest
@{
    ViewData["Title"] = "Submit Emergency Blood Request - Blood Bank";
    var bloodGroups = ViewBag.BloodGroups as IEnumerable<BBDMS.Model.Models.Entities.BloodGroup>;
    var donor = ViewBag.Donor as BBDMS.Model.Models.Entities.BloodDonor;
}

<div class="container my-5">
    <div class="card card-modern border-0 shadow-lg" style="border-radius: 20px; overflow: hidden;">
        <div class="row no-gutters">
            <!-- Left Form Column -->
            <div class="col-lg-7 p-4 p-md-5">
                <div class="mb-4">
                    <span class="badge badge-soft-danger mb-2 font-weight-bold">
                        <i class="fas fa-heartbeat mr-1"></i> Rapid Emergency Dispatch
                    </span>
                    <h3 class="font-weight-bold text-dark mb-1">Submit Emergency Request</h3>
                    <p class="text-muted small">Broadcast your blood need to available voluntary donors and local blood banks instantly.</p>
                </div>

                @if (donor != null)
                {
                    <div class="alert alert-danger py-2 small" role="alert">
                        <i class="fas fa-user-check mr-1"></i> Direct request targeting donor <strong>@donor.FullName</strong> (@donor.BloodGroup).
                    </div>
                }

                <form method="post" asp-action="CreateBloodRequest">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="BloodDonorID" />

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="font-weight-bold small text-dark">Required Blood Group <span class="text-danger">*</span></label>
                            <select asp-for="BloodGroup" class="form-control form-control-modern" required>
                                <option value="">Select Blood Group</option>
                                @if (bloodGroups != null)
                                {
                                    foreach (var bg in bloodGroups)
                                    {
                                        <option value="@bg.GroupName" selected="@(donor != null && donor.BloodGroup == bg.GroupName)">@bg.GroupName</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="BloodGroup" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="font-weight-bold small text-dark">Units Needed (Bags) <span class="text-danger">*</span></label>
                            <input asp-for="UnitsRequired" type="number" min="1" max="20" class="form-control form-control-modern" required placeholder="e.g. 2" />
                            <span asp-validation-for="UnitsRequired" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="font-weight-bold small text-dark">Hospital Name & Ward <span class="text-danger">*</span></label>
                            <input asp-for="HospitalName" class="form-control form-control-modern" placeholder="e.g. Dhaka Medical College Hospital" required />
                            <span asp-validation-for="HospitalName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="font-weight-bold small text-dark">City / Location <span class="text-danger">*</span></label>
                            <input asp-for="Location" class="form-control form-control-modern" placeholder="e.g. Dhaka, Dhanmondi" required />
                            <span asp-validation-for="Location" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="font-weight-bold small text-dark">Reason / Requirement <span class="text-danger">*</span></label>
                            <input asp-for="BloodRequireFor" class="form-control form-control-modern" placeholder="e.g. Emergency Accident Surgery, Delivery" required />
                            <span asp-validation-for="BloodRequireFor" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="font-weight-bold small text-dark">Emergency Status <span class="text-danger">*</span></label>
                            <select asp-for="Urgency" class="form-control form-control-modern" required>
                                <option value="Critical (Within 2-4 Hours)">Critical (Immediate / Within 2-4 Hours)</option>
                                <option value="Urgent (Within 12-24 Hours)">Urgent (Within 12-24 Hours)</option>
                                <option value="Standard (Within 2-3 Days)">Standard (Within 2-3 Days)</option>
                            </select>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="font-weight-bold small text-dark">Contact Person Name <span class="text-danger">*</span></label>
                            <input asp-for="Name" class="form-control form-control-modern" placeholder="Contact Person" required />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="font-weight-bold small text-dark">Contact Phone Number <span class="text-danger">*</span></label>
                            <input asp-for="ContactNumber" type="number" class="form-control form-control-modern" placeholder="017XXXXXXXX" required />
                            <span asp-validation-for="ContactNumber" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="form-group mb-4">
                        <label class="font-weight-bold small text-dark">Additional Instructions</label>
                        <textarea asp-for="Message" class="form-control form-control-modern" rows="2" style="height: auto;" placeholder="Provide any details like cross-matching details, patient ward number..."></textarea>
                    </div>

                    <button type="submit" class="btn btn-brand-red btn-block py-2 font-weight-bold shadow">
                        <i class="fas fa-paper-plane mr-2"></i> Submit Emergency Request
                    </button>
                </form>
            </div>

            <!-- Right Visual Column -->
            <div class="col-lg-5 d-none d-lg-flex" style="background: linear-gradient(145deg, #0f172a, #1e293b); color: white; flex-direction: column; justify-content: space-between; padding: 3.5rem;">
                <div>
                    <span class="badge badge-danger p-2 mb-3 font-weight-bold">
                        <i class="fas fa-ambulance mr-1"></i> Emergency Response
                    </span>
                    <h3 class="font-weight-bold text-white mb-3">Emergency Help Now.</h3>
                    <p class="text-white-50">
                        When every second counts, our system broadcasts your urgent blood request to local registered donors and alerts emergency hospital coordinators in real-time.
                    </p>
                    <div class="my-4">
                        <img src="~/images/banner1.jpg" alt="Ambulance" class="img-fluid rounded shadow" style="border: 2px solid rgba(255,255,255,0.15);" />
                    </div>
                </div>

                <div class="pt-3 border-top" style="border-color: rgba(255,255,255,0.1) !important;">
                    <small class="text-white-50 d-block">Direct Hotline</small>
                    <h5 class="font-weight-bold text-white mb-0"><i class="fas fa-phone-volume text-danger mr-2"></i>Call 999 or 01700000000</h5>
                </div>
            </div>
        </div>
    </div>
</div>
