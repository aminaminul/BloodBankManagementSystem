@model BBDMS.Model.Models.Entities.BloodRequest
@{
    ViewData["Title"] = "Submit Emergency Blood Request - Blood Bank";
    var bloodGroups = ViewBag.BloodGroups as IEnumerable<BBDMS.Model.Models.Entities.BloodGroup>;
    var donor = ViewBag.Donor as BBDMS.Model.Models.Entities.BloodDonor;
}

<section class="page-head">
    <div class="container">
        <nav aria-label="Breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item"><a asp-action="Index">Emergency</a></li>
                <li class="breadcrumb-item active" aria-current="page">Request blood</li>
            </ol>
        </nav>
        <div class="page-head-row">
            <div>
                <p class="eyebrow">Rapid emergency dispatch</p>
                <h1>Request blood for a patient.</h1>
                <p>One form alerts matching voluntary donors and blood bank counters in the area. Post it only when you need blood — donors respond fast.</p>
            </div>
            <div class="page-head-actions">
                <a class="btn btn-ghost" asp-action="BloodRequests">
                    <i class="fas fa-list" aria-hidden="true"></i> Request board
                </a>
            </div>
        </div>
    </div>
</section>

<section class="section-tight">
    <div class="container">
        <div class="form-layout">
            <div class="form-main">
                <form method="post" asp-action="CreateBloodRequest" class="panel">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="BloodDonorID" />

                    @if (donor != null)
                    {
                        <div class="alert alert-info" role="status">
                            <i class="fas fa-user-check" aria-hidden="true"></i>
                            Direct request targeting donor <strong>@donor.FullName</strong> (@donor.BloodGroup).
                        </div>
                    }

                    <div class="form-section is-first">
                        <h3 class="form-section-title">What is needed</h3>
                        <div class="field-grid">
                            <div>
                                <label asp-for="BloodGroup">Required blood group <span class="req">*</span></label>
                                <select asp-for="BloodGroup" class="form-select" required>
                                    <option value="">Select blood group</option>
                                    @if (bloodGroups != null)
                                    {
                                        foreach (var bg in bloodGroups)
                                        {
                                            <option value="@bg.GroupName" selected="@(donor != null && donor.BloodGroup == bg.GroupName)">@bg.GroupName</option>
                                        }
                                    }
                                </select>
                                <span asp-validation-for="BloodGroup" class="field-validation-error"></span>
                            </div>
                            <div>
                                <label asp-for="UnitsRequired">Units needed (bags) <span class="req">*</span></label>
                                <input asp-for="UnitsRequired" type="number" min="1" max="20" class="form-control" required placeholder="e.g. 2" />
                                <span asp-validation-for="UnitsRequired" class="field-validation-error"></span>
                            </div>
                            <div>
                                <label asp-for="BloodRequireFor">Reason <span class="req">*</span></label>
                                <input asp-for="BloodRequireFor" class="form-control" placeholder="e.g. emergency surgery, delivery" required />
                                <span asp-validation-for="BloodRequireFor" class="field-validation-error"></span>
                            </div>
                            <div>
                                <label asp-for="Urgency">Emergency status <span class="req">*</span></label>
                                <select asp-for="Urgency" class="form-select" required>
                                    <option value="Critical (Within 2-4 Hours)">Critical — within 2–4 hours</option>
                                    <option value="Urgent (Within 12-24 Hours)">Urgent — within 12–24 hours</option>
                                    <option value="Standard (Within 2-3 Days)">Standard — within 2–3 days</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="form-section">
                        <h3 class="form-section-title">Where the patient is</h3>
                        <div class="field-grid">
                            <div>
                                <label asp-for="HospitalName">Hospital &amp; ward <span class="req">*</span></label>
                                <input asp-for="HospitalName" class="form-control" placeholder="e.g. Dhaka Medical College" required />
                                <span asp-validation-for="HospitalName" class="field-validation-error"></span>
                            </div>
                            <div>
                                <label asp-for="Location">City / area <span class="req">*</span></label>
                                <input asp-for="Location" class="form-control" placeholder="e.g. Dhaka, Dhanmondi" required />
                                <span asp-validation-for="Location" class="field-validation-error"></span>
                            </div>
                        </div>
                    </div>

                    <div class="form-section">
                        <h3 class="form-section-title">Who donors should call</h3>
                        <div class="field-grid">
                            <div>
                                <label asp-for="Name">Contact person <span class="req">*</span></label>
                                <input asp-for="Name" class="form-control" placeholder="Full name" required autocomplete="name" />
                                <span asp-validation-for="Name" class="field-validation-error"></span>
                            </div>
                            <div>
                                <label asp-for="ContactNumber">Phone number <span class="req">*</span></label>
                                <input asp-for="ContactNumber" type="tel" class="form-control" placeholder="017XXXXXXXX" required autocomplete="tel" />
                                <span asp-validation-for="ContactNumber" class="field-validation-error"></span>
                            </div>
                        </div>
                    </div>

                    <div class="form-section">
                        <h3 class="form-section-title">Notes for donors <span class="optional">optional</span></h3>
                        <label asp-for="Message" class="sr-only">Additional instructions</label>
                        <textarea asp-for="Message" class="form-control" rows="3" placeholder="Cross-matching details, ward number, best time to visit…"></textarea>
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn btn-blood">
                            <i class="fas fa-paper-plane" aria-hidden="true"></i> Publish request
                        </button>
                        <p class="form-note">Published requests are visible to signed-in donors and the emergency coordinator team.</p>
                    </div>
                </form>
            </div>

            <aside class="form-aside">
                <div class="panel panel-ink">
                    <p class="eyebrow" style="color:rgba(255,246,238,.55)">Emergency line</p>
                    <h2 class="hotline">
                        <i class="fas fa-phone-volume" aria-hidden="true"></i>
                        <a href="tel:999">999</a>
                    </h2>
                    <p class="panel-note">For an active emergency, call 999 first. Publish here as well so donors near the hospital see it.</p>

                    <div style="margin-top: var(--s5);">
                        <span class="meta-label">After you publish</span>
                        <ol class="rail-list">
                            <li><strong>Nearby donors are alerted</strong> by blood group and city.</li>
                            <li><strong>You get a tracking link</strong> to follow responses and share with family.</li>
                            <li><strong>Call the responder directly</strong> — contact numbers appear on your tracking page.</li>
                        </ol>
                    </div>
                </div>

                <div class="panel panel-quiet">
                    <span class="meta-label">Already posted?</span>
                    <p class="panel-note" style="margin-bottom:14px">Track responses with your token or contact number.</p>
                    <a asp-action="TrackRequest" class="link-arrow">Track a request <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
                </div>
            </aside>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
