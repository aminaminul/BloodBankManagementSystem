@{
    var adminName = (User.Identity?.Name ?? "Administrator");
    var initial = string.IsNullOrEmpty(adminName) ? "A" : adminName.Substring(0, 1).ToUpper();
}
<!DOCTYPE html>
<html lang="en" data-theme="@ThemePreference.Read(Context)">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Admin</title>

    @* Applies the stored light/dark choice (and motion opt-in) before the first paint. *@
    <script>
        (function () {
            try {
                var m = document.cookie.match(/(?:^|;\s*)bbdms\.theme=([^;]+)/);
                var t = m ? decodeURIComponent(m[1]) : localStorage.getItem('bbdms-theme');
                if (!t && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) t = 'dark';
                t = t === 'dark' ? 'dark' : 'light';
                document.documentElement.setAttribute('data-theme', t);
                document.documentElement.style.colorScheme = t;
                if (!(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches)) {
                    document.documentElement.classList.add('bbdms-motion');
                }
            } catch (e) { /* keep the server rendered theme */ }
        })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400..700;1,400..700&family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/bootstrap.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="~/css/bbdms.css" asp-append-version="true" />
    <style>
        .admin-navbar { height: 64px; display: flex; align-items: center; gap: 16px; padding: 0 20px; z-index: 1030; }
        .admin-navbar .brand-word { font-size: 1rem; }
        .admin-navbar .admin-tag {
            font-family: var(--font-mono); font-size: .58rem; letter-spacing: .14em; text-transform: uppercase;
            border: 1px solid var(--line-2); color: var(--muted); padding: 2px 6px; border-radius: var(--r-xs);
        }
        .admin-shell { display: flex; min-height: calc(100vh - 64px); }
        .admin-sidebar { width: 248px; flex-shrink: 0; position: sticky; top: 64px; align-self: flex-start; height: calc(100vh - 64px); overflow-y: auto; }
        .admin-main { flex: 1 1 auto; min-width: 0; padding: clamp(20px, 2.6vw, 36px) clamp(16px, 2.6vw, 36px) 64px; }
        .live-toast-container { position: fixed; top: 76px; right: 24px; z-index: 9999; max-width: 400px; }
        @@media (max-width: 991.98px) {
            .admin-sidebar { position: fixed; left: 0; top: 0; z-index: 1050; transform: translateX(-102%); transition: transform .22s var(--ease-out); height: 100vh; box-shadow: var(--shadow-pop); }
            .admin-sidebar.open { transform: none; }
            .admin-main { padding: 18px 16px 48px; }
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="page-admin">
    <nav class="navbar fixed-top admin-navbar admin-navbar-border" style="border-bottom:1px solid var(--line);background:var(--surface)">
        <a class="brand" asp-controller="Admin" asp-action="Dashboard" aria-label="Admin dashboard">
            <img class="brand-mark" src="~/images/Logo.png" alt="" width="30" height="30" />
            <span class="brand-word">BloodBank<em>.</em></span>
            <span class="admin-tag">Admin</span>
        </a>

        <div class="d-flex align-items-center gap-2 ms-auto">
            @await Html.PartialAsync("_ThemeToggle")
            @await Html.PartialAsync("_NotificationBell")
            <a class="btn btn-ghost btn-sm d-none d-md-inline-flex" href="/" target="_blank" rel="noopener">
                <i class="fas fa-arrow-up-right-from-square" aria-hidden="true"></i> View site
            </a>
            <div class="avatar-circle d-none d-sm-inline-flex">@initial</div>
            <form asp-controller="Admin" asp-action="Logout" method="post" class="m-0">
                <button type="submit" class="btn btn-ghost btn-sm" aria-label="Sign out">
                    <i class="fas fa-arrow-right-from-bracket" aria-hidden="true"></i>
                    <span class="d-none d-lg-inline">Sign out</span>
                </button>
            </form>
        </div>
    </nav>

    <div id="liveAlertContainer" class="live-toast-container"></div>

    <div class="admin-shell" style="padding-top:64px">
        <aside class="admin-sidebar" id="adminSidebar">
            <div class="admin-sidebar-heading">Overview</div>
            <nav aria-label="Admin overview">
                <a asp-controller="Admin" asp-action="Dashboard"><i class="fas fa-gauge-high" aria-hidden="true"></i>Dashboard</a>
                <a asp-controller="Admin" asp-action="Reports"><i class="fas fa-chart-line" aria-hidden="true"></i>Reports &amp; analytics</a>
            </nav>

            <div class="admin-sidebar-heading">Management</div>
            <nav aria-label="Management">
                <a asp-controller="Admin" asp-action="DonorList"><i class="fas fa-users" aria-hidden="true"></i>Blood donors</a>
                <a asp-controller="Admin" asp-action="BloodRequests"><i class="fas fa-droplet" aria-hidden="true"></i>Blood requests</a>
                <a asp-controller="Admin" asp-action="Hospitals"><i class="fas fa-hospital" aria-hidden="true"></i>Hospitals &amp; ICU</a>
                <a asp-controller="Admin" asp-action="BloodBanks"><i class="fas fa-building" aria-hidden="true"></i>Blood banks</a>
                <a asp-controller="Admin" asp-action="Ambulances"><i class="fas fa-ambulance" aria-hidden="true"></i>Ambulance fleets</a>
                <a asp-controller="Admin" asp-action="AmbulanceRequests"><i class="fas fa-bell" aria-hidden="true"></i>Ambulance bookings</a>
                <a asp-controller="Admin" asp-action="Oxygen"><i class="fas fa-lungs" aria-hidden="true"></i>Oxygen providers</a>
            </nav>

            <div class="admin-sidebar-heading">Website</div>
            <nav aria-label="Website">
                <a asp-controller="Admin" asp-action="ContactQueries"><i class="fas fa-envelope-open-text" aria-hidden="true"></i>User messages</a>
                <a asp-controller="Admin" asp-action="ContactInfo"><i class="fas fa-address-card" aria-hidden="true"></i>Contact details</a>
                <a asp-controller="Admin" asp-action="Pages"><i class="fas fa-file-lines" aria-hidden="true"></i>Manage pages</a>
                <a asp-controller="Admin" asp-action="Settings"><i class="fas fa-gear" aria-hidden="true"></i>Settings</a>
                <a asp-controller="Admin" asp-action="AuditTrail"><i class="fas fa-clipboard-list" aria-hidden="true"></i>Audit trail</a>
            </nav>
        </aside>

        <main class="admin-main" id="main">
            <div class="d-flex d-lg-none mb-3">
                <button class="icon-btn" type="button" data-admin-toggle aria-controls="adminSidebar" aria-expanded="false" aria-label="Open menu">
                    <i class="fas fa-bars" aria-hidden="true"></i>
                </button>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="status">
                    <i class="fas fa-circle-check" aria-hidden="true"></i>@TempData["Success"]
                    <button type="button" class="close" data-dismiss="alert" aria-label="Dismiss">&times;</button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="fas fa-triangle-exclamation" aria-hidden="true"></i>@TempData["Error"]
                    <button type="button" class="close" data-dismiss="alert" aria-label="Dismiss">&times;</button>
                </div>
            }

            @await Html.PartialAsync("_ValidationSummary")

            @RenderBody()
        </main>
    </div>

    <script src="~/js/jquery-2.2.3.min.js" asp-append-version="true"></script>
    <script src="~/js/bootstrap.js" asp-append-version="true"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script>
        const connection = new signalR.HubConnectionBuilder().withUrl("/emergencyHub").withAutomaticReconnect().build();

        function escapeHtml(value) {
            return String(value == null ? "" : value)
                .replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;").replace(/'/g, "&#039;");
        }

        connection.on("ReceiveAmbulanceAlert", function (data) {
            showAlertToast("EMERGENCY AMBULANCE BOOKING",
                `Patient: <strong>${escapeHtml(data.patientName)}</strong><br/>Pickup: ${escapeHtml(data.pickupLocation)}<br/>Contact: <strong>${escapeHtml(data.contactNumber)}</strong>` +
                (data.trackingToken ? `<br/><a href="/Emergency/TrackAmbulance?token=${encodeURIComponent(data.trackingToken)}" target="_blank" rel="noopener" class="btn btn-sm btn-outline-danger mt-2">Open live timeline</a>` : ""), "danger");
        });
        // Dispatcher-only events: these carry patient identity, so they reach signed-in admin sessions only.
        connection.on("ReceiveBloodRequestAlertFull", function (data) {
            showAlertToast("CRITICAL BLOOD REQUEST",
                `Patient: <strong>${escapeHtml(data.patientName)}</strong> needs <strong>${escapeHtml(data.bloodGroup)}</strong> (${escapeHtml(data.units)} units)<br/>Hospital: ${escapeHtml(data.hospital)}<br/>Contact: <strong>${escapeHtml(data.contactNumber)}</strong>`, "warning");
        });

        function showAlertToast(title, bodyHtml, alertClass) {
            const container = document.getElementById("liveAlertContainer");
            if (!container) return;
            const alertDiv = document.createElement("div");
            alertDiv.className = `alert alert-${alertClass} alert-dismissible fade show mb-2 shadow`;
            alertDiv.setAttribute("role", "alert");
            alertDiv.innerHTML = `
                <div class="d-flex justify-content-between align-items-start mb-1">
                    <strong style="font-size:.8rem;letter-spacing:.04em">${title}</strong>
                    <button type="button" class="close" data-dismiss="alert" aria-label="Dismiss">&times;</button>
                </div>
                <div class="small">${bodyHtml}</div>`;
            container.appendChild(alertDiv);
            setTimeout(function () { if (alertDiv.parentNode) alertDiv.remove(); }, 12000);
        }

        connection.start().catch(function (err) { console.log("SignalR Connection Error: ", err); });

        document.addEventListener("DOMContentLoaded", function () {
            var currentPath = window.location.pathname.toLowerCase();
            document.querySelectorAll(".admin-sidebar a").forEach(function (link) {
                var href = link.getAttribute("href");
                if (href && href !== "/" && currentPath.indexOf(href.toLowerCase()) === 0) { link.classList.add("active"); }
            });

            var sidebar = document.getElementById("adminSidebar");
            var toggle = document.querySelector("[data-admin-toggle]");
            if (sidebar && toggle) {
                toggle.addEventListener("click", function () {
                    var open = sidebar.classList.toggle("open");
                    toggle.setAttribute("aria-expanded", open ? "true" : "false");
                });
                document.addEventListener("click", function (event) {
                    if (window.innerWidth >= 992) return;
                    if (sidebar.classList.contains("open") && !sidebar.contains(event.target) && !toggle.contains(event.target)) {
                        sidebar.classList.remove("open");
                        toggle.setAttribute("aria-expanded", "false");
                    }
                });
            }
        });
    </script>
    <script src="~/js/bbdms-theme.js" asp-append-version="true"></script>
    <script src="~/js/bbdms-motion.js" asp-append-version="true"></script>
    <script src="~/js/bbdms-notifications.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
