<div class="dropdown notification-dropdown d-inline-block">
    <button class="icon-btn is-bare position-relative" type="button" id="notificationBellBtn"
            data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" aria-label="Notifications">
        <i class="fas fa-bell" aria-hidden="true"></i>
        <span class="badge badge-danger position-absolute" id="notificationBadge"
              style="top: 3px; right: 3px; font-size: .6rem; padding: 2px 4px; border-radius: 3px; display: none;">0</span>
    </button>
    <div class="dropdown-menu dropdown-menu-right" aria-labelledby="notificationBellBtn"
         style="width: 330px; max-width: 88vw; padding: 0; overflow: hidden;">
        <div class="d-flex justify-content-between align-items-center px-3 py-2"
             style="border-bottom:1px solid var(--line); background:var(--surface-2)">
            <span class="meta" style="font-size:.62rem">Notifications</span>
            <button type="button" class="btn-quiet btn-sm btn" onclick="markAllNotificationsRead()">Mark all read</button>
        </div>
        <div id="notificationList" style="max-height: 340px; overflow-y: auto;">
            <div class="text-center py-4 text-muted small" id="notificationEmptyState">
                <i class="far fa-bell-slash fa-lg mb-2 d-block" aria-hidden="true" style="opacity:.5"></i>
                No notifications yet
            </div>
        </div>
    </div>
</div>
