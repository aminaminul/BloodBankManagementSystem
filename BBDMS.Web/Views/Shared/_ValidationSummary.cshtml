@using System.Linq
@*
    Renders the model-state errors of the current request.
    Most forms in this app post back to the same view on failure; without this banner the
    user saw the form re-render with no explanation at all.
*@
@{
    // Only form submissions carry meaningful model-state errors. Plain GET requests get implicit
    // "field is required" entries for non-nullable string parameters (e.g. ?location=), which must
    // never be shown to the user as a failed save.
    var isFormSubmission = HttpMethods.IsPost(Context.Request.Method)
        || HttpMethods.IsPut(Context.Request.Method)
        || HttpMethods.IsPatch(Context.Request.Method)
        || HttpMethods.IsDelete(Context.Request.Method);
}
@if (isFormSubmission && !ViewData.ModelState.IsValid)
{
    var errors = ViewData.ModelState.Values
        .SelectMany(entry => entry.Errors)
        .Select(error => string.IsNullOrWhiteSpace(error.ErrorMessage)
            ? "Please check the submitted values and try again."
            : error.ErrorMessage)
        .Distinct()
        .ToList();

    if (errors.Count > 0)
    {
        <div class="container mb-3">
            <div class="alert alert-danger border-0 shadow-sm" role="alert">
                <div class="d-flex align-items-center mb-1">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    <strong>Your submission could not be saved</strong>
                </div>
                <ul class="mb-0 small ps-3">
                    @foreach (var error in errors)
                    {
                        <li>@error</li>
                    }
                </ul>
            </div>
        </div>
    }
}
