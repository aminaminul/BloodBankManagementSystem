@{
    var donorName = (User.Identity?.Name ?? "Donor");
    var initial = string.IsNullOrEmpty(donorName) ? "D" : donorName.Substring(0, 1).ToUpper();
}
<!DOCTYPE html>
<html lang="en" data-theme="@ThemePreference.Read(Context)">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — BloodBank</title>

    @* Applies the stored light/dark choice (and motion opt-in) before the first paint. *@
    <script>
        (function () {
            try {
                var m = document.cookie.match(/(?:^|;\s*)bbdms\.theme=([^;]+)/);
                var t = m ? decodeURIComponent(m[1]) : localStorage.getItem('bbdms-theme');
                if (!t && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) t = 'dark';
                t = t === 'dark' ? 'dark' : 'light';
                document.documentElement.setAttribute('data-theme', t);
                document.documentElement.style.colorScheme = t;
                if (!(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches)) {
                    document.documentElement.classList.add('bbdms-motion');
                }
            } catch (e) { /* keep the server rendered theme */ }
        })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400..700;1,400..700&family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/bootstrap.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="~/css/bbdms.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="page-donor">
    <a class="skip-link" href="#main">Skip to content</a>

    <div class="dash-shell">
        <aside class="dash-sidebar" id="dashSidebar">
            <a class="dash-brand" asp-controller="Home" asp-action="Index">
                <img src="~/images/Logo.png" alt="" />
                <span>Blood<b>Bank</b></span>
            </a>

            <div class="dash-heading">Donor area</div>
            <nav class="dash-nav" aria-label="Donor navigation">
                <a asp-controller="Donor" asp-action="Dashboard"><i class="fas fa-gauge-high" aria-hidden="true"></i>Dashboard</a>
                <a asp-controller="Account" asp-action="Profile"><i class="fas fa-user" aria-hidden="true"></i>My profile</a>
                <a asp-controller="Donor" asp-action="DonorCard"><i class="fas fa-id-card" aria-hidden="true"></i>Digital donor card</a>
                <a asp-controller="Donor" asp-action="Certificate"><i class="fas fa-award" aria-hidden="true"></i>My certificate</a>
                <a asp-controller="Donor" asp-action="DonationHistory"><i class="fas fa-clock-rotate-left" aria-hidden="true"></i>Donation history</a>
                <a asp-controller="Donor" asp-action="MyRequests"><i class="fas fa-heart-pulse" aria-hidden="true"></i>Blood requests</a>
                <a asp-controller="Donor" asp-action="Nearby"><i class="fas fa-map-location-dot" aria-hidden="true"></i>Nearby donors</a>
            </nav>

            <div class="dash-heading">Emergency</div>
            <nav class="dash-nav" aria-label="Emergency actions">
                <a asp-controller="Emergency" asp-action="CreateBloodRequest"><i class="fas fa-plus" aria-hidden="true"></i>Request blood</a>
                <a asp-controller="Emergency" asp-action="RequestAmbulance"><i class="fas fa-ambulance" aria-hidden="true"></i>Request ambulance</a>
                <a asp-controller="Emergency" asp-action="TrackAmbulance"><i class="fas fa-satellite-dish" aria-hidden="true"></i>Track dispatch</a>
                <a asp-controller="Emergency" asp-action="AmbulanceContact"><i class="fas fa-phone-volume" aria-hidden="true"></i>Emergency contacts</a>
            </nav>

            <div class="dash-heading">Account</div>
            <nav class="dash-nav" aria-label="Account">
                <a asp-controller="Account" asp-action="ChangePassword"><i class="fas fa-key" aria-hidden="true"></i>Security</a>
                <a asp-controller="Account" asp-action="RequestReceived"><i class="fas fa-inbox" aria-hidden="true"></i>Inbox</a>
                <a asp-controller="Home" asp-action="Index"><i class="fas fa-arrow-up-right-from-square" aria-hidden="true"></i>Public site</a>
                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                    <button type="submit"><i class="fas fa-arrow-right-from-bracket" aria-hidden="true"></i>Sign out</button>
                </form>
            </nav>
        </aside>

        <main class="dash-main" id="main">
            <div class="dash-topbar">
                <div class="d-flex align-items-center gap-3">
                    <button class="icon-btn d-lg-none" type="button" data-dash-toggle aria-controls="dashSidebar" aria-expanded="false" aria-label="Open menu">
                        <i class="fas fa-bars" aria-hidden="true"></i>
                    </button>
                    <div>
                        <h4>@ViewData["Title"]</h4>
                        <small>Manage your donor activity and emergency requests</small>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    @await Html.PartialAsync("_ThemeToggle")
                    @await Html.PartialAsync("_NotificationBell")
                    <div class="d-flex align-items-center gap-2 ps-2">
                        <div class="avatar-circle">@initial</div>
                        <div class="d-none d-sm-block">
                            <div class="fw-semibold" style="line-height:1.15;font-size:.875rem">@donorName</div>
                            <small class="text-muted" style="font-size:.72rem">Voluntary donor</small>
                        </div>
                    </div>
                </div>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="status">
                    <i class="fas fa-circle-check" aria-hidden="true"></i>@TempData["Success"]
                    <button type="button" class="close" data-dismiss="alert" aria-label="Dismiss">&times;</button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="fas fa-triangle-exclamation" aria-hidden="true"></i>@TempData["Error"]
                    <button type="button" class="close" data-dismiss="alert" aria-label="Dismiss">&times;</button>
                </div>
            }

            @await Html.PartialAsync("_ValidationSummary")

            @RenderBody()
        </main>
    </div>

    <script src="~/js/jquery-2.2.3.min.js" asp-append-version="true"></script>
    <script src="~/js/bootstrap.js" asp-append-version="true"></script>
    <script>
        // Sidebar: active link + mobile drawer
        document.addEventListener("DOMContentLoaded", function () {
            var path = window.location.pathname.toLowerCase();
            document.querySelectorAll(".dash-nav a").forEach(function (link) {
                var href = (link.getAttribute("href") || "").toLowerCase();
                if (href && href !== "/" && path.indexOf(href) === 0) { link.classList.add("active"); }
            });

            var sidebar = document.getElementById("dashSidebar");
            var toggle = document.querySelector("[data-dash-toggle]");
            if (sidebar && toggle) {
                toggle.addEventListener("click", function () {
                    var open = sidebar.classList.toggle("open");
                    toggle.setAttribute("aria-expanded", open ? "true" : "false");
                });
                document.addEventListener("click", function (event) {
                    if (window.innerWidth >= 992) return;
                    if (sidebar.classList.contains("open") && !sidebar.contains(event.target) && !toggle.contains(event.target)) {
                        sidebar.classList.remove("open");
                        toggle.setAttribute("aria-expanded", "false");
                    }
                });
            }
        });
    </script>
    <script src="~/js/bbdms-theme.js" asp-append-version="true"></script>
    <script src="~/js/bbdms-motion.js" asp-append-version="true"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script src="~/js/bbdms-notifications.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
