@model BBDMS.Model.Models.Entities.ContactInfo

<footer class="footer-modern">
    <div class="container">
        <div class="row">
            <!-- Brand Column -->
            <div class="col-lg-4 mb-4 mb-lg-0">
                <div class="d-flex align-items-center mb-3">
                    <img src="~/images/Logo.png" alt="Blood Bank Logo" style="height: 42px; width: auto;" class="mr-2" />
                    <span class="text-white font-weight-bold h4 mb-0">Blood <span style="color: var(--brand-red);">Bank</span></span>
                </div>
                <p class="text-muted small pr-lg-4">
                    Connecting voluntary blood donors, emergency patients, hospitals with ICU beds, ambulance fleets, and medical oxygen suppliers across the nation.
                </p>
                <div class="mt-3">
                    <span class="badge badge-danger p-2 font-weight-bold">
                        <i class="fas fa-headset mr-1"></i> 24/7 Emergency Helpline Active
                    </span>
                </div>
            </div>

            <!-- Emergency Services -->
            <div class="col-6 col-lg-3 mb-4 mb-lg-0">
                <h5>Emergency Services</h5>
                <ul class="list-unstyled small">
                    <li class="mb-2"><a asp-controller="Emergency" asp-action="Hospitals"><i class="fas fa-hospital mr-2 text-danger"></i>Hospitals & ICU Beds</a></li>
                    <li class="mb-2"><a asp-controller="Emergency" asp-action="BloodBanks"><i class="fas fa-landmark mr-2 text-danger"></i>Blood Banks Directory</a></li>
                    <li class="mb-2"><a asp-controller="Emergency" asp-action="Ambulances"><i class="fas fa-ambulance mr-2 text-danger"></i>Ambulance Fleets</a></li>
                    <li class="mb-2"><a asp-controller="Emergency" asp-action="Oxygen"><i class="fas fa-lungs mr-2 text-danger"></i>Oxygen Cylinder Refill</a></li>
                    <li class="mb-2"><a asp-controller="Emergency" asp-action="BloodRequests"><i class="fas fa-heartbeat mr-2 text-danger"></i>Urgent Blood Requests</a></li>
                </ul>
            </div>

            <!-- Quick Links -->
            <div class="col-6 col-lg-2 mb-4 mb-lg-0">
                <h5>Quick Links</h5>
                <ul class="list-unstyled small">
                    <li class="mb-2"><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="mb-2"><a asp-controller="Donor" asp-action="Search">Find Donors</a></li>
                    <li class="mb-2"><a asp-controller="Home" asp-action="About">About Us</a></li>
                    <li class="mb-2"><a asp-controller="Home" asp-action="Contact">Contact Support</a></li>
                    <li class="mb-2"><a asp-controller="Account" asp-action="Login">Donor Login</a></li>
                    <li class="mb-2"><a asp-controller="Account" asp-action="Register">Join as Donor</a></li>
                </ul>
            </div>

            <!-- Contact & Helpline -->
            <div class="col-lg-3">
                <h5>Contact & Helpline</h5>
                <ul class="list-unstyled small text-muted">
                    @if (Model != null)
                    {
                        <li class="mb-2 d-flex">
                            <i class="fas fa-map-marker-alt text-danger mr-2 mt-1"></i>
                            <span>@Model.Address</span>
                        </li>
                        <li class="mb-2 d-flex">
                            <i class="fas fa-phone-alt text-danger mr-2 mt-1"></i>
                            <a href="tel:@Model.ContactNo" class="text-white font-weight-bold">@Model.ContactNo</a>
                        </li>
                        <li class="mb-2 d-flex">
                            <i class="fas fa-envelope text-danger mr-2 mt-1"></i>
                            <a href="mailto:@Model.EmailId">@Model.EmailId</a>
                        </li>
                    }
                </ul>
            </div>
        </div>

        <div class="footer-bottom d-flex flex-column flex-md-row justify-content-between align-items-center">
            <p class="mb-0 text-muted small">&copy; @DateTime.Now.Year Blood Bank & Emergency Help System. All rights reserved.</p>
            <div class="mt-2 mt-md-0 small">
                <a asp-controller="Admin" asp-action="Index" class="text-muted"><i class="fas fa-lock mr-1"></i>Admin Portal</a>
            </div>
        </div>
    </div>
</footer>
