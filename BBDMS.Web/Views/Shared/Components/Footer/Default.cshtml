@model BBDMS.Model.Models.Entities.ContactInfo

<footer>
    <div class="w3ls-footer-grids pt-sm-4 pt-3">
        <div class="container py-xl-5 py-lg-3">
            <div class="row">
                <div class="col-md-4 w3l-footer">
                    <h2 class="mb-sm-3 mb-2">
                        <a asp-controller="Home" asp-action="Index" class="text-white font-italic font-weight-bold">
                            <span>Blood Bank </span> Management System
                        </a>
                    </h2>
                </div>
                <div class="col-md-4 w3l-footer my-md-0 my-4">
                    <h3 class="mb-sm-3 mb-2 text-white">Address</h3>
                    <ul class="list-unstyled">
                        @if (Model != null)
                        {
                            <li>
                                <i class="fas fa-location-arrow float-left"></i>
                                <p class="ml-4"><span>@Model.Address</span></p>
                                <div class="clearfix"></div>
                            </li>
                            <li class="my-3">
                                <i class="fas fa-phone float-left"></i>
                                <p class="ml-4">@Model.ContactNo</p>
                                <div class="clearfix"></div>
                            </li>
                            <li>
                                <i class="far fa-envelope-open float-left"></i>
                                <a href="mailto:@Model.EmailId" class="ml-3">@Model.EmailId</a>
                                <div class="clearfix"></div>
                            </li>
                        }
                    </ul>
                </div>
                <div class="col-md-4 w3l-footer">
                    <h3 class="mb-sm-3 mb-2 text-white">Quick Links</h3>
                    <div class="nav-w3-l">
                        <ul class="list-unstyled">
                            <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                            <li class="mt-2"><a asp-controller="Home" asp-action="About">About Us</a></li>
                            <li class="mt-2"><a asp-controller="Home" asp-action="Contact">Contact Us</a></li>
                        </ul>
                    </div>
                </div>
            </div>
            <div class="border-top mt-5 pt-lg-4 pt-3 pb-lg-0 pb-3 text-center">
                <p class="copy-right-grids mt-lg-1">Blood Bank Management System</p>
            </div>
        </div>
    </div>
</footer>
