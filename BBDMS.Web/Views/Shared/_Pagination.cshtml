@{
    var pageIndex = (int)ViewData["PageIndex"]!;
    var totalPages = (int)ViewData["TotalPages"]!;
    var actionName = (string)ViewData["ActionName"]!;
}

@if (totalPages > 1)
{
    <nav aria-label="Page navigation" class="mt-4">
        <ul class="pagination justify-content-center gap-1">
            <li class="page-item @(pageIndex <= 1 ? "disabled" : "")">
                <a class="page-link rounded-pill px-3" asp-action="@actionName" asp-route-page="@(pageIndex - 1)" style="@(pageIndex <= 1 ? "" : "color:#e63946; border-color:#e2e8f0;")">
                    <i class="fas fa-chevron-left me-1"></i>Previous
                </a>
            </li>

            @for (int p = 1; p <= totalPages; p++)
            {
                <li class="page-item @(p == pageIndex ? "active fw-bold" : "")">
                    <a class="page-link rounded-pill" asp-action="@actionName" asp-route-page="@p"
                       style="@(p == pageIndex ? "background:#e63946; border-color:#e63946; color:#fff;" : "color:#475569; border-color:#e2e8f0;")">
                        @p
                    </a>
                </li>
            }

            <li class="page-item @(pageIndex >= totalPages ? "disabled" : "")">
                <a class="page-link rounded-pill px-3" asp-action="@actionName" asp-route-page="@(pageIndex + 1)" style="@(pageIndex >= totalPages ? "" : "color:#e63946; border-color:#e2e8f0;")">
                    Next<i class="fas fa-chevron-right ms-1"></i>
                </a>
            </li>
        </ul>
    </nav>
}
