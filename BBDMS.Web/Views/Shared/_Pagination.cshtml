@{
    var pageIndex = (int)ViewData["PageIndex"]!;
    var totalPages = (int)ViewData["TotalPages"]!;
    var actionName = (string)ViewData["ActionName"]!;
}

@if (totalPages > 1)
{
    <nav aria-label="Page navigation" class="mt-4">
        <ul class="pagination justify-content-center">
            <li class="page-item @(pageIndex <= 1 ? "disabled" : "")">
                <a class="page-link" asp-action="@actionName" asp-route-page="@(pageIndex - 1)">
                    <i class="fas fa-chevron-left mr-1"></i>Previous
                </a>
            </li>

            @for (int p = 1; p <= totalPages; p++)
            {
                <li class="page-item @(p == pageIndex ? "active font-weight-bold" : "")">
                    <a class="page-link" asp-action="@actionName" asp-route-page="@p">@p</a>
                </li>
            }

            <li class="page-item @(pageIndex >= totalPages ? "disabled" : "")">
                <a class="page-link" asp-action="@actionName" asp-route-page="@(pageIndex + 1)">
                    Next<i class="fas fa-chevron-right ml-1"></i>
                </a>
            </li>
        </ul>
    </nav>
}
