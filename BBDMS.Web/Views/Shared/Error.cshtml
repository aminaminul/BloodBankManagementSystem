@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<section class="page-hero-sm" style="background:linear-gradient(135deg,#e63946 0%,#9b1a26 100%); color:#fff; padding:56px 0 40px;">
    <div class="container text-center">
        <h1 class="fw-bold mb-1" style="font-size:2.2rem;">Oops! Something Went Wrong</h1>
        <p class="mb-0 text-white-50">An unexpected error occurred while processing your request.</p>
    </div>
</section>

<section class="py-5" style="background:#f8fafc;">
    <div class="container py-2">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6 text-center">
                <div class="card-modern p-4 p-md-5">
                    <div style="width:72px; height:72px; background:#fff5f5; border-radius:50%; display:flex; align-items:center; justify-content:center; margin:0 auto 1.5rem;">
                        <i class="fas fa-exclamation-triangle" style="font-size:2rem; color:#e63946;"></i>
                    </div>

                    <h4 class="fw-bold text-dark mb-2">We encountered a temporary issue</h4>
                    <p class="text-muted small mb-4">
                        Please try refreshing the page or navigating back to the homepage. If the issue persists, feel free to contact our emergency support team.
                    </p>

                    @if (Model.ShowRequestId)
                    {
                        <div class="p-2 rounded mb-4 text-start small font-monospace" style="background:#f1f5f9; border:1px solid #e2e8f0;">
                            <span class="text-muted">Request ID:</span> <code>@Model.RequestId</code>
                        </div>
                    }

                    <div class="d-flex justify-content-center gap-2">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-brand-red px-4">
                            <i class="fas fa-home me-2"></i>Return Home
                        </a>
                        <a asp-controller="Home" asp-action="Contact" class="btn btn-brand-outline px-4">
                            Contact Support
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
