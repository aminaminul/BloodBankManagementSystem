<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Blood Bank Management System</title>

    <!-- Inter: Universal modern font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/css/bootstrap.css">
    <link rel="stylesheet" href="~/css/style.css" type="text/css" media="all" />
    <link rel="stylesheet" href="~/css/fontawesome-all.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="~/css/modern-theme.css" type="text/css" media="all" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @await Component.InvokeAsync("Header")

    <main role="main">
        @RenderBody()
    </main>

    @await Component.InvokeAsync("Footer")

    <div id="publicAlertContainer" style="position: fixed; bottom: 20px; right: 20px; z-index: 99999; max-width: 360px;"></div>

    <script src="~/js/jquery-2.2.3.min.js"></script>
    <script src="~/js/bootstrap.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script>
        // Real-Time Community Blood Request Alerts
        (function() {
            const hubConnection = new signalR.HubConnectionBuilder()
                .withUrl("/emergencyHub")
                .withAutomaticReconnect()
                .build();

            hubConnection.on("ReceiveBloodRequestAlert", function (data) {
                const container = document.getElementById("publicAlertContainer");
                if (!container) return;
                const toast = document.createElement("div");
                toast.className = "alert alert-danger shadow-lg alert-dismissible fade show border border-danger";
                toast.style.borderRadius = "8px";
                toast.innerHTML = `
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <strong class="font-weight-bold"><i class="fas fa-heartbeat mr-1"></i> URGENT BLOOD NEEDED!</strong>
                        <button type="button" class="close p-1" data-dismiss="alert">&times;</button>
                    </div>
                    <div class="small">
                        <strong>${data.bloodGroup}</strong> needed for ${data.patientName}<br/>
                        <i class="fas fa-hospital mr-1"></i> ${data.hospital}<br/>
                        <a href="/Emergency/BloodRequests" class="btn btn-sm btn-outline-danger mt-2 font-weight-bold">View Details</a>
                    </div>
                `;
                container.appendChild(toast);
                setTimeout(() => { $(toast).alert('close'); }, 15000);
            });

            hubConnection.start().catch(err => console.debug("Community alert SignalR:", err));
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
