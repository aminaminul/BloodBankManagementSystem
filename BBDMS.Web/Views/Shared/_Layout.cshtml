<!DOCTYPE html>
<html lang="en" data-theme="@ThemePreference.Read(Context)">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Blood Bank Management System</title>

    @* Applies the stored light/dark choice (and motion opt-in) before the first paint. *@
    <script>
        (function () {
            try {
                var m = document.cookie.match(/(?:^|;\s*)bbdms\.theme=([^;]+)/);
                var t = m ? decodeURIComponent(m[1]) : localStorage.getItem('bbdms-theme');
                if (!t && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) t = 'dark';
                t = t === 'dark' ? 'dark' : 'light';
                document.documentElement.setAttribute('data-theme', t);
                document.documentElement.style.colorScheme = t;
                if (!(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches)) {
                    document.documentElement.classList.add('bbdms-motion');
                }
            } catch (e) { /* keep the server rendered theme */ }
        })();
    </script>

    <!-- Inter: Universal modern font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/css/bootstrap.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/style.css" type="text/css" media="all" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="~/css/modern-theme.css" type="text/css" media="all" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @await Component.InvokeAsync("Header")

    <main role="main">
        @await Html.PartialAsync("_ValidationSummary")
        @RenderBody()
    </main>

    @await Component.InvokeAsync("Footer")

    <div id="publicAlertContainer" style="position: fixed; bottom: 20px; right: 20px; z-index: 99999; max-width: 360px;"></div>

    <script src="~/js/jquery-2.2.3.min.js" asp-append-version="true"></script>
    <script src="~/js/bootstrap.js" asp-append-version="true"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script>
        // Real-Time Community Blood Request Alerts
        (function() {
            const hubConnection = new signalR.HubConnectionBuilder()
                .withUrl("/emergencyHub")
                .withAutomaticReconnect()
                .build();

            // Escape untrusted request data before it is inserted as HTML
            function escapeHtml(value) {
                return String(value == null ? "" : value)
                    .replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")
                    .replace(/"/g, "&quot;").replace(/'/g, "&#039;");
            }

            hubConnection.on("ReceiveBloodRequestAlert", function (data) {
                if (typeof playEmergencyChime === 'function') { playEmergencyChime(); }
                const container = document.getElementById("publicAlertContainer");
                if (!container) return;
                const toast = document.createElement("div");
                toast.className = "alert alert-danger shadow-lg alert-dismissible fade show border border-danger";
                toast.style.borderRadius = "8px";
                // Community alerts are intentionally anonymous: no patient name or phone number
                toast.innerHTML = `
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <strong class="font-weight-bold"><i class="fas fa-heartbeat mr-1"></i> URGENT BLOOD NEEDED!</strong>
                        <button type="button" class="close p-1" data-dismiss="alert">&times;</button>
                    </div>
                    <div class="small">
                        <strong>${escapeHtml(data.bloodGroup)}</strong> needed${data.units ? " &bull; " + escapeHtml(data.units) + " unit(s)" : ""}<br/>
                        <i class="fas fa-hospital mr-1"></i> ${escapeHtml(data.hospital)}<br/>
                        <span class="text-white-50">${escapeHtml(data.urgency || "Urgent")}</span><br/>
                        <a href="/Emergency/BloodRequests" class="btn btn-sm btn-outline-danger mt-2 font-weight-bold">View Details</a>
                    </div>
                `;
                container.appendChild(toast);
                setTimeout(() => { $(toast).alert('close'); }, 15000);
            });

            hubConnection.start().catch(err => console.debug("Community alert SignalR:", err));
        })();
    </script>

    <script>
        // Bootstrap 5 style dismiss attributes with the Bootstrap 4 runtime
        document.addEventListener('click', function (e) {
            var el = e.target.closest('[data-bs-dismiss]');
            if (el) {
                var target = el.closest('.alert') || el.closest('.modal') || el.parentElement;
                if (target) { target.remove(); }
            }
        });
    </script>

    <script src="~/js/bbdms-theme.js" asp-append-version="true"></script>
    <script src="~/js/bbdms-motion.js" asp-append-version="true"></script>
    <script src="~/js/bbdms-notifications.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
