@model BBDMS.Model.Models.ViewModels.DonorDashboardViewModel
@{
    Layout = "_DonorLayout";
    ViewData["Title"] = "My Dashboard";
    var donor = Model.Donor;
    var firstName = (donor?.FullName ?? "Donor").Split(' ').FirstOrDefault();
    var initial = string.IsNullOrEmpty(donor?.FullName) ? "D" : donor.FullName.Substring(0, 1).ToUpper();
    var hour = DateTime.Now.Hour;
    var greeting = hour < 12 ? "Good Morning" : hour < 18 ? "Good Afternoon" : "Good Evening";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h3 class="fw-bold mb-1">@greeting, @firstName!</h3>
        <p class="text-muted mb-0">Thank you for being a donor. This is an overview of your donor activity.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-controller="Donor" asp-action="Certificate" class="btn btn-outline-primary btn-sm shadow-sm">
            <i class="fas fa-award me-1"></i> My Certificate
        </a>
        <a asp-controller="Donor" asp-action="NextDonationCalendar" class="btn btn-outline-success btn-sm shadow-sm">
            <i class="fas fa-calendar-plus me-1"></i> Add Next Date (.ics)
        </a>
        <a asp-controller="Donor" asp-action="DonorCard" class="btn btn-outline-danger btn-sm shadow-sm">
            <i class="fas fa-id-card me-1"></i> Donor Card
        </a>
    </div>
</div>

<!-- Stat cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="stat-card">
            <div class="stat-ico red"><i class="fas fa-tint"></i></div>
            <div>
                <div class="stat-val">@(donor?.BloodGroup ?? "—")</div>
                <div class="stat-cap">Blood Group</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card">
            <div class="stat-ico @(donor?.IsAvailable == true ? "green" : "amber")"><i class="fas fa-check-circle"></i></div>
            <div>
                <div class="stat-val" style="font-size:1.2rem;">@(donor?.IsAvailable == true ? "Available" : "Unavailable")</div>
                <div class="stat-cap">Donor Availability</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card">
            <div class="stat-ico blue"><i class="fas fa-layer-group"></i></div>
            <div>
                <div class="stat-val">@Model.TotalDonations</div>
                <div class="stat-cap">Total Donations</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card">
            <div class="stat-ico violet"><i class="fas fa-envelope-open-text"></i></div>
            <div>
                <div class="stat-val">@Model.PendingRequests</div>
                <div class="stat-cap">Pending Requests</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Recent requests -->
    <div class="col-lg-8">
        <div class="card-modern">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0">Recent Blood Requests</h5>
                <a asp-controller="Donor" asp-action="MyRequests" class="btn btn-sm btn-brand-outline">View All</a>
            </div>

            @{
                var list = Model.CommunityRequests.Any() ? Model.CommunityRequests : Model.DirectRequests;
            }
            @if (list != null && list.Any())
            {
                foreach (var req in list)
                {
                    <div class="donor-row mb-2">
                        <div class="stat-ico red" style="width:44px;height:44px;border-radius:12px;font-size:1rem;"><i class="fas fa-tint"></i></div>
                        <div class="flex-grow-1">
                            <div class="d-flex justify-content-between align-items-center">
                                <div class="fw-bold text-dark">@(req.BloodGroup ?? req.BloodRequireFor) Blood — @req.Name</div>
                                <span class="@(req.Urgency == "Critical" ? "badge-soft-danger" : "badge-soft-warning")">@req.Urgency</span>
                            </div>
                            <div class="small text-muted">
                                <i class="fas fa-hospital me-1"></i>@(req.HospitalName ?? "Emergency Facility")
                                <span class="mx-1">•</span>@req.UnitsRequired Unit@(req.UnitsRequired > 1 ? "s" : "")
                                <span class="mx-1">•</span>@req.Location
                            </div>
                        </div>
                        <a asp-controller="Emergency" asp-action="RequestDetails" asp-route-id="@req.ID" class="btn btn-sm btn-brand-red flex-shrink-0">View</a>
                    </div>
                }
            }
            else
            {
                <div class="text-center py-4 text-muted">
                    <i class="fas fa-check-circle fa-2x mb-2 d-block text-success"></i>
                    No open requests right now.
                </div>
            }
        </div>
    </div>

    <!-- Quick actions + eligibility -->
    <div class="col-lg-4">
        <div class="card-modern mb-3">
            <h5 class="fw-bold mb-3">Quick Actions</h5>
            <div class="d-grid" style="display:grid; gap:.55rem;">
                <a asp-controller="Emergency" asp-action="CreateBloodRequest" class="btn btn-brand-red w-100">
                    <i class="fas fa-plus-circle"></i> Create Blood Request
                </a>
                <a asp-controller="Donor" asp-action="Search" class="btn btn-brand-outline w-100">
                    <i class="fas fa-search"></i> Find a Donor
                </a>
                <a asp-controller="Donor" asp-action="LogDonation" class="btn btn-brand-outline w-100">
                    <i class="fas fa-hand-holding-heart"></i> Log a Donation
                </a>
                <a asp-controller="Donor" asp-action="DonationHistory" class="btn btn-brand-outline w-100">
                    <i class="fas fa-history"></i> Donation History
                </a>
            </div>
        </div>

        <div class="card-modern">
            <h6 class="fw-bold mb-3"><i class="fas fa-heartbeat text-danger me-2"></i>Donation Eligibility</h6>
            @if (donor?.IsEligibleToDonate == true)
            {
                <span class="badge-soft-success"><i class="fas fa-check-circle"></i>Eligible to donate</span>
                <p class="small text-muted mt-2 mb-0">You are medically eligible to donate blood.</p>
            }
            else
            {
                <span class="badge-soft-warning"><i class="fas fa-clock"></i>@(donor?.DaysUntilEligible ?? 0) day(s) remaining</span>
                <p class="small text-muted mt-2 mb-0">A minimum 90-day gap is required between donations.</p>
            }
            <div class="mt-3 pt-3 border-top small text-muted">
                <div class="d-flex justify-content-between mb-1">
                    <span>Last donation</span>
                    <span class="fw-semibold text-dark">@((Model.LastDonationDate ?? donor?.LastDonatedDate)?.ToString("MMM dd, yyyy") ?? "No record")</span>
                </div>
                <div class="d-flex justify-content-between mb-1">
                    <span>Units donated</span>
                    <span class="fw-semibold text-dark">@Model.TotalUnitsDonated</span>
                </div>
                <div class="d-flex justify-content-between mb-1">
                    <span>Nearby group donors</span>
                    <span class="fw-semibold text-dark">@Model.NearbyDonors</span>
                </div>
                <div class="d-flex justify-content-between">
                    <span>Location</span>
                    <span class="fw-semibold text-dark">@(donor?.Address ?? "—")</span>
                </div>
            </div>
        </div>
    </div>
</div>
