@model BBDMS.Model.Models.ViewModels.PagedResult<BBDMS.Model.Models.ViewModels.DonorListItemViewModel>
@{
    ViewData["Title"] = "Nearby Donors";
    var bloodGroups = ViewBag.BloodGroups as IEnumerable<BBDMS.Model.Models.Entities.BloodGroup>;
    ViewData["PagerAction"] = "Nearby";
    ViewData["PagerBloodGroup"] = ViewBag.BloodGroup;
    ViewData["PagerLocation"] = ViewBag.Location;
    var donors = Model.Items;
}

@section Styles {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
}

<section class="page-head">
    <div class="container">
        <nav aria-label="Breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item"><a asp-action="Search">Find donors</a></li>
                <li class="breadcrumb-item active" aria-current="page">Nearby</li>
            </ol>
        </nav>
        <div class="page-head-row">
            <div>
                <p class="eyebrow">Donor map</p>
                <h1>Donors near you.</h1>
                <p>Filter by blood group and city, then see where local donors are concentrated before you reach out.</p>
            </div>
            <div class="page-head-actions">
                <a class="btn btn-ghost" asp-action="Search">
                    <i class="fas fa-list" aria-hidden="true"></i> Full directory
                </a>
                <a class="btn btn-blood" asp-controller="Emergency" asp-action="CreateBloodRequest">
                    <i class="fas fa-plus" aria-hidden="true"></i> Post a request
                </a>
            </div>
        </div>
    </div>
</section>

<section class="section-tight">
    <div class="container">

        <form method="get" asp-action="Nearby" class="filter-bar" role="search" data-reveal>
            <div class="filter-bar-grid">
                <div>
                    <label for="nearbyGroup">Blood group</label>
                    <select id="nearbyGroup" name="bloodGroup" class="form-select">
                        <option value="">All blood groups</option>
                        @if (bloodGroups != null)
                        {
                            foreach (var bg in bloodGroups)
                            {
                                <option value="@bg.GroupName" selected="@(ViewBag.BloodGroup == bg.GroupName)">@bg.GroupName</option>
                            }
                        }
                    </select>
                </div>
                <div>
                    <label for="nearbyLocation">City or area</label>
                    <input id="nearbyLocation" type="text" name="location" value="@ViewBag.Location" class="form-control" placeholder="e.g. Dhaka, Mirpur" autocomplete="address-level2" />
                </div>
                <div class="filter-actions">
                    <button type="submit" class="btn btn-ink"><i class="fas fa-location-crosshairs" aria-hidden="true"></i> Search nearby</button>
                    <a class="btn btn-ghost" asp-action="Nearby">Reset</a>
                </div>
            </div>
        </form>

        <div class="row g-4 mt-2">
            <div class="col-lg-6">
                <p class="result-count mb-3">
                    <span class="num">@Model.TotalItems</span> donor@(Model.TotalItems == 1 ? "" : "s") matching
                    @if (!string.IsNullOrEmpty(ViewBag.Location as string))
                    {
                        <span> near @ViewBag.Location</span>
                    }
                </p>

                @if (donors != null && donors.Any())
                {
                    <div class="nearby-list">
                        @foreach (var donor in donors)
                        {
                            <article class="nearby-card" data-motion>
                                <span class="bg-glyph">@donor.BloodGroup</span>
                                <div class="nearby-body">
                                    <h3>@donor.FullName</h3>
                                    <p class="meta">
                                        <i class="fas fa-location-dot" aria-hidden="true"></i>@donor.Address
                                        <span aria-hidden="true">·</span>@(donor.Age.HasValue ? donor.Age + " yrs" : "Age on request")
                                    </p>
                                    <span class="tag @(donor.IsAvailable ? "tag-ok" : "tag-muted")">
                                        @(donor.IsAvailable ? "Available" : "Registered")
                                    </span>
                                </div>
                                <a asp-action="Contact" asp-route-id="@donor.Id" class="btn btn-ghost btn-sm">Contact</a>
                            </article>
                        }
                    </div>

                    <div class="mt-4">
                        @await Html.PartialAsync("_DonorPager", Model)
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <i class="fas fa-users" aria-hidden="true"></i>
                        <h4>No donors found here</h4>
                        <p>Try a different blood group or a wider city, or browse the full directory.</p>
                        <a asp-action="Nearby" class="btn btn-ink">Clear filters</a>
                    </div>
                }
            </div>

            <div class="col-lg-6">
                <div class="map-frame" style="position:sticky; top:calc(var(--header-h) + 20px);">
                    <div class="map-frame-head">
                        <h2>Donor distribution</h2>
                        <span class="pill pill-live"><span class="pulse-dot" aria-hidden="true"></span> Live map</span>
                    </div>
                    <div id="donorsMap"></div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var el = document.getElementById("donorsMap");
            if (!el) return;
            var map = L.map("donorsMap").setView([23.8103, 90.4125], 7);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; OpenStreetMap contributors', maxZoom: 18
            }).addTo(map);

            var cityCoords = {
                'dhaka': [23.8103, 90.4125], 'mirpur': [23.8223, 90.3654], 'uttara': [23.8759, 90.3795],
                'dhanmondi': [23.7461, 90.3742], 'chittagong': [22.3569, 91.7832], 'sylhet': [24.8949, 91.8687],
                'khulna': [22.8456, 89.5403], 'rajshahi': [24.3745, 88.6042], 'rangpur': [25.7439, 89.2752],
                'mymensingh': [24.7471, 90.4203]
            };

            var donors = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                donors.Select(d => new { name = d.FullName, group = d.BloodGroup, address = d.Address })
            ));

            var markers = [];
            donors.forEach(function (d, i) {
                var key = (d.address || "").toLowerCase();
                var coord = [23.8103, 90.4125];
                Object.keys(cityCoords).forEach(function (c) { if (key.indexOf(c) !== -1) coord = cityCoords[c]; });
                var lat = coord[0] + ((i % 5) - 2) * 0.02;
                var lng = coord[1] + (Math.floor(i / 5) - 2) * 0.02;
                var m = L.marker([lat, lng]).bindPopup('<div class="map-popup"><h6>' + d.name + '</h6><p class="meta">' + (d.address || '') + '</p><div class="map-popup-stats"><span>' + d.group + '</span></div></div>');
                m.addTo(map);
                markers.push(m);
            });
            if (markers.length) map.fitBounds(new L.featureGroup(markers).getBounds().pad(0.2));
        });
    </script>
}
