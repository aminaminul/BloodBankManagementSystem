@model IEnumerable<BBDMS.Model.Models.Entities.BloodDonor>
@{
    ViewData["Title"] = "Search Blood Donor";
    var bloodGroups = ViewBag.BloodGroups as IEnumerable<BBDMS.Model.Models.Entities.BloodGroup>;
}

<section class="page-hero-sm" style="background:linear-gradient(135deg,#e63946 0%,#9b1a26 100%); color:#fff; padding:56px 0 40px;">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-2" style="background:transparent; padding:0;">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-white-50">Home</a></li>
                <li class="breadcrumb-item active text-white" aria-current="page">Find a Donor</li>
            </ol>
        </nav>
        <h1 class="fw-bold mb-1" style="font-size:2rem;">Find a Blood Donor</h1>
        <p class="mb-0 text-white-50">Search by blood group and location to connect with eligible donors near you.</p>
    </div>
</section>

<section class="py-5" style="background:#f8fafc;">
    <div class="container py-2">

        @* Search Filter Card *@
        <div class="card-modern mb-5" style="max-width:700px; margin-left:auto; margin-right:auto;">
            <h5 class="fw-bold mb-4"><i class="fas fa-search me-2 text-danger"></i>Search Criteria</h5>
            <form asp-action="Search" method="get">
                <div class="row g-3 align-items-end">
                    <div class="col-md-5">
                        <label class="form-label fw-semibold">Blood Group <span class="text-danger">*</span></label>
                        <select name="bloodGroup" class="form-select form-control-modern" required>
                            <option value="">Select Blood Group</option>
                            @if (bloodGroups != null)
                            {
                                foreach (var bg in bloodGroups)
                                {
                                    <option value="@bg.GroupName">@bg.GroupName</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-5">
                        <label class="form-label fw-semibold">Location <span class="text-muted small">(optional)</span></label>
                        <input type="text" name="location" class="form-control form-control-modern" placeholder="e.g. Dhaka, Chittagong...">
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-brand-red w-100">
                            <i class="fas fa-search"></i>
                        </button>
                    </div>
                </div>
            </form>
        </div>

        @* Results *@
        @if (Model != null)
        {
            @if (Model.Any())
            {
                <div class="row g-4">
                    @foreach (var donor in Model)
                    {
                        <div class="col-md-6 col-lg-4">
                            <div class="card-modern h-100 d-flex flex-column">
                                <div class="d-flex align-items-center mb-3">
                                    <div style="width:52px; height:52px; background:#fff5f5; border-radius:50%; display:flex; align-items:center; justify-content:center; flex-shrink:0; margin-right:1rem;">
                                        <i class="fas fa-user-circle" style="font-size:1.8rem; color:#e63946;"></i>
                                    </div>
                                    <div>
                                        <div class="fw-bold" style="color:#1e293b;">@donor.FullName</div>
                                        <span class="badge-soft-danger fw-bold">@donor.BloodGroup</span>
                                    </div>
                                </div>

                                <table class="table table-sm mb-3" style="font-size:.875rem;">
                                    <tbody>
                                        <tr>
                                            <td class="text-muted fw-semibold border-0 py-1">Gender</td>
                                            <td class="border-0 py-1">@donor.Gender</td>
                                        </tr>
                                        <tr>
                                            <td class="text-muted fw-semibold border-0 py-1">Age</td>
                                            <td class="border-0 py-1">@(donor.Age.HasValue ? $"{donor.Age} yrs" : "—")</td>
                                        </tr>
                                        <tr>
                                            <td class="text-muted fw-semibold border-0 py-1">Phone</td>
                                            <td class="border-0 py-1">@donor.MobileNumber</td>
                                        </tr>
                                        <tr>
                                            <td class="text-muted fw-semibold border-0 py-1">Email</td>
                                            <td class="border-0 py-1 small">@donor.EmailId</td>
                                        </tr>
                                        <tr>
                                            <td class="text-muted fw-semibold border-0 py-1">Address</td>
                                            <td class="border-0 py-1 small">@donor.Address</td>
                                        </tr>
                                        <tr>
                                            <td class="text-muted fw-semibold border-0 py-1">Eligibility</td>
                                            <td class="border-0 py-1">
                                                @if (donor.IsEligibleToDonate)
                                                {
                                                    <span class="badge-soft-success"><i class="fas fa-check-circle me-1"></i>Eligible</span>
                                                }
                                                else
                                                {
                                                    <span class="badge-soft-warning"><i class="fas fa-clock me-1"></i>@donor.DaysUntilEligible day(s)</span>
                                                }
                                            </td>
                                        </tr>
                                        @if (!string.IsNullOrEmpty(donor.Message))
                                        {
                                            <tr>
                                                <td class="text-muted fw-semibold border-0 py-1">Note</td>
                                                <td class="border-0 py-1 small fst-italic">@donor.Message</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>

                                <div class="mt-auto">
                                    <a class="btn btn-brand-red w-100" asp-action="Contact" asp-route-id="@donor.Id">
                                        <i class="fas fa-hand-holding-heart me-2"></i>Request This Donor
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-search fa-3x text-muted mb-3 d-block"></i>
                    <h5 class="text-muted">No donors found matching your search criteria.</h5>
                    <p class="text-muted small">Try a different blood group or location.</p>
                </div>
            }
        }
    </div>
</section>
