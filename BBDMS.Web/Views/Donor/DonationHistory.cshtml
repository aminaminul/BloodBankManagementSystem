@model IEnumerable<BBDMS.Model.Models.Entities.Donation>
@{
    Layout = "_DonorLayout";
    ViewData["Title"] = "Donation History";
    var donations = Model?.ToList() ?? new List<BBDMS.Model.Models.Entities.Donation>();
    var donor = ViewBag.Donor as BBDMS.Model.Models.Entities.BloodDonor;
    var totalDonations = (int)(ViewBag.TotalDonations ?? 0);
    var totalUnits = (int)(ViewBag.TotalUnits ?? 0);
    var lastDate = ViewBag.LastDonationDate as DateTime?;
    var nextEligible = ViewBag.NextEligibleDate as DateTime?;
    var eligibleNow = !nextEligible.HasValue || nextEligible.Value <= DateTime.Now;
    var daysLeft = nextEligible.HasValue ? Math.Max(0, (int)(nextEligible.Value - DateTime.Now).TotalDays) : 0;
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h4 class="fw-bold mb-1">Donation History</h4>
        <p class="text-muted mb-0">Track every donation you have recorded over time.</p>
    </div>
    <a asp-action="LogDonation" class="btn btn-brand-red"><i class="fas fa-plus"></i> Log Donation</a>
</div>

<!-- Summary -->
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="stat-card">
            <div class="stat-ico red"><i class="fas fa-tint"></i></div>
            <div><div class="stat-val">@totalDonations</div><div class="stat-cap">Total Donations</div></div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card">
            <div class="stat-ico blue"><i class="fas fa-layer-group"></i></div>
            <div><div class="stat-val">@totalUnits</div><div class="stat-cap">Units Donated</div></div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card">
            <div class="stat-ico violet"><i class="fas fa-calendar-check"></i></div>
            <div>
                <div class="stat-val" style="font-size:1.1rem;">@(lastDate?.ToString("dd MMM yyyy") ?? "—")</div>
                <div class="stat-cap">Last Donation</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card">
            <div class="stat-ico @(eligibleNow ? "green" : "amber")"><i class="fas fa-clock"></i></div>
            <div>
                <div class="stat-val" style="font-size:1.1rem;">@(eligibleNow ? "Eligible" : daysLeft + " days")</div>
                <div class="stat-cap">@(eligibleNow ? "Ready to donate" : "Until eligible")</div>
            </div>
        </div>
    </div>
</div>

<!-- Eligibility note -->
<div class="alert @(eligibleNow ? "alert-success" : "alert-warning") d-flex align-items-center mb-4 border-0" role="alert">
    <i class="fas @(eligibleNow ? "fa-check-circle" : "fa-clock") me-2"></i>
    <div>
        @if (eligibleNow)
        {
            <text>You are medically eligible to donate blood again.</text>
        }
        else
        {
            <text>Next eligible donation date: <strong>@nextEligible?.ToString("dd MMM yyyy")</strong> (a minimum 90-day gap is required between donations).</text>
        }
    </div>
</div>

<div class="card-modern p-0">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th class="ps-4">Date</th>
                    <th>Blood Group</th>
                    <th class="d-none d-md-table-cell">Center</th>
                    <th class="d-none d-sm-table-cell">Units</th>
                    <th class="d-none d-lg-table-cell">Notes</th>
                    <th class="text-end pe-4">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (donations.Any())
                {
                    foreach (var d in donations)
                    {
                        <tr>
                            <td class="ps-4 fw-semibold text-dark">@d.DonationDate.ToString("dd MMM yyyy")</td>
                            <td><span class="badge-soft-danger">@(d.BloodGroup ?? donor?.BloodGroup)</span></td>
                            <td class="d-none d-md-table-cell">
                                <div class="fw-semibold text-dark">@(d.CenterName ?? "—")</div>
                                @if (!string.IsNullOrEmpty(d.Location))
                                {
                                    <div class="small text-muted"><i class="fas fa-map-marker-alt text-danger me-1"></i>@d.Location</div>
                                }
                            </td>
                            <td class="d-none d-sm-table-cell">@d.UnitsDonated unit@(d.UnitsDonated > 1 ? "s" : "")</td>
                            <td class="d-none d-lg-table-cell small text-muted">@(string.IsNullOrEmpty(d.Notes) ? "—" : d.Notes)</td>
                            <td class="text-end pe-4">
                                <form asp-action="DeleteDonation" asp-route-id="@d.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Remove this donation record?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-light border text-danger" title="Remove">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="fas fa-hand-holding-heart fa-2x mb-2 d-block text-muted"></i>
                            No donations recorded yet.
                            <div class="mt-3">
                                <a asp-action="LogDonation" class="btn btn-brand-red btn-sm"><i class="fas fa-plus me-1"></i>Log your first donation</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
